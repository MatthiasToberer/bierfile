#!/usr/bin/env bash
#
# bier — keeps Brewfiles in sync across several Macs.
#
# Code and data live in two repositories:
#
#   ROOT  the program — public, this is what gets developed
#   DATA  the Brewfiles — private, they reveal what runs on the Macs
#
# Both are recorded in ~/.barrel/config. Git commands go to DATA
# unless the code itself is meant (bier upgrade, bier version).
#
# Every Mac is in one group. Brewfiles/main is what All Macs have,
# Brewfiles/@<group> what a group's Macs have on top, and
# Brewfiles/<host> what one Mac has installed that nobody has given to
# All Macs or a group yet. All are valid Brewfiles; together they are
# what a Mac is supposed to have.
#
# Lists only add, never subtract. Anything a Mac must not run therefore
# cannot be for All Macs -- it belongs to the groups that want it.

set -euo pipefail

# One source for the version number: build.sh reads it from here and
# writes it into the app bundle, bier state reports it, and that is how
# BierMenu notices that it is out of date itself.
BIER_VERSION=0.50.11

# Set by check_code, read by cmd_upgrade: the release tag to move to.
# Empty means "follow the branch" — see check_code for when that applies.
UPGRADE_TAG=""

# --- Environment ------------------------------------------------------------

die() {
	printf 'bier: %s\n' "$*" >&2
	exit 1
}

info() { printf '%s\n' "$*"; }

# "1 entry" rather than "1 entries".
count_word() {
	if [ "$1" = "1" ]; then printf '1 entry'; else printf '%s entries' "$1"; fi
}

# Everything bier keeps lives in one folder, so that leaving it is
# "rm -rf ~/.barrel". An installation from before the barrel keeps its
# old places until install.sh moves it in; until then bier finds it
# there.
BARREL=${BIER_BARREL:-$HOME/.barrel}
LEGACY_CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/bier/config
if [ -n "${BIER_CONFIG:-}" ]; then
	CONFIG_FILE=$BIER_CONFIG
elif [ ! -f "$BARREL/config" ] && [ -f "$LEGACY_CONFIG" ]; then
	CONFIG_FILE=$LEGACY_CONFIG
else
	CONFIG_FILE=$BARREL/config
fi
if [ "$CONFIG_FILE" = "$LEGACY_CONFIG" ]; then
	AGENT_HOME=$HOME/.barrel/agent
	STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/bier
	VAULT_DEFAULT=$HOME/.bierfilevault
else
	AGENT_HOME=$BARREL/agent
	STATE_DIR=$BARREL/state
	VAULT_DEFAULT=$BARREL/vault
fi
PEER_IDENTITY=${BIER_PEER_IDENTITY:-$AGENT_HOME/identity}

# Where the program lives when the config says nothing: the repository root.
# this script. Resolve symlinks by hand, readlink -f is not everywhere on
# macOS.
script_root() {
	local self=$0 link
	while [ -L "$self" ]; do
		link=$(readlink "$self")
		case $link in
		/*) self=$link ;;
		*) self=$(dirname "$self")/$link ;;
		esac
	done
	(cd "$(dirname "$self")/../.." && pwd)
}

# Read one value from the config: lines of the form  key = value
# Comments and blank lines are ignored, the last match wins.
config_get() {
	[ -f "$CONFIG_FILE" ] || return 0
	sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$CONFIG_FILE" |
		sed -E 's/[[:space:]]+$//; s/^"(.*)"$/\1/' |
		tail -1
}

config_set_value() {
	local key=$1 value=$2 tmp
	mkdir -p "$(dirname "$CONFIG_FILE")"
	[ -f "$CONFIG_FILE" ] || write_config
	tmp=$(mktemp "$(dirname "$CONFIG_FILE")/config.XXXXXX")
	awk -v key="$key" -v value="$value" '
		BEGIN { written = 0 }
		$0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
			if (!written) print key " = " value
			written = 1
			next
		}
		{ print }
		END { if (!written) print key " = " value }
	' "$CONFIG_FILE" >"$tmp"
	mv "$tmp" "$CONFIG_FILE"
}

write_config() {
	mkdir -p "$(dirname "$CONFIG_FILE")"
	cat >"$CONFIG_FILE" <<EOF
# Configuration for bier. Created on first run.

# Where the program lives.
root = $(script_root)

# Where your Brewfiles live — your own, private repository. They reveal
# which software runs on your Macs and therefore do not belong in the
# public program repository. Set it up with install.sh.
# data = $BARREL/data

# Device name; decides which file under Brewfiles/ belongs to this Mac.
host = $(hostname -s)

# Where the plain files of the vault live. Outside any repository, so
# that nothing can commit them by accident. Only the encrypted copies
# under Safe/ in the data repository ever leave this Mac.
vault = $VAULT_DEFAULT
EOF
	info "Config created: $CONFIG_FILE"
}

if [ ! -f "$CONFIG_FILE" ]; then
	write_config
fi

# Precedence: environment variable, then config, then default.
ROOT=${BIER_ROOT:-$(config_get root)}
ROOT=${ROOT:-$(script_root)}
case $ROOT in
"~/"*) ROOT=$HOME/${ROOT#\~/} ;;
esac

# Where the Brewfiles live.
#
# Deliberately no fallback to the code directory: whoever clones the
# public repository would otherwise get their inventory written into it —
# and that inventory is exactly what must not be published. Empty means
# "not set up yet", and need_repo trips over it with instructions.
#
# The one exception is an older setup where code and data lived together;
# that is recognisable by the Brewfiles folder, which a fresh clone never
# has.
# Where a remembered signing key lives, next to the config that names
# where it came from.
SIGNERS_FILE=$(dirname "$CONFIG_FILE")/allowed_signers
SIGNERS_URL_FILE=$SIGNERS_FILE.url
# The agent is part of Bier itself, so it is built only from the same signed
# release tag that authorises an upgrade of the command-line program.
RELEASE_TRUST_URL=${BIER_RELEASE_TRUST_URL:-https://bier.uber.space/bier/allowed_signers}
# Peers describe reachable Macs only. They deliberately live next to the
# local configuration rather than in the Brewfile repository: knowing which
# machines may be contacted is not an inventory change to be synchronised.
PEERS_FILE=$(dirname "$CONFIG_FILE")/peers
PEER_PORT=${BIER_PEER_PORT:-53991}
PEER_CLIENT=${BIER_PEER_CLIENT:-$ROOT/Sources/bier-peer/build/bier-peer}
PAIRING_OFFER=$AGENT_HOME/state/pairing-offer.json
LOCAL_PEER_SIGNERS=$AGENT_HOME/peer_signers
# Macs another peer vouched for, waiting for bier peer accept; the agent
# writes it: "name address introduced-by key-type key".
PENDING_FILE=$AGENT_HOME/state/pending

DATA=${BIER_DATA:-$(config_get data)}
if [ -z "$DATA" ] && [ -d "$ROOT/Brewfiles" ]; then
	DATA=$ROOT
fi
case $DATA in
"~/"*) DATA=$HOME/${DATA#\~/} ;;
esac

HOST=${BIER_HOST:-$(config_get host)}
HOST=${HOST:-$(hostname -s)}

INVENTORY_MODE=${BIER_INVENTORY:-$(config_get inventory)}
INVENTORY_MODE=${INVENTORY_MODE:-automatic}
# Whether changes marked "install now" are applied when they arrive.
APPLY_MODE=${BIER_APPLY:-$(config_get apply)}
APPLY_MODE=${APPLY_MODE:-automatic}
case $INVENTORY_MODE in
automatic | manual) ;;
*) die "inventory must be 'automatic' or 'manual' in $CONFIG_FILE" ;;
esac

BREW_DIR=$DATA/Brewfiles
# Who is in which group, and each group's rules. Plain text beside the
# Brewfiles: every Mac needs it to know its software, vault or not.
GROUPS_FILE=$DATA/groups

# Everything that is not a Brewfile. The plain files live outside any
# repository on purpose: a .gitignore is a rule that can be got wrong,
# a different directory is a fact. Only the encrypted copies travel.
VAULT=${BIER_VAULT:-$(config_get vault)}
VAULT=${VAULT:-$VAULT_DEFAULT}
case $VAULT in
"~/"*) VAULT=$HOME/${VAULT#\~/} ;;
esac
SAFE_DIR=$DATA/Safe
HOST_FILE=$BREW_DIR/$HOST
MAIN_FILE=$BREW_DIR/main

# Temporary files: one directory for the whole run, cleaned up on exit.
#
# Two traps I have fallen into here. A "trap ... RETURN" per function does
# not work: the trap stays armed and fires again when the *calling*
# function returns — by then the local variable is gone and set -u aborts.
# And creating the directory lazily inside tmpfile does not work either:
# tmp=$(tmpfile) runs in a subshell, the assignment to BIER_TMP evaporates
# there and the EXIT trap deletes the directory right away. So: here,
# once per invocation.
BIER_TMP=$(mktemp -d -t bier)
trap 'rm -rf "$BIER_TMP"' EXIT
tmpfile() { mktemp "$BIER_TMP/XXXXXX"; }

need_brew() {
	command -v brew >/dev/null 2>&1 || die "Homebrew not found"
}

# Guards against a wrong config entry creating folders somewhere — and
# catches the case where somebody cloned the program but does not own a
# repository for their Brewfiles yet. Those do not belong in the public
# program repository: they reveal what is installed on the Macs, and a
# person who cloned the program has no write access here anyway.
need_repo() {
	if [ -n "$DATA" ] && [ -d "$DATA/.git" ]; then
		repair_repo
		return 0
	fi
	if [ -z "$DATA" ] || [ "$DATA" = "$ROOT" ]; then
		die "No repository of your own set up for your Brewfiles yet.

     The inventory of your Macs belongs in a private repository that is
     yours — not here, where the program lives.

     Set it up:  $ROOT/install.sh"
	fi
	die "no git repository at $DATA

     Does \"data\" in $CONFIG_FILE point at the right path?
     Set it up again:  $ROOT/install.sh"
}

# A data repository adopted from a paired Mac by an older bier was
# cloned from a temporary bundle: no branch, and that bundle, long
# deleted, as its origin. Commits then died with "no current branch",
# and the menu bar called the inventory server unreachable.
repair_repo() {
	local origin
	if ! git -C "$DATA" symbolic-ref -q HEAD >/dev/null 2>&1 &&
		[ ! -d "$DATA/.git/rebase-merge" ] && [ ! -d "$DATA/.git/rebase-apply" ]; then
		git -C "$DATA" checkout --quiet -B main &&
			info "The data repository was on no branch; it is on main again." >&2
	fi
	origin=$(git -C "$DATA" remote get-url origin 2>/dev/null || true)
	case $origin in
	*.bundle)
		git -C "$DATA" remote remove origin &&
			info "Removed a leftover origin ($origin) from the data repository." >&2
		;;
	esac
	return 0
}

# For commands that work on the code rather than on the data.
need_code() {
	[ -d "$ROOT/.git" ] ||
		die "no git repository at $ROOT — check \"root\" in $CONFIG_FILE"
}

# Every kind of entry brew bundle writes. Kept in one place: an entry of
# a kind missing here would drop out of the lists on the next dump, and
# install would refuse the file as holding something that is no entry.
KINDS='tap|brew|cask|mas|vscode|go|cargo|uv|npm|krew|flatpak|whalebrew|winget'

# Print the entries of a Brewfile normalised: 'kind "name"', sorted.
# Comment lines and options (args:, id: …) are dropped.
entries() {
	[ -f "$1" ] || return 0
	# No match is not an error — an empty file is a valid state. Without
	# the || true, pipefail drags every assignment down with it.
	{ grep -E "^[[:space:]]*($KINDS)[[:space:]]+\"" "$1" || true; } |
		sed -E 's/^[[:space:]]*([a-z]+)[[:space:]]+"([^"]+)".*/\1 "\2"/' |
		sort -u
}

# A Brewfile is Ruby, and "brew bundle" evaluates it. Anything in it
# that is not an entry is therefore a program somebody put there — and
# "entries" above would not show it, because it reads only the front of
# a line: brew "wget"; system("…") is displayed as plain brew "wget".
#
# So the whole line has to fit. Options are allowed by name, and
# "postinstall" is deliberately not among them: its value is a shell
# command. A trailing comment is fine — nothing can hide behind a #,
# not even a quote.
brewfile_grammar() {
	local name='"[^"]*"'
	local key='(id|trusted|args|link|greedy|require_sha|conflicts_with|restart_service|start_service)'
	local value='(true|false|nil|[0-9]+|"[^"]*"|\[[^]]*\]|\{[^}]*\})'
	local opt="([[:space:]]*,[[:space:]]*$key:[[:space:]]*$value)"
	printf '%s%s%s' \
		"^[[:space:]]*($KINDS)[[:space:]]+" \
		"$name$opt*[[:space:]]*(#.*)?\$" \
		'|^[[:space:]]*(#.*)?$'
}

# The lines of a Brewfile that are not entries, numbered.
foreign_lines() {
	[ -f "$1" ] || return 0
	grep -nvE "$(brewfile_grammar)" "$1" || true
}

# Refuses to hand a file to "brew bundle", which would run it.
verify_brewfile() {
	local bad
	bad=$(foreign_lines "$1")
	[ -z "$bad" ] || die "$1 holds lines that are not entries:

$(printf '%s\n' "$bad" | sed 's/^/       /')

     A Brewfile is Ruby and \"brew bundle\" runs it, so these would be
     executed on this Mac — and no bier command shows them, because
     they only have to look like an entry at the front of the line.

     Take them out. If you put them there yourself and mean it, run
     brew bundle install --file \"$1\" by hand."
}

# What a device is supposed to have: its device file plus main. Only
# together do the two describe what should run on that Mac.
# What a Mac has: All Macs, its group's software, and what it recorded
# itself and nobody has given to a group yet.
host_entries() {
	local g
	g=$(host_group "$1")
	{
		entries "$BREW_DIR/$1"
		entries "$MAIN_FILE"
		[ -z "$g" ] || entries "$BREW_DIR/@$g"
	} | sort -u
}

own_entries() { host_entries "$HOST"; }

# Every entry recorded anywhere in the repository — main and each device.
all_entries() {
	local f
	{
		for f in "$BREW_DIR"/*; do
			[ -f "$f" ] || continue
			entries "$f"
		done
	} | sort -u
}

# All devices in Brewfiles/ — every file except main is a device.
host_list() {
	[ -d "$BREW_DIR" ] || return 0
	for f in "$BREW_DIR"/*; do
		[ -f "$f" ] || continue
		name=$(basename "$f")
		# @laptops is a group's list, not a Mac.
		case $name in main | @*) ;; *) printf '%s\n' "$name" ;; esac
	done
}

# A peer may be an SSH host alias, a DNS name, an address, or user@host. Do
# not pass a value beginning with '-' to ssh, and keep the persisted format
# one name per line so it remains auditable and easy to repair by hand.
peer_name_ok() {
	[ -n "${1:-}" ] && printf '%s\n' "$1" |
		grep -Eq '^[A-Za-z0-9][A-Za-z0-9._:@-]*$'
}

# Runs the peer client against one paired Mac. A peer written as
# user@host is reached over SSH: a tunnel to the agent on the far side,
# so nothing but SSH has to be reachable there -- no Tailscale, no open
# port. Anything else is reached directly, on the local network or over
# Tailscale.
peer_call() {
	local command=$1 peer=$2 port=$PEER_PORT tunnel="" status=0 i=0
	local -a via=()
	shift 2
	case $peer in
	*@*)
		# Macs asked side by side each start their own range of ports.
		port=${PEER_TUNNEL_PORT:-53992}
		while nc -z 127.0.0.1 "$port" 2>/dev/null; do port=$((port + 1)); done
		ssh -N -o BatchMode=yes -o ConnectTimeout=10 -o ExitOnForwardFailure=yes \
			-L "127.0.0.1:$port:127.0.0.1:$PEER_PORT" "$peer" 2>/dev/null &
		tunnel=$!
		until nc -z 127.0.0.1 "$port" 2>/dev/null; do
			if ! kill -0 "$tunnel" 2>/dev/null || [ "$i" -ge 75 ]; then
				kill "$tunnel" 2>/dev/null || true
				info "Cannot reach $peer over SSH: is key-based login set up?" >&2
				return 1
			fi
			sleep 0.2
			i=$((i + 1))
		done
		via=(--via 127.0.0.1)
		;;
	esac
	"$PEER_CLIENT" "$command" "$peer" ${via[@]+"${via[@]}"} --port "$port" --local "$HOST" "$@" || status=$?
	if [ -n "$tunnel" ]; then
		kill "$tunnel" 2>/dev/null || true
		wait "$tunnel" 2>/dev/null || true
	fi
	return "$status"
}

peer_list() {
	[ -f "$PEERS_FILE" ] || return 0
	grep -E '^[A-Za-z0-9][A-Za-z0-9._:@-]*$' "$PEERS_FILE" | sort -u
}

# A Mac has one name: the one it signs with (its hostname -s). An
# address -- febook.local, febook.tailfb3bf.ts.net, ma@febook -- is only
# how it is reached, and can change without it becoming another Mac.
# bier learns the name when pairing and whenever the Mac answers.
PEER_NAMES=$AGENT_HOME/state/peer-names

peer_name_of() {
	local address=$1 name=""
	[ ! -f "$PEER_NAMES" ] || name=$(awk -F '\t' -v a="$address" '$1 == a { n = $2 } END { print n }' "$PEER_NAMES")
	[ -n "$name" ] || [ ! -f "$AGENT_HOME/state/paired-addresses" ] ||
		name=$(awk -v a="$address" '$2 == a { n = $1 } END { print n }' "$AGENT_HOME/state/paired-addresses")
	if [ -z "$name" ]; then
		name=${address##*@}
		name=${name%%.*}
	fi
	printf '%s\n' "$name"
}

peer_name_set() {
	local address=$1 name=$2 tmp
	peer_name_ok "$name" || return 0
	mkdir -p "$(dirname "$PEER_NAMES")"
	tmp=$(mktemp "$(dirname "$PEER_NAMES")/peer-names.XXXXXX")
	{
		[ ! -f "$PEER_NAMES" ] || awk -F '\t' -v a="$address" '$1 != a' "$PEER_NAMES"
		printf '%s\t%s\n' "$address" "$name"
	} >"$tmp"
	mv "$tmp" "$PEER_NAMES"
}

# Asks the Mac at an address for its name, and remembers it. Quick:
# the agent's hello answers at once, or the Mac is away.
peer_learn_name() {
	local name
	name=$(peer_call name "$1" --identity "$PEER_IDENTITY" 2>/dev/null) || return 1
	peer_name_set "$1" "$name"
	printf '%s\n' "$name"
}

# The address a Mac is reached by, from its name.
peer_address_of() {
	local address
	for address in $(peer_list); do
		[ "$(peer_name_of "$address")" != "$1" ] || { printf '%s\n' "$address"; return 0; }
	done
	return 1
}

peer_remember() {
	local peer=$1
	if peer_list | grep -qxF "$peer"; then
		return 0
	fi
	mkdir -p "$(dirname "$PEERS_FILE")"
	printf '%s\n' "$peer" >>"$PEERS_FILE"
}

peer_forget() {
	local peer=$1 tmp
	if ! peer_list | grep -qxF "$peer"; then
		return 0
	fi
	tmp=$(tmpfile)
	peer_list | grep -vxF "$peer" >"$tmp" || true
	mkdir -p "$(dirname "$PEERS_FILE")"
	mv "$tmp" "$PEERS_FILE"
}

# Every SSH/SCP call in the peer setup path is deliberately non-interactive
# and refuses unknown host keys. A peer name was checked before it reaches
# these helpers, so it cannot be interpreted as an option.
peer_ssh() {
	ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=yes "$@"
}

peer_scp() {
	scp -q -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=yes "$@"
}

peer_http_request() {
	local method=$1 path=$2 peer=$3 body=$4 response=$5
	local key=$PEER_IDENTITY network_host request signature time nonce body_hash
	[ -r "$key" ] || return 1
	network_host=${peer##*@}
	time=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	nonce=$(uuidgen | tr '[:upper:]' '[:lower:]')
	body_hash=$(shasum -a 256 "$body" | awk '{print $1}') || return 1
	request=$(tmpfile)
	printf '%s\n%s\n%s\n%s\n%s\n%s\n' "$method" "$path" "$HOST" "$time" "$nonce" "$body_hash" >"$request"
	ssh-keygen -q -Y sign -f "$key" -n bier-peer "$request" || return 1
	signature=$(base64 <"$request.sig" | tr -d '\n')
	curl -fsS --max-time 20 -X "$method" -H 'Content-Type: application/json' \
		-H "X-Bier-Peer: $HOST" -H "X-Bier-Time: $time" -H "X-Bier-Nonce: $nonce" \
		-H "X-Bier-Signature: $signature" --data-binary @"$body" \
		"http://$network_host:$PEER_PORT$path" >"$response"
}

peer_is_self() {
	local host=${1%.} short
	short=${host%%.*}
	[ "$short" = "$HOST" ]
}

peer_authorize() {
	local peer=$1 key=$HOME/.ssh/id_ed25519.pub

	info "1/4  Connecting to $peer …"
	if peer_ssh "$peer" true; then
		info "     SSH access is ready."
		return 0
	fi

	[ -r "$key" ] || die "SSH to $peer needs a public key on this Mac.

     Create one once with:
     ssh-keygen -t ed25519"

	info "     First connection: verify the host fingerprint and enter the password once."
	cat "$key" | ssh -o BatchMode=no -o ConnectTimeout=10 -o StrictHostKeyChecking=ask "$peer" '
		set -eu
		umask 077
		mkdir -p "$HOME/.ssh"
		touch "$HOME/.ssh/authorized_keys"
		while IFS= read -r key; do
			if ! grep -qxF "$key" "$HOME/.ssh/authorized_keys"; then
				printf "%s\n" "$key" >>"$HOME/.ssh/authorized_keys"
				mkdir -p "$HOME/.barrel/agent"
				printf "%s\n" "$key" >"$HOME/.barrel/agent/ssh-key-installed"
			fi
		done
	' || die "could not authorise this Mac for SSH on $peer"

	peer_ssh "$peer" true ||
		die "SSH key authorisation on $peer did not work"
	info "     SSH access is ready."
}

# --- Helpers -----------------------------------------------------------------

# Print the entries of $1 that are not already in $2 — in their original
# spelling, options included (mas … id:, tap … URL). Comments are dropped:
# a delta file would otherwise carry descriptions of packages it no longer
# lists.
delta() {
	local base_keys line key
	# On the very first dump the device file does not exist yet. Without
	# this line grep complains, and the first impression of bier is an
	# error message.
	[ -f "$1" ] || return 0
	base_keys=$(entries "$2")
	{ grep -E "^[[:space:]]*($KINDS)[[:space:]]+\"" "$1" || true; } |
		while IFS= read -r line; do
			key=$(printf '%s\n' "$line" |
				sed -E 's/^[[:space:]]*([a-z]+)[[:space:]]+"([^"]+)".*/\1 "\2"/')
			if ! printf '%s\n' "$base_keys" | grep -qxF "$key"; then
				printf '%s\n' "$line"
			fi
		done
}

# Defuse special characters in package names (python@3.12, gtk+) for use
# in a regular expression.
rx_quote() {
	printf '%s' "$1" | sed -E 's/[][\.^$*+?(){}|]/\\&/g'
}

# Was this entry ever in a Brewfile? Then it is not an addition but a
# removal made on another device. The git history is the only place where
# that difference is recorded.
was_tracked() {
	# If the entry is still listed somewhere in the repository it is not
	# orphaned — it simply runs on another device. Without this check,
	# bier reports a package picked up from the other Mac as "removed
	# elsewhere".
	if all_entries | grep -qxF "$1"; then
		return 1
	fi
	git -C "$DATA" log --format=%h -1 -S"$1" -- Brewfiles/ 2>/dev/null | grep -q .
}

# Was it in main once, and is not any more? Taken out of main while
# another Mac keeps it on its own list: a Mac that had it only through
# main has to decide whether it stays, rather than be told to record it.
was_in_main() {
	! entries "$MAIN_FILE" | grep -qxF "$1" &&
		git -C "$DATA" log --format=%h -1 -S"$1" -- Brewfiles/main 2>/dev/null | grep -q .
}

# Splits "installed but not recorded" into NEW, STALE and DROPPED.
classify_add() {
	local entry
	printf '%s\n' "$1" | while IFS= read -r entry; do
		[ -n "$entry" ] || continue
		if was_tracked "$entry"; then
			printf 'STALE\t%s\n' "$entry"
		elif was_in_main "$entry"; then
			printf 'DROPPED\t%s\n' "$entry"
		else
			printf 'NEW\t%s\n' "$entry"
		fi
	done
}

# Removes an entry from every Brewfile — including the comment line that
# "brew bundle dump" writes above it.
strip_entry() {
	local f
	for f in "$BREW_DIR"/*; do
		[ -f "$f" ] || continue
		strip_entry_in "$f" "$1" "$2"
	done
}

strip_entry_in() {
	local f=$1 kind=$2 name=$3 rx tmp
	[ -f "$f" ] || return 0
	rx="^[[:space:]]*$(rx_quote "$kind")[[:space:]]+\"([^\"]*/)?$(rx_quote "$name")\""
	tmp=$(tmpfile)
	awk -v re="$rx" '
		/^[[:space:]]*#/ { pending = pending $0 "\n"; next }
		$0 ~ re          { pending = ""; next }
		                 { printf "%s", pending; pending = ""; print }
		END              { printf "%s", pending }
	' "$f" >"$tmp"
	mv "$tmp" "$f"
}

# Works out how a package was installed. The order is the crux: a short
# name like "sikarugir" matches both the tap "sikarugir-app/sikarugir" and
# the cask "sikarugir-app/sikarugir/sikarugir". So: exact matches first,
# then ask Homebrew, and taps last.
kind_of() {
	local name=$1 rx kind
	rx="^[[:space:]]*($KINDS)[[:space:]]+\"$(rx_quote "$name")\""
	kind=$({ grep -hE "$rx" "$BREW_DIR"/* 2>/dev/null || true; } |
		head -1 | sed -E 's/^[[:space:]]*([a-z]+).*/\1/')
	if [ -n "$kind" ]; then
		printf '%s' "$kind"
		return 0
	fi

	# What is actually installed is something Homebrew knows better than
	# the file does.
	if brew list --formula --full-name 2>/dev/null | grep -qxF "$name"; then
		printf 'brew'
		return 0
	fi
	if brew list --cask 2>/dev/null | grep -qxF "$name"; then
		printf 'cask'
		return 0
	fi
	if brew tap 2>/dev/null | grep -qxF "$name"; then
		printf 'tap'
		return 0
	fi

	# Last resort: the short name of a fully qualified entry, taps excluded.
	rx="^[[:space:]]*(${KINDS#tap|})[[:space:]]+\"[^\"]*/$(rx_quote "$name")\""
	{ grep -hE "$rx" "$BREW_DIR"/* 2>/dev/null || true; } |
		head -1 | sed -E 's/^[[:space:]]*([a-z]+).*/\1/' | tr -d '\n'
}

# Uninstalls a package. mas cannot do that without help, so that stays
# manual — better to say so than to pretend.
uninstall_one() {
	local kind=$1 name=$2
	case $kind in
	brew) brew uninstall "$name" ;;
	cask) brew uninstall --cask "$name" ;;
	tap) brew untap "$name" ;;
	vscode) code --uninstall-extension "$name" ;;
	npm) npm uninstall --global "$name" ;;
	cargo) cargo uninstall "$name" ;;
	uv) uv tool uninstall "$name" ;;
	krew) kubectl krew uninstall "$name" ;;
	whalebrew) whalebrew uninstall "$name" ;;
	flatpak) flatpak uninstall -y "$name" ;;
	mas)
		info "  $name came from the App Store — please remove it from"
		info "  /Applications by hand. I will take it out of the Brewfiles."
		;;
	*)
		info "  bier cannot uninstall $kind entries; remove $name by hand."
		info "  I will take it out of the Brewfiles."
		;;
	esac
}

# The original line behind a normalised entry, so that options such as
# "id:" or "trusted:" survive being moved around.
find_line() {
	local key=$1 kind name rx f line
	kind=${key%% *}
	name=$(printf '%s' "$key" | sed -E 's/^[a-z]+ "([^"]+)"$/\1/')
	rx="^[[:space:]]*$(rx_quote "$kind")[[:space:]]+\"$(rx_quote "$name")\""
	for f in "$BREW_DIR"/*; do
		[ -f "$f" ] || continue
		line=$({ grep -m1 -E "$rx" "$f" || true; })
		if [ -n "$line" ]; then
			printf '%s\n' "$line"
			return 0
		fi
	done
	printf '%s\n' "$key"
}

# Which devices list a given entry?
hosts_with() {
	local h out=""
	for h in $(host_list); do
		if entries "$BREW_DIR/$h" | grep -qxF "$1"; then
			out="$out $h"
		fi
	done
	printf '%s' "${out# }"
}

# "1 3-5, 8" into single, validated numbers.
expand_selection() {
	local input=$1 max=$2 tok a b i
	{
		for tok in $(printf '%s' "$input" | tr ',' ' '); do
			case $tok in
			*[!0-9-]*) die "not a number: $tok" ;;
			*-*)
				a=${tok%%-*}
				b=${tok##*-}
				if [ -z "$a" ] || [ -z "$b" ]; then die "invalid range: $tok"; fi
				i=$a
				while [ "$i" -le "$b" ]; do
					printf '%s\n' "$i"
					i=$((i + 1))
				done
				;;
			*) printf '%s\n' "$tok" ;;
			esac
		done
	} | sort -un | while read -r i; do
		if [ "$i" -ge 1 ] && [ "$i" -le "$max" ]; then
			printf '%s\n' "$i"
		fi
	done
}

# take moved entries between main and the Macs' own lists. With groups,
# software goes to All Macs or to groups -- that is bier place.
cmd_take() {
	die "take is gone: software goes to All Macs or to groups now.
     bier list                          what is where, and what is not assigned
     bier place <pkg> --all             for All Macs
     bier place <pkg> --on <group>,…    for groups"
}

# Fetches from the server and resolves conflicts on its own.
#
# .gitattributes makes git union-merge the Brewfiles, which covers the
# normal case. If a conflict survives anyway, we do the same by hand:
# Brewfiles are lists, keeping both sides is right. Duplicate lines do not
# bother brew and disappear with the next dump.
#
# Nobody should have to know git commands to keep their Macs in step.
resolve_union() {
	local open f
	open=$(git -C "$DATA" diff --name-only --diff-filter=U 2>/dev/null || true)
	[ -n "$open" ] || return 1

	while [ -n "$open" ]; do
		# Only Brewfiles get merged without asking.
		if printf '%s\n' "$open" | grep -qv '^Brewfiles/'; then
			return 1
		fi
		printf '%s\n' "$open" | while IFS= read -r f; do
			[ -n "$f" ] || continue
			sed -i '' -e '/^<<<<<<< /d' -e '/^=======$/d' -e '/^>>>>>>> /d' "$DATA/$f"
		done
		git -C "$DATA" add Brewfiles
		[ ! -f "$GROUPS_FILE" ] || git -C "$DATA" add groups
		GIT_EDITOR=true git -C "$DATA" rebase --continue >/dev/null 2>&1 || return 1
		open=$(git -C "$DATA" diff --name-only --diff-filter=U 2>/dev/null || true)
	done
	return 0
}

fetch_rebase() {
	local out
	if out=$(git -C "$DATA" pull --rebase --autostash 2>&1); then
		return 0
	fi

	if printf '%s' "$out" | grep -q 'CONFLICT'; then
		if resolve_union; then
			info "Both Macs had changes — merged."
			return 0
		fi
	fi

	# Not resolvable: roll everything back so nothing is left half done.
	git -C "$DATA" rebase --abort 2>/dev/null || true
	printf '%s\n' "$out" >&2
	die "Syncing with the server failed. Nothing was changed."
}

# Commits, fetches and pushes. Even without local changes it syncs,
# otherwise you miss the commits made on the other device.
publish() {
	local branch remote
	# Only the Brewfiles. "git add -A" would sweep up changes to the
	# script or the README as well and hide them under an inventory
	# message — that happened to me exactly once.
	git -C "$DATA" add Brewfiles
	[ ! -f "$GROUPS_FILE" ] || git -C "$DATA" add groups
	[ ! -d "$SAFE_DIR" ] || git -C "$DATA" add Safe
	if git -C "$DATA" diff --cached --quiet; then
		info "Nothing to commit."
	else
		git -C "$DATA" commit -q -m "$1"
		info "Commit: $1"
	fi

	# A freshly created private repository has no branch to pull yet.
	# Publish the first local branch directly and make it its upstream;
	# every later call takes the normal fetch/rebase path below.
	branch=$(git -C "$DATA" branch --show-current)
	[ -n "$branch" ] || die "the data repository has no current branch"
	if ! git -C "$DATA" remote get-url origin >/dev/null 2>&1; then
		info "Saved in the local Bier history."
		return 0
	fi
	if ! remote=$(git -C "$DATA" ls-remote --heads origin "$branch" 2>&1); then
		printf '%s\n' "$remote" >&2
		die "the data server could not be reached"
	fi
	if [ -z "$remote" ]; then
		git -C "$DATA" push --quiet --set-upstream origin "HEAD:$branch" ||
			die "could not create the first branch on the data server"
		info "First inventory pushed to origin."
		return 0
	fi

	fetch_rebase
	git -C "$DATA" push --quiet
	info "In sync with origin."
}

# --- Commands ----------------------------------------------------------------

cmd_peer_add() {
	local peer=${1:-}
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer add <host>'
	if peer_list | grep -qxF "$peer"; then
		info "Peer already known: $peer"
		return 0
	fi
	peer_remember "$peer"
	info "Peer added: $peer"
}

cmd_peer_list() {
	local peers n=0 peer
	peers=$(peer_list)
	if [ -z "$peers" ]; then
		info 'No peers known. Add one: bier peer add <host>'
		return 0
	fi
	info 'Known peers:'
	while IFS= read -r peer; do
		[ -n "$peer" ] || continue
		n=$((n + 1))
		printf '  %2s  %-16s %s\n' "$n" "$(peer_name_of "$peer")" "$peer"
	done <<EOF
$peers
EOF
}

# Forgets a paired Mac: its address, and its key if the name is the one
# it signs with. That is how a Mac taken off without signing off, or
# unreachable when it did, is got rid of by hand.
cmd_peer_remove() {
	local peer=${1:-} tmp found=no
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer remove <host>'
	if peer_list | grep -qxF "$peer"; then
		peer_forget "$peer"
		info "Peer removed: $peer"
		found=yes
	fi
	if [ -f "$LOCAL_PEER_SIGNERS" ] && awk -v p="$peer" '$1 == p { f = 1 } END { exit !f }' "$LOCAL_PEER_SIGNERS"; then
		tmp=$(tmpfile)
		awk -v p="$peer" '$1 != p' "$LOCAL_PEER_SIGNERS" >"$tmp"
		cat "$tmp" >"$LOCAL_PEER_SIGNERS"
		info "Key removed: $peer is no longer trusted here"
		found=yes
	fi
	[ "$found" = yes ] || die "no peer called $peer"
}

cmd_peer_check() {
	local peer=${1:-}
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer check <host>'
	info "Checking SSH to $peer …"
	peer_ssh "$peer" true || die "cannot reach $peer over SSH"
	info "SSH to $peer works."
}

cmd_peer_hello() {
	local peer=${1:-} key=$PEER_IDENTITY body response output
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer hello <host>'
	[ -r "$key" ] || die "no SSH identity at $key"
	if [ -x "$PEER_CLIENT" ]; then
		info "Checking authenticated Bier Agent access to $peer …"
		peer_call hello "$peer" --identity "$key" ||
			die "the Bier Agent on $peer did not accept this Mac"
		return 0
	fi
	body=$(tmpfile)
	response=$(tmpfile)
	info "Checking authenticated Bier Agent access to $peer …"
	peer_http_request GET /v1/peer/hello "$peer" "$body" "$response" ||
		die "the Bier Agent on $peer did not accept this Mac"
	output=$(cat "$response")
	printf '%s' "$output" | grep -q '"status":"peer-ok"' ||
		die "the Bier Agent on $peer sent an invalid peer response"
	info "Bier Agent on $peer accepted $HOST as a peer."
}

# The address the other Mac should reach this one by: a host name, or
# user@host to come back over SSH.
peer_pair_address_ok() {
	local host=${1#*@} user=
	[ "$host" = "$1" ] || user=${1%@*}
	case $user in
	*[!a-zA-Z0-9._-]*) return 1 ;;
	esac
	case $host in
	'' | [!a-zA-Z0-9]* | *[!a-zA-Z0-9.-]*) return 1 ;;
	esac
}

cmd_peer_offer() {
	# Its Tailscale name when Tailscale runs: the name that works from
	# anywhere, which the other Mac otherwise has to be told.
	local address
	address=$(own_address)
	if [ $# -ne 0 ]; then
		[ $# -eq 2 ] && [ "$1" = --address ] && peer_pair_address_ok "$2" ||
			die 'usage: bier peer offer [--address <own-host>]'
		address=$2
	fi
	[ -x "$AGENT_HOME/bin/bier-agent" ] || die "the local Bier agent is not installed; run install.sh"
	[ -r "$PEER_IDENTITY.pub" ] || die "the local Bier peer identity is missing; run install.sh"
	local shown
	shown=$(pairing_offer_open "$PAIRING_OFFER")
	info "Pairing is open for 10 minutes."
	info "On the other Mac run:  bier peer pair $address"
	info "One-time code: $shown"
}

# Opens pairing for 10 minutes: the agent takes one request that proves
# it knows the code. Prints the code, in groups of four.
pairing_offer_open() {
	local offer=$1 code tmp
	code=$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]')
	mkdir -p "$(dirname "$offer")"
	tmp=$(mktemp "$(dirname "$offer")/pairing-offer.XXXXXX")
	printf '{"version":1,"code":"%s","expires":%s,"attempts":0}\n' "$code" "$(date -v+10M +%s)" >"$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$offer"
	printf '%s' "$code" | sed -E 's/(.{4})/\1-/g; s/-$//'
}

# Bierkasten manages this Mac through the local agent. It pairs once, like
# a peer, into a list of its own: admin_signers. A peer is never an admin.
ADMIN_SIGNERS=$AGENT_HOME/admin_signers
cmd_admin() {
	local sub=${1:-}
	[ $# -gt 0 ] && shift
	case $sub in
	offer)
		[ -x "$AGENT_HOME/bin/bier-agent" ] || die "the local Bier agent is not installed; run install.sh"
		local shown
		shown=$(pairing_offer_open "$AGENT_HOME/state/admin/pairing-offer.json")
		info "Bierkasten can connect to this Mac for 10 minutes."
		info "Enter this code in Bierkasten: $shown"
		;;
	list)
		if [ -s "$ADMIN_SIGNERS" ]; then awk '{ print $1 }' "$ADMIN_SIGNERS"; else info "No Bierkasten is connected."; fi
		;;
	remove)
		[ $# -eq 1 ] || die 'usage: bier admin remove <name>'
		[ -f "$ADMIN_SIGNERS" ] && awk -v n="$1" '$1 == n { f = 1 } END { exit !f }' "$ADMIN_SIGNERS" ||
			die "$1 is not connected; see: bier admin list"
		local tmp
		tmp=$(mktemp "$AGENT_HOME/admin_signers.XXXXXX")
		awk -v n="$1" '$1 != n' "$ADMIN_SIGNERS" >"$tmp"
		chmod 600 "$tmp"
		mv "$tmp" "$ADMIN_SIGNERS"
		info "Disconnected $1."
		;;
	*) die 'usage: bier admin <offer|list|remove <name>>' ;;
	esac
}

# What Bierkasten shows about a Mac. The model name comes from
# system_profiler, which takes a second, so it is asked once.
mac_info() {
	local cache=$STATE_DIR/model model
	if [ -s "$cache" ]; then
		model=$(cat "$cache")
	else
		model=$(system_profiler SPHardwareDataType 2>/dev/null | sed -n 's/^ *Model Name: //p' | head -1)
		[ -z "$model" ] || { mkdir -p "$STATE_DIR"; printf '%s\n' "$model" >"$cache"; }
	fi
	printf 'INFO\tmacos\t%s\n' "$(sw_vers -productVersion 2>/dev/null)"
	[ -z "$model" ] || printf 'INFO\tmodel\t%s\n' "$model"
	df -H / 2>/dev/null | awk 'NR == 2 { printf "INFO\tdisk\t%s free of %s\n", $4, $2 }'
}

# Every paired Mac's own state, asked over the network: what bier state
# says there, each line headed AT <peer>, and FLEET <peer> online|offline,
# or reachable when it answers but cannot say how it is.
# For Bierkasten; slow when a Mac is away, so it is a command of its own.
cmd_fleet() {
	local peer dir n=0
	[ -x "$PEER_CLIENT" ] || die "the Swift peer client is not built; run install.sh"
	# All at once: one Mac that is away must not keep the others waiting.
	dir=$(mktemp -d "$BIER_TMP/fleet.XXXXXX")
	for peer in $(peer_list); do
		n=$((n + 1))
		PEER_TUNNEL_PORT=$((53992 + n * 20)) fleet_one "$peer" >"$dir/$n" &
	done
	wait
	[ "$n" = 0 ] || cat "$dir"/*
}

# A quick hello first: a Mac that is away is known in seconds, not after
# the long wait a status may need.
fleet_one() {
	local peer=$1 out
	if ! peer_learn_name "$peer" >/dev/null; then
		printf 'FLEET\t%s\toffline\n' "$peer"
	elif out=$(peer_call status "$peer" --identity "$PEER_IDENTITY" 2>/dev/null); then
		printf 'FLEET\t%s\tonline\n' "$peer"
		printf '%s\n' "$out" | sed "s/^/AT"$'\t'"$peer"$'\t'"/"
	else
		# It answers, but could not say how it is: an older bier, or
		# bier state failing there. Not the same as away.
		printf 'FLEET\t%s\treachable\n' "$peer"
	fi
}

# How other Macs reach this one: its Tailscale name when Tailscale runs,
# else its name on the local network.
own_address() {
	local ts name=""
	ts=$(command -v tailscale || echo /Applications/Tailscale.app/Contents/MacOS/Tailscale)
	[ ! -x "$ts" ] || name=$("$ts" status --json 2>/dev/null |
		sed -n 's/.*"DNSName": *"\([^"]*\)".*/\1/p' | head -1)
	name=${name%.}
	printf '%s\n' "${name:-$(hostname -s).local}"
}

# Everything Bierkasten shows, in lines of tab-separated fields: what
# bier state says, and
#   SELF    <address>                  how other Macs reach this one
#   GROUP   <name> <macs>              a group and its members
#   RULE    <group> <rule> <value>     apply or inventory, set for a group
#   MAC     <name>                     a Mac with a list of its own
#   ENTRY   main|<mac> <entry>         what a list holds
#   APPSET  <package> <app> <what> <scope>  an app's shared settings
#   FILE    <path> <scope>             a file or folder/ shared by path
#   PEER    <address> <commit|never> <time> <name>  a paired Mac, what
#                                      it last had, when it was last synced,
#                                      and its name
#   HISTORY <time> <subject> <commit>  the latest changes, newest first
cmd_report() {
	local h f scope peer
	cmd_state
	printf 'SELF\t%s\n' "$(own_address)"
	for h in $(host_list); do printf 'MAC\t%s\n' "$h"; done
	for h in $(group_list); do
		printf 'GROUP\t%s\t%s\n' "$h" "$(group_members "$h")"
		for f in apply inventory; do
			[ -z "$(group_rule "$h" "$f")" ] || printf 'RULE\t%s\t%s\t%s\n' "$h" "$f" "$(group_rule "$h" "$f")"
		done
	done
	entries "$MAIN_FILE" | sed 's/^/ENTRY'$'\t''main'$'\t''/'
	for f in "$BREW_DIR"/*; do
		[ -f "$f" ] && [ "$f" != "$MAIN_FILE" ] || continue
		entries "$f" | sed "s/^/ENTRY"$'\t'"${f##*/}"$'\t'"/"
	done
	# list_app_settings separates with |: tabs as IFS merge empty fields.
	list_app_settings | tr '|' '\t' | sed 's/^/APPSET'$'\t''/'
	list_files | sed -n 's/^  //p' | while IFS= read -r f; do
		scope=""
		case $f in
		*" (only "*")") scope=${f##* (only }; scope=${scope%)}; f=${f% (only *} ;;
		esac
		printf 'FILE\t%s\t%s\n' "$f" "$scope"
	done
	local sent
	for peer in $(peer_list); do
		sent=$(peer_sent_get "$peer")
		printf 'PEER\t%s\t%s\t%s\t%s\n' "$peer" "${sent:-never}" \
			"$(awk -F '\t' -v peer="$peer" '$1 == peer { t = $3 } END { print t }' "$STATE_DIR/peers-sent" 2>/dev/null)" \
			"$(peer_name_of "$peer")"
	done
	git -C "$DATA" log -20 --format='HISTORY%x09%ct%x09%s%x09%h' 2>/dev/null || true
}

cmd_peer_pair() {
	# A trailing dot, as Tailscale prints full names, is no part of it.
	local peer=${1%.} code=${BIER_PAIR_CODE:-} code_file usage
	local -a address_args=()
	usage='usage: bier peer pair <host> [--address <own-host>] [--code <code>]'
	peer_name_ok "$peer" || die "$usage"
	shift
	# --code is for Bierkasten, which cannot type into a prompt.
	while [ $# -gt 0 ]; do
		case $1 in
		--address) [ $# -ge 2 ] && peer_pair_address_ok "${2%.}" || die "$usage"; address_args=(--address "${2%.}") ;;
		--code) [ $# -ge 2 ] || die "$usage"; code=$2 ;;
		*) die "$usage" ;;
		esac
		shift 2
	done
	[ -x "$PEER_CLIENT" ] || die "the Swift peer client is not built; run install.sh"
	[ -r "$PEER_IDENTITY" ] && [ -r "$PEER_IDENTITY.pub" ] || die "the local Bier peer identity is missing; run install.sh"
	if [ -z "$code" ]; then
		printf 'One-time code from %s: ' "$peer"
		read -r code || code=
	fi
	[ -n "$code" ] || die "no pairing code entered"
	code_file=$(tmpfile)
	printf '%s\n' "$code" >"$code_file"
	chmod 600 "$code_file"
	info "Pairing with $peer …"
	peer_call pair "$peer" ${address_args[@]+"${address_args[@]}"} --identity "$PEER_IDENTITY" --code-file "$code_file" --peer-signers "$LOCAL_PEER_SIGNERS" ||
		die "pairing with $peer failed"
	peer_remember "$peer"
	peer_learn_name "$peer" >/dev/null || true
	info "Peer added: $(peer_name_of "$peer") at $peer"
	if [ -n "$DATA" ] && [ -d "$DATA/.git" ]; then
		info "Checking whether the new peer needs this Mac's Bier data …"
		peer_call seed-if-pristine "$peer" --identity "$PEER_IDENTITY" --data "$DATA" ||
			die "paired successfully, but could not initialise the peer data"
		# A peer that already recorded its own inventory keeps it, and
		# only a sync makes the two histories one.
		info "Synchronising Bier data with $peer …"
		peer_call sync "$peer" --identity "$PEER_IDENTITY" --data "$DATA" ||
			die "paired successfully, but could not synchronise with $peer; try again with: bier peer sync $peer"
		peer_sent_set "$peer"
	fi
}

peer_snapshot_files() {
	local output=$1 root=${2:-$DATA} top absolute relative
	: >"$output"
	if [ -L "$root/.gitattributes" ]; then
		die 'the Bier data snapshot contains a symbolic link: .gitattributes'
	fi
	[ ! -f "$root/.gitattributes" ] || printf '%s\n' .gitattributes >>"$output"
	for top in Brewfiles Safe; do
		[ -e "$root/$top" ] || continue
		if find "$root/$top" -type l -print -quit | grep -q .; then
			die "the Bier data snapshot contains a symbolic link under $top"
		fi
		while IFS= read -r absolute; do
			relative=${absolute#"$root/"}
			printf '%s\n' "$relative" | grep -Eq '^(Brewfiles|Safe)/[A-Za-z0-9._@/+:-]+$' ||
				die "unsupported path in the Bier data snapshot: $relative"
			printf '%s\n' "$relative" >>"$output"
		done < <(find "$root/$top" -type f -print | LC_ALL=C sort)
	done
}

peer_snapshot_manifest() {
	local snapshot=$1 files=$2 body=$3 path file bytes hash comma=
	printf '{"id":"%s","manifest":{"version":1,"entries":[' "$snapshot" >"$body"
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		file=$DATA/$path
		bytes=$(wc -c <"$file" | tr -d ' ')
		[ "$bytes" -le 1073741824 ] || die "Bier data file is larger than 1 GiB: $path"
		hash=$(shasum -a 256 "$file" | awk '{print $1}')
		printf '%s{"path":"%s","bytes":%s,"sha256":"%s"}' "$comma" "$path" "$bytes" "$hash" >>"$body"
		comma=,
	done <"$files"
	printf ']}}' >>"$body"
}

peer_send_snapshot() {
	local peer=$1 snapshot=$2 files=$3 begin=$4 response=$5
	local path file bytes offset first raw chunk_bytes encoded put commit
	peer_http_request POST /v1/peer/snapshot/begin "$peer" "$begin" "$response" || return 1
	grep -q '"status":"snapshot-ready"' "$response" || return 1
	raw=$(tmpfile)
	put=$(tmpfile)
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		file=$DATA/$path
		bytes=$(wc -c <"$file" | tr -d ' ')
		offset=0
		first=yes
		while [ "$offset" -lt "$bytes" ] || [ "$first" = yes ]; do
			dd if="$file" of="$raw" bs=32768 count=1 skip=$((offset / 32768)) 2>/dev/null
			chunk_bytes=$(wc -c <"$raw" | tr -d ' ')
			[ "$bytes" = 0 ] || [ "$chunk_bytes" -gt 0 ] || return 1
			encoded=$(base64 <"$raw" | tr -d '\n')
			printf '{"id":"%s","path":"%s","offset":%s,"data":"%s"}' "$snapshot" "$path" "$offset" "$encoded" >"$put"
			peer_http_request POST /v1/peer/snapshot/put "$peer" "$put" "$response" || return 1
			grep -q '"status":"snapshot-staged"' "$response" || return 1
			offset=$((offset + chunk_bytes))
			first=no
		done
	done <"$files"
	commit=$(tmpfile)
	printf '{"id":"%s"}' "$snapshot" >"$commit"
	peer_http_request POST /v1/peer/snapshot/commit "$peer" "$commit" "$response" || return 1
	grep -q '"status":"snapshot-committed"' "$response"
}

peer_fetch_snapshot() {
	local peer=$1 destination=$2 body response count index path bytes hash target offset length chunk_bytes actual
	body=$(tmpfile)
	response=$(tmpfile)
	peer_http_request GET /v1/peer/manifest "$peer" "$body" "$response" || return 1
	[ "$(/usr/bin/plutil -extract version raw -o - "$response" 2>/dev/null)" = 1 ] || return 1
	count=$(/usr/bin/plutil -extract entries raw -expect array -o - "$response" 2>/dev/null) || return 1
	mkdir -p "$destination"
	index=0
	while [ "$index" -lt "$count" ]; do
		path=$(/usr/bin/plutil -extract "entries.$index.path" raw -expect string -o - "$response" 2>/dev/null) || return 1
		bytes=$(/usr/bin/plutil -extract "entries.$index.bytes" raw -expect integer -o - "$response" 2>/dev/null) || return 1
		hash=$(/usr/bin/plutil -extract "entries.$index.sha256" raw -expect string -o - "$response" 2>/dev/null) || return 1
		printf '%s\n' "$path" | grep -Eq '^(\.gitattributes|(Brewfiles|Safe)/[A-Za-z0-9._@/+:-]+)$' || return 1
		printf '%s\n' "$bytes" | grep -Eq '^[0-9]+$' || return 1
		[ "$bytes" -le 1073741824 ] || return 1
		printf '%s\n' "$hash" | grep -Eq '^[0-9a-f]{64}$' || return 1
		target=$destination/$path
		[ ! -e "$target" ] || return 1
		mkdir -p "$(dirname "$target")"
		: >"$target"
		offset=0
		while [ "$offset" -lt "$bytes" ]; do
			length=$((bytes - offset))
			[ "$length" -le 32768 ] || length=32768
			printf '{"path":"%s","offset":%s,"length":%s}' "$path" "$offset" "$length" >"$body"
			peer_http_request POST /v1/peer/data/read "$peer" "$body" "$response" || return 1
			chunk_bytes=$(wc -c <"$response" | tr -d ' ')
			[ "$chunk_bytes" = "$length" ] || return 1
			cat "$response" >>"$target"
			offset=$((offset + chunk_bytes))
		done
		actual=$(shasum -a 256 "$target" | awk '{print $1}')
		[ "$actual" = "$hash" ] || return 1
		index=$((index + 1))
	done
}

cmd_peer_compare() {
	local peer=${1:-} remote local_files remote_files paths path differences=0
	[ $# -eq 1 ] && peer_name_ok "$peer" || die 'usage: bier peer compare <host>'
	need_repo
	if [ -x "$PEER_CLIENT" ]; then
		info "Reading and verifying Bier data from $peer …"
		peer_call compare "$peer" --identity "$PEER_IDENTITY" --data "$DATA" ||
			die "could not compare Bier data with $peer"
		return 0
	fi
	remote=$BIER_TMP/peer-data
	info "Reading and verifying Bier data from $peer …"
	peer_fetch_snapshot "$peer" "$remote" || die "could not read a verified Bier data snapshot from $peer"
	local_files=$(tmpfile)
	remote_files=$(tmpfile)
	peer_snapshot_files "$local_files" "$DATA"
	peer_snapshot_files "$remote_files" "$remote"
	paths=$(tmpfile)
	{ cat "$local_files"; cat "$remote_files"; } | LC_ALL=C sort -u >"$paths"
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		if [ ! -f "$DATA/$path" ] || [ ! -f "$remote/$path" ] || ! cmp -s "$DATA/$path" "$remote/$path"; then
			if [ "$differences" = 0 ]; then info 'Data differs:'; fi
			printf '  %s\n' "$path"
			differences=$((differences + 1))
		fi
	done <"$paths"
	if [ "$differences" = 0 ]; then
		info "Bier data is identical on $HOST and $peer."
	else
		info "$differences data file(s) differ. Nothing was changed."
	fi
}

cmd_peer_sync() {
	local peer=${1:-}
	[ $# -eq 1 ] && peer_name_ok "$peer" || die 'usage: bier peer sync <host>'
	need_repo
	[ -r "$PEER_IDENTITY" ] || die "the local Bier peer identity is missing; run install.sh"
	[ -x "$PEER_CLIENT" ] || die "the Swift peer client is not built; run install.sh"
	info "Synchronising Bier data with $peer …"
	peer_call sync "$peer" --identity "$PEER_IDENTITY" --data "$DATA" ||
		die "could not synchronise Bier data with $peer"
	peer_sent_set "$peer"
}

# Which commit each peer had after the last sync with it, so that status
# can say what has not reached it yet without asking over the network.
peer_sent_set() {
	local list=$STATE_DIR/peers-sent next
	mkdir -p "$STATE_DIR"
	next=$(mktemp "$STATE_DIR/peers-sent.XXXXXX")
	[ ! -f "$list" ] || awk -F '\t' -v peer="$1" '$1 != peer' "$list" >"$next"
	printf '%s\t%s\t%s\n' "$1" "$(git -C "$DATA" rev-parse HEAD)" "$(date +%s)" >>"$next"
	mv "$next" "$list"
}

peer_sent_get() {
	[ -f "$STATE_DIR/peers-sent" ] || return 0
	awk -F '\t' -v peer="$1" '$1 == peer { head = $2 } END { if (head != "") print head }' "$STATE_DIR/peers-sent"
}

peer_seed() {
	local peer=$1 mode=$2 command=seed body response remote snapshot files begin
	[ "$mode" != if-empty ] || command=seed-if-empty
	if [ -x "$PEER_CLIENT" ]; then
		info "Checking and sending Bier data to $peer …"
		peer_call "$command" "$peer" --identity "$PEER_IDENTITY" --data "$DATA" ||
			die "the Bier data snapshot was not accepted by $peer"
		return 0
	fi
	body=$(tmpfile)
	response=$(tmpfile)
	info "1/3  Checking the Bier data store on $peer …"
	peer_http_request GET /v1/peer/manifest "$peer" "$body" "$response" ||
		die "cannot read the Bier data store on $peer"
	remote=$(cat "$response")
	if ! printf '%s' "$remote" | grep -Eq '"entries"[[:space:]]*:[[:space:]]*\[[[:space:]]*\]'; then
		if [ "$mode" = if-empty ]; then
			info '     Existing peer data was kept unchanged.'
			return 0
		fi
		die "the Bier data store on $peer is not empty; refusing to replace it"
	fi
	info '     The peer is empty.'
	info '2/3  Preparing the local Bier data snapshot …'
	snapshot=$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]')
	files=$(tmpfile)
	begin=$(tmpfile)
	peer_snapshot_files "$files"
	peer_snapshot_manifest "$snapshot" "$files" "$begin"
	info "3/3  Sending the verified snapshot to $peer …"
	peer_send_snapshot "$peer" "$snapshot" "$files" "$begin" "$response" ||
		die "the Bier data snapshot was not accepted by $peer"
	info "Done. $peer now has the Bier data from $HOST."
}

cmd_peer_seed() {
	local peer=${1:-}
	[ $# -eq 1 ] && peer_name_ok "$peer" || die 'usage: bier peer seed <host>'
	need_repo
	[ -r "$PEER_IDENTITY" ] || die "the local Bier peer identity is missing; run install.sh"
	peer_seed "$peer" required
}

# A remote installation adds a LaunchAgent, an agent directory, a remembered
# peer and an SSH connection.  Uninstall reverses each of those changes.  It
# removes only the matching public key, never the remote user's SSH setup.
cmd_peer_uninstall() {
	local peer=${1:-} key=$HOME/.ssh/id_ed25519.pub network_host answer
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer uninstall <host>'
	info "This permanently removes Bier from $peer:"
	info '  - the Bier agent, its files and its LaunchAgent'
	info '  - the remembered peer and saved SSH host key on this Mac'
	info '  - the public SSH key this Mac uses to reach that host'
	info ''
	printf 'Remove it? [y/N] '
	read -r answer || answer=""
	case $answer in
	j | J | y | Y) ;;
	*)
		info 'Cancelled.'
		return 0
		;;
	esac

	info "1/3  Checking SSH access to $peer …"
	peer_ssh "$peer" true || die "cannot reach $peer over SSH"
	info '     SSH access is ready.'
	peer_ssh "$peer" 'mkdir -p "$HOME/.barrel/agent"' ||
		die "cannot prepare Bier removal on $peer"
	if [ -r "$key" ]; then
		peer_scp "$key" "$peer:.barrel/agent/uninstall-key.new" ||
			die "cannot prepare SSH key removal on $peer"
	fi
	info '2/3  Removing the Bier agent and SSH access …'
	peer_ssh "$peer" 'set -e
plist="$HOME/Library/LaunchAgents/com.bier.agent.plist"
legacy_plist="$HOME/Library/LaunchAgents/com.bierkasten.agent.plist"
state_dir="$HOME/.barrel/agent"
legacy_state_dir="$HOME/.local/share/bierkasten"
authorized_keys="$HOME/.ssh/authorized_keys"
launchctl bootout "gui/$(id -u)" "$plist" >/dev/null 2>&1 || true
launchctl bootout "gui/$(id -u)" "$legacy_plist" >/dev/null 2>&1 || true
rm -f "$plist"
rm -f "$legacy_plist"

if [ -f "$authorized_keys" ]; then
  for key_file in "$state_dir/ssh-key-installed" "$legacy_state_dir/ssh-key-installed" "$state_dir/uninstall-key.new"; do
    [ -s "$key_file" ] || continue
    tmp=$(mktemp "$HOME/.ssh/authorized_keys.bier.XXXXXX")
    grep -vxFf "$key_file" "$authorized_keys" >"$tmp" || true
    mv "$tmp" "$authorized_keys"
  done
fi
rm -rf "$state_dir"' ||
		die "cannot remove the Bier agent from $peer"
	network_host=${peer##*@}
	peer_forget "$peer"
	ssh-keygen -q -f "$HOME/.ssh/known_hosts" -R "$network_host" >/dev/null 2>&1 || true
	info '3/3  Removing local Bier connection details …'
	info "Done. Bier agent removed from $peer."
}

latest_agent_tag() {
	local api=${BIER_AGENT_RELEASE_API:-https://api.github.com/repos/MatthiasToberer/bierfile/releases/latest} json tag
	json=$(curl -fsSL --max-time 20 "$api") || die 'could not check the latest Bier agent release'
	tag=$(printf '%s\n' "$json" | sed -nE 's/.*"tag_name"[[:space:]]*:[[:space:]]*"(v[0-9]+(\.[0-9]+)*)".*/\1/p' | head -1)
	[ -n "$tag" ] || die 'the latest Bier agent release has no valid version tag'
	printf '%s' "$tag"
}

need_agent_release_trust() {
	local output
	if [ -s "$SIGNERS_FILE" ]; then
		info "2/4  Checking secure release verification …"
		info "     Release verification is ready."
		return 0
	fi
	info "2/4  Setting up secure release verification …"
	if ! output=$(cmd_trust "$RELEASE_TRUST_URL" 2>&1); then
		printf '%s\n' "$output" >&2
		die "could not set up release verification"
	fi
	info "     Release verification is ready."
}

write_agent_launch_agent() {
	local path=$1 home=$2 agent=$3 data=$4
	cat >"$path" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.bier.agent</string>
  <key>ProgramArguments</key><array>
    <string>$home/.barrel/agent/bin/bier-agent</string>
    <string>serve</string>
    <string>--agent</string><string>$agent</string>
    <string>--peer-signers</string><string>$home/.barrel/agent/peer_signers</string>
    <string>--peer-key</string><string>$home/.barrel/agent/identity.pub</string>
	<string>--peers-file</string><string>$home/.barrel/peers</string>
    <string>--data-dir</string><string>$data</string>
    <string>--port</string><string>53991</string>
    <string>--state-dir</string><string>$home/.barrel/agent/state</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
EOF
}

cmd_peer_install() {
	local peer=${1:-} tag home data agent plist network_host peer_key=$PEER_IDENTITY.pub
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer install <host>'
	[ -r "$peer_key" ] || die "the local Bier peer identity is missing; run install.sh"
	peer_authorize "$peer"
	need_agent_release_trust
	tag=$(latest_agent_tag)
	info "3/4  Installing verified Bier agent $tag …"

	home=$(peer_ssh "$peer" 'printf "%s\n" "$HOME"') ||
		die "cannot determine the home directory of $peer"
	home=$(printf '%s' "$home" | tr -d '\r\n')
	printf '%s\n' "$home" | grep -Eq '^/[A-Za-z0-9._/-]+$' ||
		die "the home directory reported by $peer is not safe to install into"
	data=$(peer_ssh "$peer" 'config="$HOME/.barrel/config" # bier-agent-data-directory
[ -f "$config" ] || config="$HOME/.config/bier/config"
data=$(sed -nE "s/^[[:space:]]*data[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$config" 2>/dev/null | tail -1)
case "$data" in "~/"*) data="$HOME/${data#\~/}" ;; esac
if [ -n "$data" ] && [ -d "$data/.git" ]; then printf "%s\n" "$data"; else printf "%s\n" "$HOME/.barrel/data"; fi') ||
		die "cannot determine the Bier data directory on $peer"
	data=$(printf '%s' "$data" | tr -d '\r\n')
	printf '%s\n' "$data" | grep -Eq '^/[A-Za-z0-9._/-]+$' ||
		die "the Bier data directory reported by $peer is not safe to use"
	agent=$(peer_ssh "$peer" hostname -s) || die "cannot determine the agent name of $peer"
	agent=$(printf '%s' "$agent" | tr -d '\r\n')
	peer_name_ok "$agent" || die "the agent name reported by $peer is not valid"
	plist=$(tmpfile)
	write_agent_launch_agent "$plist" "$home" "$agent" "$data"

	peer_ssh "$peer" 'set -e
mkdir -p "$HOME/.barrel/agent/bin" "$HOME/Library/LaunchAgents"
if [ ! -r "$HOME/.barrel/agent/identity" ] || [ ! -r "$HOME/.barrel/agent/identity.pub" ]; then
	rm -f "$HOME/.barrel/agent/identity" "$HOME/.barrel/agent/identity.pub"
	ssh-keygen -q -t ed25519 -N "" -C "bier@$(hostname -s)" -f "$HOME/.barrel/agent/identity"
fi
chmod 600 "$HOME/.barrel/agent/identity" "$HOME/.barrel/agent/identity.pub"' ||
		die "cannot prepare the Bier agent directory on $peer"
	peer_scp "$SIGNERS_FILE" "$peer:.barrel/agent/allowed_signers.new" ||
		die "cannot copy the public release keys to $peer"
	peer_scp "$peer_key" "$peer:.barrel/agent/peer-key.new" ||
		die "cannot copy this Mac's peer key to $peer"
	peer_scp "$plist" "$peer:Library/LaunchAgents/com.bier.agent.plist.new" ||
		die "cannot copy the Bier agent LaunchAgent to $peer"
	peer_ssh "$peer" "set -e
rm -rf \"\$HOME/.barrel/agent/source.new\"
git init --quiet \"\$HOME/.barrel/agent/source.new\"
git -C \"\$HOME/.barrel/agent/source.new\" remote add origin https://github.com/MatthiasToberer/bierfile.git
git -C \"\$HOME/.barrel/agent/source.new\" fetch --quiet --depth 1 origin \"refs/tags/$tag:refs/tags/$tag\"
git -C \"\$HOME/.barrel/agent/source.new\" checkout --quiet --detach \"$tag\"
git -C \"\$HOME/.barrel/agent/source.new\" -c gpg.ssh.allowedSignersFile=\"\$HOME/.barrel/agent/allowed_signers.new\" verify-tag \"$tag\" >/dev/null
\"\$HOME/.barrel/agent/source.new/Sources/bier-agent/build.sh\" \"\$HOME/.barrel/agent/bin/bier-agent.new\" >/dev/null
mv \"\$HOME/.barrel/agent/bin/bier-agent.new\" \"\$HOME/.barrel/agent/bin/bier-agent\"
chmod 700 \"\$HOME/.barrel/agent/bin/bier-agent\"
mv \"\$HOME/.barrel/agent/allowed_signers.new\" \"\$HOME/.barrel/agent/allowed_signers\"
touch \"\$HOME/.barrel/agent/peer_signers\"
awk -v peer=\"$HOST\" '\$1 != peer' \"\$HOME/.barrel/agent/peer_signers\" >\"\$HOME/.barrel/agent/peer_signers.new\" || true
printf '%s ' \"$HOST\" >>\"\$HOME/.barrel/agent/peer_signers.new\"
cat \"\$HOME/.barrel/agent/peer-key.new\" >>\"\$HOME/.barrel/agent/peer_signers.new\"
mv \"\$HOME/.barrel/agent/peer_signers.new\" \"\$HOME/.barrel/agent/peer_signers\"
rm -f \"\$HOME/.barrel/agent/peer-key.new\"
rm -rf \"\$HOME/.barrel/agent/source\"
mv \"\$HOME/.barrel/agent/source.new\" \"\$HOME/.barrel/agent/source\"
rm -rf \"\$HOME/.local/share/bierkasten\"
mv \"\$HOME/Library/LaunchAgents/com.bier.agent.plist.new\" \"\$HOME/Library/LaunchAgents/com.bier.agent.plist\"
launchctl bootout \"gui/\$(id -u)\" \"\$HOME/Library/LaunchAgents/com.bier.agent.plist\" >/dev/null 2>&1 || true
launchctl bootout \"gui/\$(id -u)\" \"\$HOME/Library/LaunchAgents/com.bierkasten.agent.plist\" >/dev/null 2>&1 || true
rm -f \"\$HOME/Library/LaunchAgents/com.bierkasten.agent.plist\"
launchctl bootstrap \"gui/\$(id -u)\" \"\$HOME/Library/LaunchAgents/com.bier.agent.plist\"" ||
		die "cannot start the Bier agent on $peer"

	network_host=${peer##*@}
	info "4/4  Checking whether the agent is reachable …"
	curl -fsS --max-time 5 "http://$network_host:53991/v1/health" |
		grep -q '"status":"ok"' || die "the Bier agent on $peer did not answer on TCP port 53991"
	peer_remember "$peer"
	if [ -n "$DATA" ] && [ -d "$DATA/.git" ]; then
		peer_seed "$peer" if-empty
	fi
	info "Done. $agent is ready on $peer."
}

# Releases/latest is deliberately resolved only when the user asks. A remote
# agent must never replace itself in the background: the same signed install
# path is an update, and it remains visible in the terminal.
cmd_peer_upgrade() {
	local peer=${1:-}
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer upgrade <host>'
	info "Updating the Bier agent on $peer from the latest trusted release …"
	cmd_peer_install "$peer"
}

peer_discover_wait() {
	local seconds=${BIER_PEER_DISCOVER_SECONDS:-3}
	case $seconds in
	'' | *[!0-9]*) die 'BIER_PEER_DISCOVER_SECONDS must be a whole number' ;;
	esac
	[ "$seconds" -le 30 ] || die 'BIER_PEER_DISCOVER_SECONDS must not exceed 30'
	printf '%s' "$seconds"
}

# dns-sd browse and lookup commands stay alive to watch for later changes.
# Run each briefly in the background, then collect the snapshot and stop it.
peer_discover_run() {
	local output=$1 seconds=$2
	shift 2
	dns-sd "$@" >"$output" 2>&1 &
	local pid=$!
	sleep "$seconds"
	kill "$pid" 2>/dev/null || true
	wait "$pid" 2>/dev/null || true
}

cmd_peer_discover() {
	command -v dns-sd >/dev/null 2>&1 ||
		die 'Bonjour discovery needs dns-sd (included with macOS)'
	[ "$#" -le 1 ] || die 'usage: bier peer discover [-ssh]'
	local mode=${1:-} service title suggestion seconds browse lookup instances instance host n=0
	case $mode in
	"")
		service=_bier-agent._tcp
		title='Bier agents found on the local network:'
		suggestion='To remember one: bier peer add <host>'
		;;
	-ssh)
		service=_ssh._tcp
		title='Macs with Remote Login found on the local network:'
		suggestion='To install one: bier peer install <user>@<host>'
		;;
	*) die 'usage: bier peer discover [-ssh]' ;;
	esac
	seconds=$(peer_discover_wait)
	browse=$(tmpfile)
	peer_discover_run "$browse" "$seconds" -B "$service" local.
	instances=$(awk '
		/ Add / {
			for (i = 1; i <= NF; i++) {
				if ($i == service || $i == service ".") {
					for (j = i + 1; j <= NF; j++) {
						printf "%s%s", (j == i + 1 ? "" : " "), $j
					}
					printf "\n"
					break
				}
			}
		}
	' service="$service" "$browse" | sed '/^$/d' | sort -u)
	if [ -z "$instances" ]; then
		if [ "$mode" = -ssh ]; then
			info 'No Macs with Remote Login found on the local network.'
		else
			info 'No Bier agents found on the local network.'
		fi
		return 0
	fi

	info "$title"
	while IFS= read -r instance; do
		[ -n "$instance" ] || continue
		lookup=$(tmpfile)
		peer_discover_run "$lookup" "$seconds" -L "$instance" "$service" local.
		host=$(sed -nE 's/.*can be reached at ([^ ]+)\.?(:[0-9]+)?.*/\1/p' "$lookup" |
			sed 's/\.$//' | head -1)
		if peer_name_ok "$host" && ! peer_is_self "$host"; then
			n=$((n + 1))
			printf '  %2s  %s\n' "$n" "$host"
		fi
	done <<EOF
$instances
EOF
	if [ "$n" = 0 ]; then
		info 'No usable host address was announced.'
	else
		info ''
		info "$suggestion"
	fi
}

# Every peer learns of every other one, once: this Mac vouches for each
# to the rest, and each keeps it as pending until accepted there. A new
# Mac paired with one Mac so reaches all, and nobody is trusted without
# being accepted. Best effort: a Mac out of reach is asked next time.
peer_introduce_all() {
	local done_file=$AGENT_HOME/state/introduced peer other name key body
	local -a names=() addresses=()
	for peer in $(peer_list); do
		if ! name=$(peer_learn_name "$peer"); then
			info "Cannot introduce $peer: no answer, or its bier is older than 0.46 (bier upgrade there)."
			continue
		fi
		peer_name_ok "$name" || continue
		names+=("$name")
		addresses+=("$peer")
	done
	[ "${#names[@]}" -ge 2 ] || return 0
	mkdir -p "$(dirname "$done_file")"
	for peer in "${!names[@]}"; do
		for other in "${!names[@]}"; do
			[ "$peer" != "$other" ] || continue
			key=$(awk -v n="${names[$other]}" '$1 == n { print $2, $3; exit }' "$LOCAL_PEER_SIGNERS" 2>/dev/null)
			[ -n "$key" ] || continue
			! grep -qxF "${names[$peer]} ${names[$other]} $key" "$done_file" 2>/dev/null || continue
			body=$(tmpfile)
			printf '{"peer":"%s","address":"%s","publicKey":"%s"}' "${names[$other]}" "${addresses[$other]}" "$key" >"$body"
			if peer_call introduce "${addresses[$peer]}" --identity "$PEER_IDENTITY" --body "$body" >/dev/null; then
				printf '%s %s %s\n' "${names[$peer]}" "${names[$other]}" "$key" >>"$done_file"
				info "Introduced ${names[$other]} to ${names[$peer]}; accept it there with: bier peer accept ${names[$other]}"
			else
				info "Could not introduce ${names[$other]} to ${names[$peer]}; is bier there 0.46 or later?"
			fi
		done
	done
}

pending_list() {
	[ -f "$PENDING_FILE" ] || return 0
	awk 'NF >= 5' "$PENDING_FILE"
}

cmd_peer_pending() {
	[ $# -eq 0 ] || die 'usage: bier peer pending'
	if [ -z "$(pending_list)" ]; then
		info "No Macs are waiting."
		return 0
	fi
	pending_list | while read -r name address by type key; do
		printf '%-16s %-32s introduced by %-12s %s\n' "$name" "$address" "$by" \
			"$(printf '%s %s\n' "$type" "$key" | ssh-keygen -lf - 2>/dev/null | awk '{ print $2 }')"
	done
	info ""
	info "Trust one with: bier peer accept <mac>   (or: accept all)"
}

# Takes the named pending Macs (or all) out of the list; prints their lines.
pending_take() {
	local which=$1 tmp lines
	[ -n "$(pending_list)" ] || die "no Macs are waiting. They appear after a bier sync on a Mac paired with both."
	lines=$(pending_list | awk -v w="$which" 'w == "all" || $1 == w')
	[ -n "$lines" ] || die "$which is not waiting; see: bier peer pending"
	tmp=$(mktemp "$(dirname "$PENDING_FILE")/pending.XXXXXX")
	pending_list | awk -v w="$which" '!(w == "all" || $1 == w)' >"$tmp"
	mv "$tmp" "$PENDING_FILE"
	printf '%s\n' "$lines"
}

cmd_peer_accept() {
	[ $# -eq 1 ] || die 'usage: bier peer accept <mac>|all'
	local lines name address by type key tmp
	lines=$(pending_take "$1")
	while read -r name address by type key; do
		tmp=$(mktemp "$AGENT_HOME/peer_signers.XXXXXX")
		{
			[ ! -f "$LOCAL_PEER_SIGNERS" ] || awk -v n="$name" '$1 != n' "$LOCAL_PEER_SIGNERS"
			printf '%s %s %s\n' "$name" "$type" "$key"
		} >"$tmp"
		chmod 600 "$tmp"
		mv "$tmp" "$LOCAL_PEER_SIGNERS"
		peer_remember "$address"
		peer_name_set "$address" "$name"
		# It has this Mac waiting too; the confirmation, signed with this
		# Mac's key, lets it trust this one without a second accept.
		if peer_call confirm "$address" --identity "$PEER_IDENTITY" >/dev/null 2>&1; then
			info "Accepted $name ($address), introduced by $by; it trusts $HOST now as well."
		else
			info "Accepted $name ($address), introduced by $by."
			info "  $name could not be told; on $name run: bier peer accept $HOST"
		fi
	done <<EOF
$lines
EOF
	info "Next: bier sync"
}

cmd_peer_reject() {
	[ $# -eq 1 ] || die 'usage: bier peer reject <mac>|all'
	pending_take "$1" | while read -r name address by _; do
		info "Rejected $name ($address), introduced by $by."
	done
}

# A Mac reached another way -- moved from SSH to Tailscale, say. The key
# stays: it is still the same Mac.
cmd_peer_address() {
	[ $# -eq 2 ] || die "usage: bier peer address <mac> <new-address>"
	local mac=$1 new=${2%.} old tmp
	peer_pair_address_ok "$new" || die "$new is not an address: a host name, or user@host"
	old=$(peer_address_of "$mac") || die "no paired Mac called $mac; see: bier peer list"
	if [ "$old" != "$new" ]; then
		tmp=$(tmpfile)
		awk -v o="$old" -v n="$new" '$0 == o { $0 = n } { print }' "$PEERS_FILE" >"$tmp"
		mv "$tmp" "$PEERS_FILE"
		[ ! -f "$PEER_NAMES" ] || { tmp=$(tmpfile); awk -F '\t' -v a="$old" '$1 != a' "$PEER_NAMES" >"$tmp"; mv "$tmp" "$PEER_NAMES"; }
	fi
	peer_name_set "$new" "$mac"
	if [ -x "$PEER_CLIENT" ] && peer_learn_name "$new" >/dev/null; then
		info "$mac is reached at $new now, and answers there."
	else
		info "$mac is reached at $new now. It does not answer there yet -- is it awake, and on Tailscale?"
	fi
}

cmd_peer_help() {
	cat <<'EOF'
bier peer — manage Macs Bier may contact

  bier peer discover      show Bier agents announced via Bonjour
  bier peer discover -ssh show Macs with Remote Login via Bonjour
  bier peer add <host>    remember a Mac locally
  bier peer list          show remembered Macs
  bier peer check <host>  check safe, non-interactive SSH access
  bier peer hello <host>  prove authenticated Bier Agent access
  bier peer offer [--address <own-host>]  show a one-time code for SSH-free pairing
  bier peer pair <host> [--address <own-host>] [--code <code>]  pair using its one-time code
  bier peer compare <host> compare verified data without changing it
  bier peer sync <host>   synchronise data and history with a peer
  bier peer seed <host>   copy data to a new, empty Bier peer
  bier peer trust [url]   alias for bier trust
  bier peer install <host> install a signed Bier agent via SSH
  bier peer upgrade <host> replace an agent with the latest signed release
  bier peer uninstall <host> stop and remove a Bier agent via SSH
  bier peer remove <host> forget a remembered Mac, its address or its key
  bier peer address <mac> <new-address>  reach a Mac another way; its key stays
  bier peer pending       Macs another peer introduced, waiting to be trusted
  bier peer accept <mac>|all  trust an introduced Mac, on both sides
  bier peer reject <mac>|all  drop an introduced Mac
EOF
}

cmd_peer() {
	if [ $# -eq 0 ]; then
		cmd_peer_help
		return 0
	fi
	local sub=$1
	shift
	case $sub in
	add) cmd_peer_add "$@" ;;
	list) cmd_peer_list "$@" ;;
	remove | rm) cmd_peer_remove "$@" ;;
check) cmd_peer_check "$@" ;;
hello) cmd_peer_hello "$@" ;;
offer) cmd_peer_offer "$@" ;;
pair) cmd_peer_pair "$@" ;;
compare) cmd_peer_compare "$@" ;;
sync) cmd_peer_sync "$@" ;;
seed) cmd_peer_seed "$@" ;;
trust) cmd_peer_trust "$@" ;;
install) cmd_peer_install "$@" ;;
upgrade | update) cmd_peer_upgrade "$@" ;;
uninstall) cmd_peer_uninstall "$@" ;;
discover) cmd_peer_discover "$@" ;;
pending) cmd_peer_pending "$@" ;;
address) cmd_peer_address "$@" ;;
accept) cmd_peer_accept "$@" ;;
reject) cmd_peer_reject "$@" ;;
help | -h | --help) cmd_peer_help ;;
*) die 'usage: bier peer <discover|add|list|check|hello|offer|pair|compare|sync|seed|trust|install|upgrade|uninstall|remove|pending|accept|reject> [host]' ;;
	esac
}

cmd_dump() {
	need_brew
	need_repo
	mkdir -p "$BREW_DIR"

	local adopt=no
	if [ "${1:-}" = "--adopt" ]; then adopt=yes; fi

	local tmp
	tmp=$(tmpfile)
	brew bundle dump --force --file "$tmp" >/dev/null

	# Whatever was removed on another Mac must not slip into the device
	# file here — a dump would otherwise turn that removal into a
	# device-specific installation and it would be lost for good. Such
	# entries stay out and thus remain visible as "removed elsewhere".
	local stale_now base
	stale_now=$(classify_add "$(comm -23 <(entries "$tmp") <(own_entries) || true)" |
		sed -nE 's/^(STALE|DROPPED)'$'\t''//p')

	base=$(tmpfile)
	cat "$MAIN_FILE" >"$base" 2>/dev/null || true
	if [ -n "$stale_now" ] && [ "$adopt" = no ]; then
		printf '%s\n' "$stale_now" >>"$base"
	fi

	# What is installed and not already in main.
	local new_lines keep_base old_lines out
	new_lines=$(tmpfile)
	delta "$tmp" "$base" >"$new_lines"

	# What was already recorded here but is not (yet) installed stays.
	# Otherwise a dump would throw away what you deliberately picked with
	# "bier place". An entry really goes away only through "bier uninstall"
	# or "bier prune".
	keep_base=$(tmpfile)
	cat "$base" "$new_lines" >"$keep_base"
	old_lines=$(tmpfile)
	delta "$HOST_FILE" "$keep_base" >"$old_lines"

	out=$(tmpfile)
	{
		printf '# %s — installed here, not given to All Macs or a group yet.\n' "$HOST"
		printf '# Written by "bier dump", do not edit by hand.\n\n'
		cat "$new_lines" "$old_lines"
	} >"$out"
	mv "$out" "$HOST_FILE"

	local n m
	n=$(entries "$HOST_FILE" | wc -l | tr -d ' ')
	m=$(entries "$MAIN_FILE" | wc -l | tr -d ' ')
	info "Recorded on $HOST: $n not assigned, beside $m for All Macs"

	if [ -n "$stale_now" ]; then
		if [ "$adopt" = no ]; then
			info ""
			info "Not adopted, because removed elsewhere or taken out of main (bier prune):"
			printf '%s\n' "$stale_now" | sed 's/^/  ~ /'
			info "To keep it here: bier dump --adopt"
		else
			info "Adopted although removed elsewhere:"
			printf '%s\n' "$stale_now" | sed 's/^/  + /'
		fi
	fi
}

# Creates Brewfiles/main from this Mac's inventory and rewrites every
# device file as a delta against it. Not a dump but a rebuild — hence a
# command of its own.
cmd_main() {
	need_brew
	need_repo
	mkdir -p "$BREW_DIR"

	local push=yes
	if [ "${1:-}" = "--no-push" ]; then push=no; fi

	# Dump into a copy first: only that way can we say beforehand what
	# would drop out of main.
	local incoming existing lost
	incoming=$(tmpfile)
	brew bundle dump --force --file "$incoming" >/dev/null

	existing=$(entries "$MAIN_FILE" | wc -l | tr -d ' ')
	if [ "$existing" != "0" ]; then
		info "Brewfiles/main holds $(count_word "$existing") and will be replaced"
		info "by the inventory of $HOST. What other devices have on top of it"
		info "stays in their device file."

		# Entries that are in main but not installed here disappear from
		# the repository — even if another Mac still has them. That is
		# the dangerous part and belongs before the question.
		lost=$(comm -23 <(entries "$MAIN_FILE") <(entries "$incoming") || true)
		if [ -n "$lost" ]; then
			info ""
			info "Will no longer be for All Macs, because it is not installed"
			info "on $HOST — even if another Mac still has it:"
			printf '%s\n' "$lost" | sed 's/^/  - /'
			info ""
			info "To keep it for some Macs, give it to their group first:"
			info "  bier place <package> --on <group>"
		fi

		info ""
		printf 'Continue? [y/N] '
		read -r answer || answer=""
		case $answer in
		j | J | y | Y) ;;
		*) die "cancelled" ;;
		esac
	fi

	cp "$incoming" "$MAIN_FILE"
	info "Brewfiles/main: inventory of $HOST, $(count_word "$(entries "$MAIN_FILE" | wc -l | tr -d ' ')")"

	# Every other list onto the new main: groups and what the Macs
	# recorded keep only what All Macs do not have already.
	local host file tmp g
	for g in $(group_list); do
		file=$BREW_DIR/@$g
		[ -f "$file" ] || continue
		tmp=$(tmpfile)
		{
			printf '# group %s — what its Macs have on top of All Macs.\n\n' "$g"
			delta "$file" "$MAIN_FILE"
		} >"$tmp"
		mv "$tmp" "$file"
		info "  group $g: $(entries "$file" | wc -l | tr -d ' ') entries left"
	done
	for host in $(host_list); do
		file=$BREW_DIR/$host
		tmp=$(tmpfile)
		{
			printf '# %s — installed here, not given to All Macs or a group yet.\n' "$host"
			printf '# Written by "bier dump", do not edit by hand.\n\n'
			delta "$file" "$MAIN_FILE"
		} >"$tmp"
		mv "$tmp" "$file"
		info "  $host: $(entries "$file" | wc -l | tr -d ' ') entries left"
	done

	if [ "$push" = yes ]; then
		publish "main: inventory of $HOST as the shared baseline"
	else
		info "Not pushed — later with 'bier sync'."
	fi
}

# Installs a package if it is not here yet, puts it on a list, and
# offers to share the app's settings as well. The counterpart of
# uninstall, and the way to add something in manual inventory mode.
#
#   --all | --group <g> | --here   All Macs, a group, or only recorded
#                            here, not assigned yet -- instead of asking
#   --settings | --no-settings   share every settings location found,
#                            or none, instead of asking
cmd_add() {
	need_brew
	need_repo
	local where="" settings="" name kind added=""
	while [ $# -gt 0 ]; do
		case $1 in
		--main | --all) where=main ;;
		--here) where=here ;;
		--group)
			[ $# -ge 2 ] || die "--group which?"
			group_list | grep -qxF "$2" || die "there is no group $2; see: bier group"
			where=group:$2
			shift
			;;
		--settings) settings=all ;;
		--no-settings) settings=none ;;
		--) shift; break ;;
		-*) die "unknown option: $1" ;;
		*) break ;;
		esac
		shift
	done
	[ $# -ge 1 ] || die "usage: bier add [--all | --group <g> | --here] [--settings | --no-settings] <package>…"

	local store line
	for name in "$@"; do
		line=""
		ADD_MAS_ID=""
		if kind=$(add_kind "$name") && [ "$kind" != mas ]; then
			line=$(printf '%s "%s"' "$kind" "$name")
		elif store=$(mas_lookup "$name"); then
			# An App Store app, by the name the store gives it.
			kind=mas
			ADD_MAS_ID=${store%%$'\t'*}
			name=${store#*$'\t'}
			line=$(printf 'mas "%s", id: %s' "$name" "$ADD_MAS_ID")
		else
			die "$name is neither a formula, a cask nor an App Store app"
		fi
		if ! add_installed "$kind" "$name"; then
			info "Installing $name …"
			case $kind in
			cask) brew install --cask "$name" ;;
			mas) mas install "$ADD_MAS_ID" ;;
			*) brew install "$name" ;;
			esac || die "could not install $name; nothing was added"
		fi
		add_to_list "$kind" "$name" "$where" "$line"
		add_settings "$kind" "$name" "$settings"
		added="$added $name"
	done
	[ -n "$added" ] || return 0
	publish "$HOST: added${added}"
}

# What a new name is: known from the lists or installed, else asked of
# Homebrew, casks first -- an app is what people add by name.
add_kind() {
	local kind
	kind=$(kind_of "$1")
	if [ -n "$kind" ]; then
		printf '%s' "$kind"
	elif brew info --cask "$1" >/dev/null 2>&1; then
		printf cask
	elif brew info --formula "$1" >/dev/null 2>&1; then
		printf brew
	else
		return 1
	fi
}

add_installed() {
	case $1 in
	cask) brew list --cask 2>/dev/null | grep -qxF "${2##*/}" ;;
	brew) brew list --formula 2>/dev/null | grep -qxF "$2" ;;
	mas) mas list 2>/dev/null | awk '{ print $1 }' | grep -qxF "$ADD_MAS_ID" ;;
	*) return 0 ;;
	esac
}

# An App Store app by its exact name, installed or in the store:
# "<id>\t<name>". The names in a Brewfile are the store's.
ADD_MAS_ID=""
mas_lookup() {
	command -v mas >/dev/null 2>&1 || return 1
	local found
	found=$({ mas list 2>/dev/null; mas search "$1" 2>/dev/null; } | awk -v n="$1" '
		{ id = $1; $1 = ""; sub(/^ +/, ""); sub(/ +\(.*$/, "")
		  if (tolower($0) == tolower(n)) { print id "\t" $0; exit } }')
	[ -n "$found" ] && printf '%s' "$found"
}

# Where an App Store app is: Spotlight knows it by its store id; the file
# name need not be the store name ("Keynote" is "Keynote Creator
# Studio.app").
mas_app_path() {
	local path dir
	path=$(mdfind "kMDItemAppStoreAdamID == $1" 2>/dev/null | grep '\.app$' | head -1 || true)
	if [ -n "$path" ] && [ -d "$path" ]; then
		printf '%s' "$path"
		return 0
	fi
	for dir in "${BIER_APPS_DIR:-/Applications}" "$HOME/Applications"; do
		[ -d "$dir/$2.app" ] || continue
		printf '%s' "$dir/$2.app"
		return 0
	done
	return 1
}

# Onto main or this Mac's list. The last choice is remembered for the
# settings: only here means only for this Mac.
ADD_SCOPE=""
add_to_list() {
	local kind=$1 name=$2 where=$3 line=$4 answer key
	key=$(printf '%s "%s"' "$kind" "$name")
	ADD_SCOPE=""
	if entries "$MAIN_FILE" | grep -qxF "$key"; then
		info "$name is in main already."
		return 0
	fi
	if [ -z "$where" ]; then
		local own
		own=$(host_group "$HOST")
		if [ -n "$own" ]; then
			printf 'Where to?  [a] All Macs   [g] group %s   [h] only record it here   [c] cancel: ' "$own"
		else
			printf 'Where to?  [a] All Macs   [h] only record it here   [c] cancel: '
		fi
		read -r answer ||
			die "nobody to ask. Say where: bier add --all | --group <g> | --here $name"
		case $answer in
		a | A | m | M) where=main ;;
		g | G) [ -n "$own" ] || die "$HOST is in no group yet"; where=group:$own ;;
		h | H) where=here ;;
		*)
			info "Cancelled; $name stays installed but on no list."
			return 0
			;;
		esac
	fi
	if [ "$where" = main ]; then
		strip_entry "$kind" "$name"
		printf '%s\n' "$line" >>"$MAIN_FILE"
		info "Added for All Macs."
	elif [ "${where#group:}" != "$where" ]; then
		entries "$BREW_DIR/@${where#group:}" | grep -qxF "$key" || printf '%s\n' "$line" >>"$BREW_DIR/@${where#group:}"
		strip_entry_in "$BREW_DIR/$HOST" "$kind" "$name"
		ADD_SCOPE=${where#group:}
		info "Added for the group ${where#group:}."
	else
		entries "$BREW_DIR/$HOST" | grep -qxF "$key" || printf '%s\n' "$line" >>"$BREW_DIR/$HOST"
		ADD_SCOPE=$HOST
		info "Recorded on $HOST, not assigned yet: bier place $name --all | --on <group>"
	fi
}

# Where a package belongs: every Mac, or the Macs and groups named. bier
# writes the lists -- main, Brewfiles/@<group>, each Mac's own -- and
# takes it off every list not named. Works for a package no Mac has yet.
# --now also installs or removes it on every Mac as soon as the change
# reaches it (unless that Mac is set to bier config apply ask).
cmd_place() {
	need_brew
	need_repo
	local where="" now=no targets="" t words name=""
	# Options before or after the name, as people type them.
	while [ $# -gt 0 ]; do
		case $1 in
		--all) where=all ;;
		--none) where=none ;;
		--on)
			[ $# -ge 2 ] || die "--on which? --on mini,@laptops"
			where=on
			targets=$(printf '%s' "$2" | tr ',' ' ')
			shift
			;;
		--now) now=yes ;;
		-*) die "unknown option: $1" ;;
		*) [ -z "$name" ] || die "one package at a time"; name=$1 ;;
		esac
		shift
	done
	[ -n "$name" ] && [ -n "$where" ] ||
		die "usage: bier place <package> --all | --on <group>,… | --none [--now]"
	set -- "$name"
	groups_migrate
	# Only to groups: a single Mac gets software through its group.
	for t in $targets; do
		group_list | grep -qxF "${t#@}" ||
			die "${t#@} is not a group. Software goes to All Macs or to groups: bier group"
	done
	place_line "$1" || die "$1 is neither a formula, a cask nor an App Store app"

	strip_entry "$PLACE_KIND" "$PLACE_NAME"
	case $where in
	all) printf '%s\n' "$PLACE_LINE" >>"$MAIN_FILE"; words="every Mac" ;;
	none) words="no Mac" ;;
	on)
		for t in $targets; do printf '%s\n' "$PLACE_LINE" >>"$BREW_DIR/@${t#@}"; done
		words=$(printf '%s' "$targets" | sed 's/ /, /g')
		;;
	esac

	if [ "$now" = no ]; then
		publish "$HOST: $PLACE_NAME on $words"
		info "Saved. The Macs install or remove it when someone applies: bier install / bier prune"
		return 0
	fi
	publish "$HOST: $PLACE_NAME on $words (install now)"
	# Here only this package; this Mac's own change is not news to it.
	git -C "$DATA" rev-parse HEAD >"$STATE_DIR/applied" 2>/dev/null || true
	place_here
	if [ -x "$PEER_CLIENT" ] && [ -n "$(peer_list)" ]; then
		sync_peers "$HOST: $PLACE_NAME on $words (install now)" ||
			info "The Macs not reached get it when they are back."
	fi
}

# Installs or removes the placed package on this Mac, as its lists now say.
place_here() {
	local key id
	key=$(printf '%s "%s"' "$PLACE_KIND" "$PLACE_NAME")
	id=$(printf '%s' "$PLACE_LINE" | sed -nE 's/.*id: *([0-9]+).*/\1/p')
	ADD_MAS_ID=$id
	ADD_MAS_ID=$id
	if host_entries "$HOST" | grep -qxF "$key"; then
		add_installed "$PLACE_KIND" "$PLACE_NAME" && return 0
		info "Installing $PLACE_NAME here …"
		case $PLACE_KIND in
		cask) brew install --cask "$PLACE_NAME" ;;
		mas) mas install "$id" ;;
		tap) brew tap "$PLACE_NAME" ;;
		*) brew install "$PLACE_NAME" ;;
		esac || info "Could not install $PLACE_NAME here; bier status shows it."
	elif add_installed "$PLACE_KIND" "$PLACE_NAME"; then
		info "Removing $PLACE_NAME here …"
		case $PLACE_KIND in
		cask) brew uninstall --cask "$PLACE_NAME" ;;
		brew) brew uninstall "$PLACE_NAME" ;;
		*) info "Remove $PLACE_NAME by hand; bier does not uninstall a $PLACE_KIND." ;;
		esac || info "Could not remove $PLACE_NAME here; bier status shows it."
	fi
}

# The Brewfile line for a name: as the lists have it, else as Homebrew or
# the App Store know it. Sets PLACE_KIND, PLACE_NAME, PLACE_LINE.
place_line() {
	local name=$1 line store
	line=$({ grep -hE "^[[:space:]]*($KINDS)[[:space:]]+\"$(rx_quote "$name")\"" "$BREW_DIR"/* 2>/dev/null || true; } |
		head -1 | sed -E 's/^[[:space:]]+//; s/[[:space:]]*#.*$//')
	if [ -n "$line" ]; then
		PLACE_KIND=${line%% *}
		PLACE_NAME=$name
		PLACE_LINE=$line
	elif PLACE_KIND=$(add_kind "$name") && [ "$PLACE_KIND" != mas ]; then
		PLACE_NAME=$name
		PLACE_LINE=$(printf '%s "%s"' "$PLACE_KIND" "$name")
	elif store=$(mas_lookup "$name"); then
		PLACE_KIND=mas
		PLACE_NAME=${store#*$'\t'}
		PLACE_LINE=$(printf 'mas "%s", id: %s' "$PLACE_NAME" "${store%%$'\t'*}")
	else
		return 1
	fi
}

# Brings this Mac in line with its lists: installs what is missing,
# removes what was taken off. --received does so only when a change
# marked "install now" came in since last time, and this Mac applies
# changes (bier config apply automatic, the default).
cmd_apply() {
	need_brew
	need_repo
	# Every Mac, not only this one: a change of nothing, marked install
	# now, that each Mac applies as it arrives -- the way to have
	# software installed on another Mac from here, when the lists already
	# name it and only the Mac has not caught up.
	if [ "${1:-}" = --everywhere ]; then
		git -C "$DATA" commit -q --allow-empty -m "$HOST: bring every Mac in line (install now)"
		git -C "$DATA" rev-parse HEAD >"$STATE_DIR/applied" 2>/dev/null || true
		if [ -x "$PEER_CLIENT" ] && [ -n "$(peer_list)" ]; then
			sync_peers "$HOST: bring every Mac in line (install now)" ||
				info "The Macs not reached do it when they are back."
		fi
		set --
	fi
	local mark=$STATE_DIR/applied head since
	head=$(git -C "$DATA" rev-parse HEAD 2>/dev/null) || return 0
	mkdir -p "$STATE_DIR"
	since=$(cat "$mark" 2>/dev/null || true)
	printf '%s\n' "$head" >"$mark"
	if [ "${1:-}" = --received ]; then
		[ -n "$since" ] || return 0
		local group was
		group=$(host_group "$HOST")
		was=$(cat "$STATE_DIR/group" 2>/dev/null || true)
		printf '%s\n' "$group" >"$STATE_DIR/group"
		# A move to another group is applied like a change marked
		# install now: the Mac takes on its new group's rules.
		if [ "$group" = "$was" ]; then
			git -C "$DATA" log --format=%s "$since..$head" 2>/dev/null | grep -q '(install now)$' || return 0
		fi
		if [ "$(apply_mode)" = ask ]; then
			info "Changes came in to install; this Mac asks first: bier apply"
			return 0
		fi
	fi
	(cmd_install) || info "Not everything could be installed; bier status shows what is missing."
	(cmd_prune --yes) || info "Not everything could be removed; bier status shows what is left."
}

# The rules in effect here: the group's, else this Mac's config.
apply_mode() {
	local rule
	rule=$(group_rule "$(host_group "$HOST")" apply)
	printf '%s' "${rule:-$APPLY_MODE}"
}

inventory_mode() {
	local rule
	rule=$(group_rule "$(host_group "$HOST")" inventory)
	printf '%s' "${rule:-$INVENTORY_MODE}"
}

# Takes back one change: a new commit that undoes it, passed on like any
# other. A change marked install now is undone the same way -- the Macs
# remove what it installed. One that later changes build on is refused
# rather than half undone.
cmd_undo() {
	need_repo
	[ $# -eq 1 ] || die "usage: bier undo <commit>   (bier report or git log name them)"
	local commit subject mark=""
	commit=$(git -C "$DATA" rev-parse --verify --quiet "$1^{commit}") || die "no change called $1"
	subject=$(git -C "$DATA" log -1 --format=%s "$commit")
	git -C "$DATA" diff --quiet HEAD -- Brewfiles groups Safe 2>/dev/null ||
		die "there are changes not saved yet; bier sync first"
	case $subject in *"(install now)") mark=" (install now)" ;; esac
	if ! git -C "$DATA" revert --no-commit "$commit" >/dev/null 2>&1; then
		git -C "$DATA" revert --abort >/dev/null 2>&1 || true
		die "later changes build on \"$subject\"; it cannot be taken back on its own"
	fi
	publish "$HOST: undo \"${subject% (install now)}\"$mark"
	if [ -n "$mark" ]; then
		git -C "$DATA" rev-parse HEAD >"$STATE_DIR/applied" 2>/dev/null || true
		(cmd_apply) || true
	fi
	if [ -x "$PEER_CLIENT" ] && [ -n "$(peer_list)" ]; then
		sync_peers "$HOST: undo" || info "The Macs not reached take it on when they are back."
	fi
}

# What Homebrew and the App Store have by that name, for Bierkasten:
#   FOUND <kind> <name> <on a list: yes|no>
cmd_search() {
	need_brew
	[ $# -eq 1 ] || die "usage: bier search <name>"
	local listed n
	listed=$(all_entries)
	{
		# Nothing found is no error: grep's 1 must not end the search.
		{ brew search --cask "$1" 2>/dev/null || true; } | { grep -v '^==>' || true; } | head -25 | sed 's/^/cask /'
		{ brew search --formula "$1" 2>/dev/null || true; } | { grep -v '^==>' || true; } | head -25 | sed 's/^/brew /'
		! command -v mas >/dev/null 2>&1 || { mas search "$1" 2>/dev/null || true; } | head -10 |
			awk '{ $1 = ""; sub(/^ +/, ""); sub(/ +\(.*$/, ""); print "mas " $0 }'
	} | while read -r kind n; do
		[ -n "$n" ] || continue
		if printf '%s\n' "$listed" | grep -qxF "$kind \"$n\""; then
			printf 'FOUND\t%s\t%s\tyes\n' "$kind" "$n"
		else
			printf 'FOUND\t%s\t%s\tno\n' "$kind" "$n"
		fi
	done
}

# Shares an installed app's settings and profiles, without asking: with
# every Mac, or --for a group or a single Mac. Paths that hold keys or
# passwords stay out, as with bier add.
cmd_share() {
	need_repo
	need_gpg
	local scope="" name kind
	if [ "${1:-}" = --for ]; then
		scope=${2:-}
		group_list | grep -qxF "$scope" || die "--for which group? see: bier group"
		shift 2
	fi
	[ $# -eq 1 ] || die "usage: bier share [--for <group>] <app>"
	name=$1
	kind=$(kind_of "$name")
	[ -n "$kind" ] || die "$name is neither installed here nor on a list"
	add_installed "$kind" "$name" || die "$name is not installed on $HOST; its settings are read from here"
	ADD_SCOPE=$scope
	ADD_MAS_ID=""
	[ "$kind" != mas ] || ADD_MAS_ID=$(mas_lookup "$name" | cut -f1)
	add_settings "$kind" "$name" all
	publish "$HOST: shared $name's settings${scope:+ with $scope}"
}

# The app a cask installs, as a path.
add_app_path() {
	local app dir
	app=$(brew info --cask --json=v2 "$1" 2>/dev/null |
		grep -oE '"[^"/]+\.app"' | head -1 | tr -d '"')
	[ -n "$app" ] || return 1
	for dir in "${BIER_APPS_DIR:-/Applications}" "$HOME/Applications"; do
		[ -d "$dir/$app" ] || continue
		printf '%s' "$dir/$app"
		return 0
	done
	return 1
}

# Never offered on its own: what holds keys, passwords or accounts. VPN
# clients and password managers keep them in their settings; sharing
# them should be a decision, taken with bier vault add by hand.
add_secret_path() {
	case $1 in
	*/.ssh | */.ssh/* | */.gnupg | */.gnupg/* | */Keychains/* | *.keychain* | \
		*[Cc]redential* | *[Tt]oken* | *[Pp]assword* | *[Ss]ecret* | *.pem | *.key | *.p12) return 0 ;;
	esac
	return 1
}

add_secret_app() {
	case $1 in
	io.tailscale.* | com.wireguard.* | net.tunnelblick.* | com.bitwarden.* | com.1password.* | \
		com.agilebits.* | org.keepassxc.* | com.nordvpn.* | com.expressvpn.* | ch.protonvpn.* | \
		me.proton.pass.*) return 0 ;;
	esac
	return 1
}

# Homebrew's zap list names what a cask leaves outside /Applications --
# kept by hand for thousands of apps. What of it is not a setting (caches,
# logs, web data, window state, recent files) is left out; a sandbox
# container is looked into for its preferences and Application Support.
add_zap_settings() {
	local path dir
	brew info --cask --json=v2 "$1" 2>/dev/null | grep -oE '"~/[^"*]+"' | tr -d '"' |
		sed "s#^~#$HOME#" | sort -u | while IFS= read -r path; do
		case $path in
		*/Caches | */Caches/* | */Logs | */Logs/* | */HTTPStorages* | */WebKit | */WebKit/* | \
			*"/Saved Application State"* | */Cookies* | *com.apple.sharedfilelist* | \
			*"/Application Scripts"* | */LaunchAgents/* | *.savedState) continue ;;
		"$HOME"/Library/Containers/*/*) printf '%s\n' "$path" ;;
		"$HOME"/Library/Containers/*)
			printf '%s\n' "$path/Data/Library/Preferences/${path##*/}.plist"
			for dir in "$path/Data/Library/Application Support"/*; do
				[ ! -d "$dir" ] || printf '%s\n' "$dir"
			done
			;;
		*) printf '%s\n' "$path" ;;
		esac
	done
}

# Where an app keeps its settings, as far as the usual places go: its
# container, Application Support, Preferences -- or ~/.config/<name> for
# a command-line tool. Only what exists here is offered.
add_settings() {
	local kind=$1 name=$2 choice=$3 app="" id="" label c found="" path n picks i
	if [ "$kind" = cask ] || [ "$kind" = mas ]; then
		if [ "$kind" = cask ]; then
			app=$(add_app_path "$name") || return 0
		else
			app=$(mas_app_path "$ADD_MAS_ID" "$name") || return 0
		fi
		id=$(plutil -extract CFBundleIdentifier raw -o - "$app/Contents/Info.plist" 2>/dev/null) || return 0
		label=$(basename "$app" .app)
		if add_secret_app "$id"; then
			info ""
			info "$label holds keys, passwords or accounts; bier does not offer"
			info "its settings. If you are sure: bier vault add --app $label <path>"
			return 0
		fi
		c=$HOME/Library/Containers/$id/Data/Library
		if [ -d "$HOME/Library/Containers/$id" ] && ! ls "$c" >/dev/null 2>&1; then
			info ""
			info "macOS did not let bier look into $label's settings. Allow your"
			info "terminal Full Disk Access (System Settings > Privacy & Security),"
			info "then: bier add --settings $name"
			return 0
		fi
		for path in "$c/Application Support/$label" "$c/Preferences/$id.plist" \
			"$HOME/Library/Application Support/$label" "$HOME/Library/Application Support/$id" \
			"$HOME/Library/Preferences/$id.plist"; do
			[ -e "$path" ] && found="$found$path
"
		done
		[ "$kind" != cask ] || while IFS= read -r path; do
			[ -n "$path" ] && [ -e "$path" ] && found="$found$path
"
		done <<EOF
$(add_zap_settings "$name")
EOF
	else
		label=$name
		[ ! -d "$HOME/.config/$name" ] || found="$HOME/.config/$name
"
	fi
	found=$(printf '%s' "$found" | grep -v '^$' | awk '!seen[$0]++' || true)
	local kept="" secret=0
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		if add_secret_path "$path"; then
			secret=$((secret + 1))
		else
			kept="$kept$path
"
		fi
	done <<EOF
$found
EOF
	found=$(printf '%s' "$kept" | grep -v '^$' || true)
	[ "$secret" = 0 ] || info "Left out $(count_word "$secret") that may hold keys or passwords."
	[ -n "$found" ] || return 0
	# What is shared already is not offered again.
	local shared="" fresh=""
	while IFS= read -r path; do
		if cat "$VAULT"/apps/*/.bier-map "$VAULT"/@*/apps/*/.bier-map 2>/dev/null |
			cut -f2 | grep -qxF "${path#"$HOME"/}"; then
			shared="$shared ${path##*/}"
		else
			fresh="$fresh$path
"
		fi
	done <<EOF
$found
EOF
	found=$(printf '%s' "$fresh" | grep -v '^$' || true)
	if [ -z "$found" ]; then
		info "$label's settings are shared already."
		return 0
	fi

	info ""
	info "$label keeps its settings here:"
	n=0
	while IFS= read -r path; do
		n=$((n + 1))
		printf '  %2s  %s   %s\n' "$n" "${path#"$HOME"/}" "$(du -sh "$path" 2>/dev/null | cut -f1 | tr -d ' ')"
		case $path in
		*/Preferences/*.plist) info "      settings; also window positions and recent files" ;;
		esac
	done <<EOF
$found
EOF
	case $choice in
	all) picks=all ;;
	none) return 0 ;;
	*)
		printf 'Share them with your other Macs?  numbers, a = all, empty = none: '
		read -r picks || picks=""
		;;
	esac
	case $picks in
	"") return 0 ;;
	a | A | all) picks=$(seq 1 "$n" | tr '\n' ' ') ;;
	esac
	for i in $picks; do
		path=$(printf '%s\n' "$found" | sed -n "${i}p")
		[ -n "$path" ] || die "no settings location with number $i"
		vault_add_app "$label" "$path" "$ADD_SCOPE" "$(printf '%s "%s"' "$kind" "$name")"
	done
	info "bier sync shares them."
}

# Uninstalls packages here and decides, per package, which lists lose it.
# Removal becomes an action instead of something guessed from a dump.
#
#   --everywhere          off every list, All Macs and every group
#   --from-main [--keep a,b]
#                         off All Macs; only the groups named keep it
#   --group <g>           off one group's list
#   --here                off what this Mac recorded and nobody assigned
#
# Without one of them it asks. Nobody at the keyboard to ask means it
# stops before changing anything: taking something off every Mac is not
# a default to fall back on.
cmd_uninstall() {
	need_brew
	need_repo
	local mode="" keep="" keep_given=no group=""
	while [ $# -gt 0 ]; do
		case $1 in
		--everywhere) mode=everywhere ;;
		--from-main | --from-all) mode=main ;;
		--here) mode=here ;;
		--group)
			[ $# -ge 2 ] || die "--group which?"
			group_list | grep -qxF "$2" || die "there is no group $2; see: bier group"
			mode=group
			group=$2
			shift
			;;
		--keep)
			[ $# -ge 2 ] || die "--keep needs the groups that keep it: --keep laptops,studio"
			keep=$(printf '%s' "$2" | tr ',' ' ')
			keep_given=yes
			shift
			;;
		--) shift; break ;;
		-*) die "unknown option: $1" ;;
		*) break ;;
		esac
		shift
	done
	[ $# -ge 1 ] || die "usage: bier uninstall [--everywhere | --from-main [--keep <group>,…] | --group <g> | --here] <package>…"
	[ "$keep_given" = no ] || [ "$mode" = main ] || die "--keep only goes with --from-main"

	local name kind key line how hosts h keepers done_any=no removed=""
	# With the answer given up front, every package is checked before the
	# first one is touched.
	if [ -n "$mode" ]; then
		for name in "$@"; do
			kind=$(kind_of "$name")
			[ -n "$kind" ] || die "$name is neither installed here nor in the Brewfiles"
			case $mode in
			here) listed_in "$kind" "$name" | grep -qxF "$HOST" ||
				die "$name is given to All Macs or a group, not only recorded here -- take it off there:
     bier uninstall --from-main [--keep <group>,…] | --group <g> $name" ;;
			main) in_main "$kind" "$name" || die "$name is not for All Macs" ;;
			group) listed_in "$kind" "$name" | grep -qxF "@$group" || die "$name is not given to $group" ;;
			esac
		done
	fi
	for name in "$@"; do
		kind=$(kind_of "$name")
		[ -n "$kind" ] || die "$name is neither installed here nor in the Brewfiles"
		key=$(printf '%s "%s"' "$kind" "$name")
		line=$(find_line "$key" || true)
		[ -n "$line" ] || line=$key
		hosts=$(listed_in "$kind" "$name")

		how=$mode
		keepers=$keep
		if [ -z "$how" ]; then
			uninstall_ask "$key" "$hosts"
			how=$UNINSTALL_HOW
			keepers=$UNINSTALL_KEEP
			[ "$how" != group ] || group=$UNINSTALL_GROUP
		fi
		for h in $keepers; do
			group_list | grep -qxF "${h#@}" || die "not a group: $h"
		done
		case $how in
		cancel)
			info "$name: nothing changed"
			continue
			;;
		here)
			listed_in "$kind" "$name" | grep -qxF "$HOST" ||
				die "$name is given to All Macs or a group -- take it off there:
     bier uninstall --from-main [--keep <group>,…] | --group <g> $name"
			;;
		main)
			in_main "$kind" "$name" || die "$name is not for All Macs"
			;;
		esac

		info "$name ($kind)"
		# A Mac that keeps it keeps it installed, this one included: through
		# a group that keeps it, or when only another group loses it.
		if [ "$how" = main ] && printf '%s\n' $keepers | sed 's/^@//' | grep -qxF "$(host_group "$HOST")"; then
			info "  stays installed here"
		elif [ "$how" = group ] && { [ "$(host_group "$HOST")" != "$group" ] || in_main "$kind" "$name"; }; then
			info "  stays installed here"
		elif ! uninstall_one "$kind" "$name"; then
			info "  stays in the Brewfiles as long as it is installed"
			continue
		fi

		case $how in
		everywhere) strip_entry "$kind" "$name" ;;
		here) strip_entry_in "$BREW_DIR/$HOST" "$kind" "$name" ;;
		group) strip_entry_in "$BREW_DIR/@$group" "$kind" "$name" ;;
		main)
			strip_entry "$kind" "$name"
			for h in $keepers; do
				printf '%s\n' "$line" >>"$BREW_DIR/@${h#@}"
			done
			;;
		esac
		done_any=yes
		removed="$removed $name"
	done

	if [ "$done_any" = no ]; then
		info "Nothing removed."
		return 0
	fi
	record_after_removal
	publish "$HOST: removed${removed}"
}

# The lists that name the entry, main first.
listed_in() {
	local kind=$1 name=$2 rx f
	rx="^[[:space:]]*$(rx_quote "$kind")[[:space:]]+\"([^\"]*/)?$(rx_quote "$name")\""
	[ ! -f "$MAIN_FILE" ] || ! grep -qE "$rx" "$MAIN_FILE" || echo main
	for f in "$BREW_DIR"/*; do
		[ -f "$f" ] && [ "$f" != "$MAIN_FILE" ] || continue
		! grep -qE "$rx" "$f" || basename "$f"
	done
}

in_main() {
	listed_in "$1" "$2" | grep -qx main
}

# Asks what an uninstall should take off. Sets UNINSTALL_HOW (everywhere,
# main, here or cancel) and UNINSTALL_KEEP.
uninstall_ask() {
	local key=$1 hosts=$2 answer others h picks i
	UNINSTALL_HOW=cancel
	UNINSTALL_KEEP=""
	UNINSTALL_GROUP=""
	info ""
	if [ -n "$hosts" ]; then
		info "$key is listed in: $(printf '%s ' $hosts | sed 's/ $//' | sed 's/ /, /g')"
	else
		info "$key is on no list."
	fi
	info "What should happen?"
	info "  [a] everywhere     uninstall here, take it off every list;"
	info "                     the other Macs offer bier prune"
	if printf '%s\n' $hosts | grep -qx main; then
		info "  [m] off All Macs   uninstall here, take it off All Macs;"
		info "                     you pick the groups that keep it"
	fi
	if [ -n "$(host_group "$HOST")" ] && printf '%s\n' $hosts | grep -qxF "@$(host_group "$HOST")"; then
		info "  [g] off $(host_group "$HOST")       uninstall here, take it off this Mac's group"
	fi
	if printf '%s\n' $hosts | grep -qxF "$HOST"; then
		info "  [h] only here      uninstall here; it was only recorded here"
	fi
	info "  [c] cancel"
	printf 'Choice: '
	read -r answer ||
		die "nobody to ask. Say what to do:
     bier uninstall --everywhere | --from-main [--keep <group>,…] | --group <g> | --here <package>"
	case $answer in
	a | A) UNINSTALL_HOW=everywhere ;;
	m | M)
		printf '%s\n' $hosts | grep -qx main || return 0
		UNINSTALL_HOW=main
		others=$(group_list)
		info "Which groups keep it? Numbers or names, separated by spaces; empty for none."
		i=0
		for h in $others; do
			i=$((i + 1))
			printf '  %2s  %s\n' "$i" "$h"
		done
		printf 'Keep on: '
		read -r picks || picks=""
		for h in $picks; do
			case $h in
			*[!0-9]*) UNINSTALL_KEEP="$UNINSTALL_KEEP $h" ;;
			*)
				h=$(printf '%s\n' $others | sed -n "${h}p")
				[ -n "$h" ] || die "no group with that number"
				UNINSTALL_KEEP="$UNINSTALL_KEEP $h"
				;;
			esac
		done
		;;
	g | G)
		printf '%s\n' $hosts | grep -qxF "@$(host_group "$HOST")" || return 0
		UNINSTALL_HOW=group
		UNINSTALL_GROUP=$(host_group "$HOST")
		;;
	h | H)
		printf '%s\n' $hosts | grep -qxF "$HOST" || return 0
		UNINSTALL_HOW=here
		;;
	esac
	return 0
}

# After a removal the device list here has to match what is installed.
# In manual mode the lists are written by hand, and a dump would pour
# the whole inventory into them.
record_after_removal() {
	[ "$INVENTORY_MODE" != automatic ] || cmd_dump
}

# Removes what is still installed here but was deleted on another device.
# The git history is what tells that apart from a new addition.
cmd_prune() {
	need_brew
	need_repo
	# --yes answers up front: Bierkasten asks in its own window.
	local yes=no
	[ "${1:-}" != --yes ] || yes=yes

	local tmp stale entry kind name
	tmp=$(tmpfile)
	brew bundle dump --force --file "$tmp" >/dev/null

	stale=$(classify_add "$(comm -23 <(entries "$tmp") <(own_entries) || true)" |
		sed -nE 's/^(STALE|DROPPED)'$'\t''//p')
	if [ -z "$stale" ]; then
		info "Nothing stale: nothing is installed here that was removed elsewhere."
		return 0
	fi

	info "Removed elsewhere or taken out of main, still installed here:"
	printf '%s\n' "$stale" | sed 's/^/  /'
	if [ "$yes" = yes ]; then
		answer=y
	else
		printf 'Uninstall? [y/N] '
		read -r answer || answer=""
	fi
	case $answer in
	j | J | y | Y) ;;
	*)
		info "Cancelled."
		return 0
		;;
	esac

	# Taps last: brew refuses to untap while something from the tap is
	# still installed.
	local ordered
	ordered=$({ printf '%s\n' "$stale" | grep -v '^tap ' || true
		printf '%s\n' "$stale" | grep '^tap ' || true; })

	printf '%s\n' "$ordered" | while IFS= read -r entry; do
		[ -n "$entry" ] || continue
		kind=${entry%% *}
		name=$(printf '%s' "$entry" | sed -E 's/^[a-z]+ "([^"]+)"$/\1/')
		info ""
		info "-> $kind $name"
		uninstall_one "$kind" "$name" || info "  failed, stays for now"
	done

	record_after_removal
	publish "$HOST: removed packages deleted elsewhere"

	# Whatever survived the uninstall has to stay visible.
	local rest
	rest=$(cmd_state | sed -nE 's/^(STALE|DROPPED)'$'\t''//p' || true)
	if [ -n "$rest" ]; then
		info ""
		info "Not removed and still reported:"
		printf '%s\n' "$rest" | sed 's/^/  ~ /'
	fi
}

# Overview of all devices. Belongs in the terminal, not in the menu bar:
# with ten Macs it would be a wall up there.
cmd_list() {
	need_repo
	local apps h text=""

	# Collect first, print in one go: whoever pipes this into head must
	# not see a broken pipe halfway through.
	local -a parts=()
	apps=$(list_app_settings)
	parts+=("$(list_section "All Macs" "$MAIN_FILE" "$apps")")
	for h in $(group_list); do
		parts+=("$(list_section "Group $h ($(group_members "$h" | sed 's/ /, /g'))" "$BREW_DIR/@$h" "$apps")")
	done
	parts+=("$(list_section "Not assigned, installed on $HOST (this Mac)" "$BREW_DIR/$HOST" "$apps")")
	for h in $(host_list); do
		[ "$h" != "$HOST" ] || continue
		parts+=("$(list_section "Not assigned, installed on $h" "$BREW_DIR/$h" "$apps")")
	done
	parts+=("$(list_files)" "$(list_loose_settings "$apps")")
	for h in "${parts[@]}"; do
		[ -z "$h" ] || text=${text:+$text$'\n\n'}$h
	done
	printf '%s\n' "${text:-Nothing is listed yet.}"
}

# An app's shared settings, one line each: package|app|what|scope.
# The package is what bier add wrote into the app's map; older maps
# have none.
list_app_settings() {
	local map app scope package what
	for map in "$VAULT"/apps/*/.bier-map "$VAULT"/@*/apps/*/.bier-map; do
		[ -f "$map" ] || continue
		app=$(basename "$(dirname "$map")")
		scope=${map#"$VAULT"/}
		case $scope in
		@*) scope=${scope%%/*} ;;
		*) scope="" ;;
		esac
		package=$(awk -F '\t' '$1 == ".package" { print $2; exit }' "$map")
		what=$(awk -F '\t' '$1 != ".package" && NF == 2 { print $1 }' "$map" | paste -sd ',' - | sed 's/,/, /g')
		[ -z "$what" ] || printf '%s|%s|%s|%s\n' "$package" "$app" "$what" "${scope#@}"
	done
}

# The settings shared for one Brewfile entry: by the package the map
# names, or else by name -- handbrake-app belongs to HandBrake.
list_settings_for() {
	local key=$1 name=$2 apps=$3
	printf '%s\n' "$apps" | awk -F '|' -v key="$key" -v name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" '
		NF < 3 { next }
		{ app = tolower($2) }
		$1 == key || ($1 == "" && (app == name || index(name, app "-") == 1)) {
			print $3 ($4 != "" ? " (only " $4 ")" : ""); exit
		}'
}

list_section() {
	local title=$1 file=$2 apps=$3 entry kind name what label
	[ -n "$(entries "$file")" ] || return 0
	printf '%s\n' "$title"
	entries "$file" | while IFS= read -r entry; do
		kind=${entry%% *}
		name=$(printf '%s' "$entry" | sed -E 's/^[a-z]+ "([^"]+)"$/\1/')
		case $kind in
		brew) label=formula ;;
		cask) label=app ;;
		mas) label="App Store" ;;
		vscode) label="VS Code" ;;
		*) label=$kind ;;
		esac
		what=$(list_settings_for "$entry" "$name" "$apps")
		if [ -n "$what" ]; then
			printf '  %-32s %-10s settings: %s\n' "$name" "$label" "$what"
		else
			printf '  %-32s %s\n' "$name" "$label"
		fi
	done
}

# Dotfiles and folders shared by path, outside any app.
list_files() {
	local rel folder scope out
	out=$(
		{
			[ ! -d "$VAULT" ] || find "$VAULT" -name .bier-folder -print |
				sed -e "s#^$VAULT/##" -e 's#/\.bier-folder$##' | while IFS= read -r folder; do
				[[ $(vault_strip_scope "$folder") != apps/* ]] || continue
				printf '%s/\n' "$(vault_target "$folder")"
			done
			vault_own_files | while IFS= read -r rel; do
				[[ $(vault_strip_scope "$rel") != apps/* ]] || continue
				folder=$rel
				while [ "$folder" != "${folder%/*}" ]; do
					folder=${folder%/*}
					[ ! -f "$VAULT/$folder/.bier-folder" ] || continue 2
				done
				scope=$(vault_scope "$rel")
				printf '%s%s\n' "$(vault_target "$rel")" "${scope:+ (only $scope)}"
			done
		} | sed "s#^$HOME/#~/#" | sort -u
	)
	[ -n "$out" ] || return 0
	printf 'Files\n'
	printf '%s\n' "$out" | sed 's/^/  /'
}

# Settings of an app that is on no list: added by hand, or the app left.
list_loose_settings() {
	local apps=$1 line package app what scope listed out=""
	listed=$(all_entries)
	while IFS='|' read -r package app what scope; do
		[ -n "$app" ] || continue
		if [ -n "$package" ] && printf '%s\n' "$listed" | grep -qxF "$package"; then
			continue
		fi
		if [ -z "$package" ] && printf '%s\n' "$listed" | awk -v app="$(printf '%s' "$app" | tr '[:upper:]' '[:lower:]')" '
			{ n = tolower($0); sub(/^[a-z]+ "/, "", n); sub(/"$/, "", n) }
			n == app || index(n, app "-") == 1 { f = 1 } END { exit !f }'; then
			continue
		fi
		out="$out$(printf '  %-32s settings: %s%s' "$app" "$what" "${scope:+ (only $scope)}")
"
	done <<EOF
$apps
EOF
	[ -n "$out" ] || return 0
	printf 'Settings of apps on no list\n%s' "$out"
}

# What the next "bier sync" would carry, as tab-separated lines. Only
# what this Mac knows: nothing is asked over the network.
#
#   SEND        <peer> <n|never>  own commits that peer has not had yet
#   UNCOMMITTED <path>            a Brewfile changed and not committed
#   VAULT_OUT   <file> <how>      new, changed or deleted here; goes out
#   VAULT_IN    <file> <how>      new, changed, deleted or forgotten
#                                 elsewhere; the sync applies it
#   VAULT_WAIT  <file> <app>      incoming, but the app is running
#   VAULT_BOTH  <file>            changed here and in the safe
#   VAULT_LARGE <file>            larger than vault_max_file, not taken
#   VAULT_DENIED <file>           macOS does not let bier read it
#   VAULT_LEFT  <path>            a .from-safe copy from a conflict
sync_report() {
	local peer sent n
	if [ -x "$PEER_CLIENT" ]; then
		for peer in $(peer_list); do
			sent=$(peer_sent_get "$peer")
			if [ -z "$sent" ]; then
				printf 'SEND\t%s\tnever\n' "$peer"
				continue
			fi
			# Commits that arrived from other Macs are theirs to hand on;
			# counting them would name every peer behind after each
			# delivery. bier's own commit messages start with the host.
			n=$(git -C "$DATA" log --format=%s "$sent..HEAD" 2>/dev/null | grep -c "^$HOST:" || true)
			[ "${n:-0}" = 0 ] || printf 'SEND\t%s\t%s\n' "$peer" "$n"
		done
	fi
	git -C "$DATA" status --porcelain --untracked-files=all -- Brewfiles 2>/dev/null |
		sed -E 's/^.{3}/UNCOMMITTED'$'\t''/'
	vault_report
}

# What the safe brought that is not in place here yet, and conflict
# copies waiting to be merged -- worked out from the safe and the
# agreed state alone. The menu bar runs this in the background, where it
# must not read other apps' settings (macOS would refuse it anyway).
vault_arrived() {
	local rel in target copy
	VAULT_QUICK=yes vault_known | while IFS= read -r rel; do
		vault_wanted "$rel" || continue
		vault_is_meta "$rel" && continue
		target=$(vault_target "$rel")
		in=$(vault_incoming "$rel")
		[ -z "$in" ] || printf 'VAULT_IN\t%s\t%s\n' "$target" "$in"
		for copy in "$target.from-safe" "$target.from-safe."*; do
			[ ! -e "$copy" ] || printf 'VAULT_LEFT\t%s\n' "$copy"
		done
	done | awk '!seen[$0]++'
}

vault_report() {
	local rel out in label target copy app
	vault_known | while IFS= read -r rel; do
		vault_wanted "$rel" || continue
		out=$(vault_outgoing "$rel")
		in=$(vault_incoming "$rel")
		if vault_is_meta "$rel"; then
			# A folder's marker says nothing a person needs to read.
			case $rel in */.bier-folder) continue ;; esac
			label=$rel
		else
			label=$(vault_target "$rel")
		fi
		if [ "$out" = denied ]; then
			printf 'VAULT_DENIED\t%s\n' "$label"
			continue
		elif [ "$out" = busy ]; then
			printf 'VAULT_WAIT\t%s\t%s\n' "$label" "$(vault_busy "$label")"
			continue
		elif [ "$out" = both ] || { [ -n "$out" ] && [ "$out" != large ] && [ -n "$in" ]; }; then
			printf 'VAULT_BOTH\t%s\n' "$label"
		elif [ "$out" = large ]; then
			printf 'VAULT_LARGE\t%s\n' "$label"
		elif [ -n "$out" ]; then
			printf 'VAULT_OUT\t%s\t%s\n' "$label" "$out"
		elif [ -n "$in" ]; then
			if [ "$in" != forgotten ] && ! vault_is_meta "$rel" && app=$(vault_busy "$label"); then
				printf 'VAULT_WAIT\t%s\t%s\n' "$label" "$app"
			else
				printf 'VAULT_IN\t%s\t%s\n' "$label" "$in"
			fi
		fi
		vault_is_meta "$rel" && continue
		target=$(vault_target "$rel")
		for copy in "$target.from-safe" "$target.from-safe."*; do
			[ ! -e "$copy" ] || printf 'VAULT_LEFT\t%s\n' "$copy"
		done
	done | awk '!seen[$0]++'
}

cmd_status() {
	need_brew
	need_repo

	local pending
	pending=$(sync_report)
	if [ -n "$pending" ]; then
		info "Sync (bier sync):"
		printf '%s\n' "$pending" | awk -F '\t' '
			$1 == "SEND" && $3 == "never" { printf "  -> to %-14s never synced\n", $2; next }
			$1 == "SEND"        { printf "  -> to %-14s %s commit(s) from here not sent yet\n", $2, $3; next }
			$1 == "UNCOMMITTED" { printf "  ^  Brewfiles        %s changed, not committed\n", $2; next }
			$1 == "VAULT_OUT" && $3 == "new"     { printf "  ^  vault            %s new here\n", $2; next }
			$1 == "VAULT_OUT" && $3 == "deleted" { printf "  ^  vault            %s deleted here\n", $2; next }
			$1 == "VAULT_OUT"   { printf "  ^  vault            %s changed here\n", $2; next }
			$1 == "VAULT_IN" && $3 == "new"       { printf "  v  vault            %s new from another Mac\n", $2; next }
			$1 == "VAULT_IN" && $3 == "deleted"   { printf "  v  vault            %s deleted on another Mac, goes to the Trash\n", $2; next }
			$1 == "VAULT_IN" && $3 == "check"     { printf "  v  vault            %s to be compared with the safe\n", $2; next }
			$1 == "VAULT_IN" && $3 == "forgotten" { printf "  v  vault            %s no longer synced, stays here\n", $2; next }
			$1 == "VAULT_IN"    { printf "  v  vault            %s newer in the safe\n", $2; next }
			$1 == "VAULT_WAIT"  { printf "  .  vault            %s waiting: %s is running\n", $2, $3; next }
			$1 == "VAULT_DENIED" { printf "  !  vault            %s no access -- see: bier access\n", $2; next }
			$1 == "VAULT_LARGE" { printf "  !  vault            %s not taken: larger than vault_max_file\n", $2; next }
			$1 == "VAULT_BOTH"  { printf "  !  vault            %s changed here and in the safe\n", $2; next }
			$1 == "VAULT_LEFT"  { printf "  !  vault            %s left from a conflict: merge it, then delete it\n", $2; next }'
		info ""
	fi

	# Say it here as well. Aborting only at install time would mean the
	# line sits in the file for weeks without anybody being told.
	local f bad
	for f in "$MAIN_FILE" "$HOST_FILE"; do
		bad=$(foreign_lines "$f")
		[ -z "$bad" ] || {
			info "WARNING  $f holds lines that are not entries:"
			printf '%s\n' "$bad" | sed 's/^/           /'
			info "         brew would run them. bier install refuses until they are gone."
			info ""
		}
	done

	local tmp
	tmp=$(tmpfile)
	brew bundle dump --force --file "$tmp"

	local drift_add drift_gone
	drift_add=$(comm -23 <(entries "$tmp") <(own_entries) || true)
	drift_gone=$(comm -13 <(entries "$tmp") <(own_entries) || true)

	local fresh stale dropped classes
	classes=$(classify_add "$drift_add")
	fresh=$(printf '%s\n' "$classes" | sed -n 's/^NEW'$'\t''//p')
	stale=$(printf '%s\n' "$classes" | sed -n 's/^STALE'$'\t''//p')
	dropped=$(printf '%s\n' "$classes" | sed -n 's/^DROPPED'$'\t''//p')

	if [ -z "$drift_add" ] && [ -z "$drift_gone" ]; then
		info "$HOST: Brewfile matches the system."
	else
		if [ -n "$fresh" ]; then
			if [ "$INVENTORY_MODE" = automatic ]; then
				info "Installed on $HOST but not recorded (bier sync):"
			else
				info "Installed on $HOST, not in your Brewfiles (bier sync --record):"
			fi
			printf '%s\n' "$fresh" | sed 's/^/  + /'
		fi
		if [ -n "$stale" ]; then
			info "Removed on another device, still here (bier prune):"
			printf '%s\n' "$stale" | sed 's/^/  ~ /'
		fi
		if [ -n "$dropped" ]; then
			info "No longer in main, still here (bier prune, or bier place to keep it):"
			printf '%s\n' "$dropped" | sed 's/^/  ~ /'
		fi
		if [ -n "$drift_gone" ]; then
			info "Recorded but not installed on $HOST (bier install):"
			printf '%s\n' "$drift_gone" | sed 's/^/  - /'
		fi
	fi

	info ""
	info "Git:"
	git -C "$DATA" status --short --branch | sed 's/^/  /'
}

cmd_diff() {
	need_repo
	local others
	if [ $# -gt 0 ]; then
		others=$*
	else
		others=$(host_list | grep -v "^$HOST$" || true)
	fi
	[ -n "$others" ] || die "no other device found in Brewfiles/"

	for other in $others; do
		local other_file=$BREW_DIR/$other
		[ -f "$other_file" ] || die "Brewfiles/$other is missing"

		info "== $HOST  vs.  $other =="
		local only_here only_there
		only_here=$(comm -23 <(own_entries) <(host_entries "$other") || true)
		only_there=$(comm -13 <(own_entries) <(host_entries "$other") || true)

		if [ -z "$only_here" ] && [ -z "$only_there" ]; then
			info "  identical"
		else
			if [ -n "$only_here" ]; then
				printf '%s\n' "$only_here" | sed "s/^/  only $HOST:  /"
			fi
			if [ -n "$only_there" ]; then
				printf '%s\n' "$only_there" | sed "s/^/  only $other:  /"
			fi
		fi
		info ""
	done
}

cmd_install() {
	need_brew
	need_repo
	# Both before either: finding the second one poisoned after the
	# first has already been installed would be half a rescue.
	local g files=("$MAIN_FILE" "$HOST_FILE") f
	g=$(host_group "$HOST")
	[ -z "$g" ] || files+=("$BREW_DIR/@$g")
	for f in "${files[@]}"; do verify_brewfile "$f"; done
	for f in "${files[@]}"; do
		[ ! -f "$f" ] || brew bundle install --file "$f"
	done
	info "The inventory of $HOST is installed."
}

# Syncs the Brewfiles with the legacy private server: record what is pending,
# push what is ours, fetch what is theirs. Not a command of its own —
# publish fetches before every push anyway, and update needs it here.
sync_data() {
	local msg=${1:-"$HOST: inventory updated"}
	if ! git -C "$DATA" remote get-url origin >/dev/null 2>&1; then
		publish "$msg"
		return 0
	fi

	# Safe as well as Brewfiles. A run in which only a vault file
	# changed would otherwise fall through here and never be committed
	# at all -- which is exactly what happened the first time.
	if [ -n "$(git -C "$DATA" status --porcelain -- Brewfiles Safe)" ]; then
		publish "$msg"
		return 0
	fi

	local before after outgoing incoming
	before=$(git -C "$DATA" rev-parse HEAD)
	fetch_rebase
	after=$(git -C "$DATA" rev-parse HEAD)

	outgoing=$(git -C "$DATA" log --oneline '@{u}..HEAD' 2>/dev/null || true)
	if [ -n "$outgoing" ]; then
		git -C "$DATA" push --quiet
		info "Pushed our own inventory changes."
	fi

	if [ "$before" != "$after" ]; then
		incoming=$(git -C "$DATA" diff --stat "$before..$after" -- Brewfiles 2>/dev/null || true)
		if [ -n "$incoming" ]; then
			info "New inventory from the other Mac:"
			printf '%s\n' "$incoming" | sed 's/^/  /'
		fi
	fi
}

sync_peers() {
	local msg=$1 peer peers
	git -C "$DATA" add Brewfiles
	[ ! -f "$GROUPS_FILE" ] || git -C "$DATA" add groups
	[ ! -d "$SAFE_DIR" ] || git -C "$DATA" add Safe
	if git -C "$DATA" diff --cached --quiet; then
		info "Nothing to commit."
	else
		git -C "$DATA" commit -q -m "$msg"
		info "Commit: $msg"
	fi
	peers=$(peer_list)
	[ -n "$peers" ] || die "no Bier peers are configured"
	# First collect every peer's history. A second pass distributes the
	# resulting common head to peers visited before the final merge.
	# A Mac that is away (asleep, off Tailscale) must not keep the others
	# from syncing: it is named at the end and caught up next time.
	local away=""
	for peer in $peers; do (cmd_peer_sync "$peer") || away="$away $peer"; done
	for peer in $peers; do
		case " $away " in *" $peer "*) continue ;; esac
		(cmd_peer_sync "$peer") || away="$away $peer"
	done
	peer_introduce_all
	if [ -n "$away" ]; then
		info "Not reached this time:$away -- they catch up on the next sync."
		return 1
	fi
	info "In sync with Bier peers."
}

# The newest release published on the code server, without the leading
# "v". Empty when nobody has tagged one — which is the normal state of a
# server that is only ever pushed to, such as the private one during
# development.
latest_release() {
	git -C "$ROOT" tag -l 'v*' --sort=-v:refname 2>/dev/null | head -1 | sed 's/^v//'
}

# Is $2 a higher version than $1? "sort -V" is what gets 0.9.1 < 0.11.0
# right; comparing the strings would call 0.9.1 the newer one.
newer_version() {
	[ "$1" != "$2" ] &&
		[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]
}

# Looks whether a newer version of the program exists. Returning 0 means:
# there is something that wants building.
check_code() {
	need_code
	git -C "$ROOT" fetch --tags --quiet 2>/dev/null ||
		die "code server unreachable — is the network plugged in?"

	UPGRADE_TAG=""

	# A tagged server publishes releases, and then the version decides.
	local release
	release=$(latest_release)
	if [ -n "$release" ]; then
		if ! newer_version "$BIER_VERSION" "$release"; then
			info "Program is up to date: $BIER_VERSION"
			return 1
		fi
		UPGRADE_TAG="v$release"
		info ""
		info "bier $release is out — this one is $BIER_VERSION."
		return 0
	fi

	# No release anywhere: that is a working copy which is pushed to
	# rather than released from, so follow the branch as before.
	local here there count
	here=$(git -C "$ROOT" rev-parse HEAD)
	there=$(git -C "$ROOT" rev-parse '@{u}' 2>/dev/null || true)
	if [ -z "$there" ]; then
		info "The code branch has no counterpart on the server."
		return 1
	fi
	if [ "$here" = "$there" ]; then
		# The version first, because that is the number anyone compares
		# against. The commit follows because without a release it is the
		# only thing that tells two builds of one version apart.
		info "Program is up to date: $BIER_VERSION ($(git -C "$ROOT" rev-parse --short HEAD))"
		return 1
	fi

	count=$(git -C "$ROOT" log --oneline "$here..$there" | wc -l | tr -d ' ')
	info ""
	if [ "$count" = "1" ]; then
		info "1 new commit to the program:"
	else
		info "$count new commits to the program:"
	fi
	git -C "$ROOT" log --oneline "$here..$there" | sed 's/^/  /'
	return 0
}

# --- The vault ---------------------------------------------------------
#
# Files that are not Brewfiles: dotfiles, notes, whatever belongs on
# every Mac. They are encrypted symmetrically with one passphrase that
# every Mac knows, so a new Mac needs nothing but that passphrase --
# no key to carry over, nobody else's machine to ask.
#
# Brewfiles stay readable. Encrypting them was tried and measured: a
# union merge glues two ciphertexts together and the file is quietly
# ruined, and "removed elsewhere" stops working because it searches the
# history for the entry.

need_gpg() {
	command -v gpg >/dev/null 2>&1 ||
		die "gpg is missing, and the vault is encrypted with it.
     Install it:  brew install gnupg"
}

# The passphrase. It lives in this Mac's own keychain, not in iCloud:
# a working copy, not a place to keep it. BIER_VAULT_PASS overrides it
# for tests and for anyone scripting this.
vault_pass() {
	if [ -n "${BIER_VAULT_PASS:-}" ]; then
		printf '%s' "$BIER_VAULT_PASS"
		return 0
	fi
	local pass status=0 why
	why=$(tmpfile)
	pass=$(security find-generic-password -s bier-vault -a vault -w 2>"$why") || status=$?
	if [ "$status" = 36 ] && [ "${1:-}" != --no-unlock ] && keychain_unlock; then
		status=0
		pass=$(security find-generic-password -s bier-vault -a vault -w 2>"$why") || status=$?
	fi
	# 44 is "no such item". Anything else means the passphrase is there
	# but locked away -- over SSH, typically. Reporting that as "no
	# passphrase yet" sent people to set a new one.
	case $status in
	0) printf '%s' "$pass"; return 0 ;;
	44) return 0 ;;
	esac
	[ "${1:-}" != --no-unlock ] || return 1
	die "the keychain holds the vault passphrase but would not hand it out:
     $(cat "$why")

     Unlock the login keychain and try again:
       security unlock-keychain ~/Library/Keychains/login.keychain-db"
}

# Over SSH the login keychain stays locked, and security answers every
# request with status 36, "User interaction is not allowed". That is
# what kept the passphrase out of the keychain during installation.
# With somebody at the terminal, unlocking it is one password away.
keychain_unlock() {
	[ -t 0 ] || [ -n "${BIER_TEST_TTY:-}" ] || return 1
	info "The login keychain is locked, as it usually is over SSH." >&2
	info "Unlock it with your macOS login password (not the vault passphrase):" >&2
	security unlock-keychain "$HOME/Library/Keychains/login.keychain-db"
}

# Whether this Mac remembers a passphrase, without stopping when the
# keychain is locked: "known", "missing" or "locked".
vault_pass_state() {
	if [ -n "${BIER_VAULT_PASS:-}" ]; then
		echo known
		return 0
	fi
	local status=0
	security find-generic-password -s bier-vault -a vault >/dev/null 2>&1 || status=$?
	if [ "$status" != 0 ]; then
		echo missing
	elif vault_pass --no-unlock >/dev/null 2>&1; then
		echo known
	else
		echo locked
	fi
}

vault_pass_store() {
	[ -z "${BIER_VAULT_PASS:-}" ] || return 0
	local why status=0
	# Say what security said. Swallowing it left "could not write the
	# passphrase to the keychain" and no way to find out why.
	why=$(security add-generic-password -s bier-vault -a vault -w "$1" -U 2>&1) || status=$?
	if [ "$status" = 36 ] && keychain_unlock; then
		status=0
		why=$(security add-generic-password -s bier-vault -a vault -w "$1" -U 2>&1) || status=$?
	fi
	[ "$status" = 0 ] ||
		die "the keychain would not take the passphrase:
     $why

     A locked or missing login keychain is the usual reason. Unlock it
     with 'security unlock-keychain ~/Library/Keychains/login.keychain-db',
     or work without it for now by putting the passphrase in
     BIER_VAULT_PASS."
}

vault_encrypt() {
	printf '%s' "$2" | gpg --batch --yes --quiet --passphrase-fd 0 \
		--pinentry-mode loopback -c --cipher-algo AES256 -o "$3" "$1"
}

vault_decrypt() {
	printf '%s' "$2" | gpg --batch --yes --quiet --passphrase-fd 0 \
		--pinentry-mode loopback -d -o "$3" "$1" 2>/dev/null
}

# Does this passphrase open what is already there? An empty safe cannot
# say, and then anything is as good as anything else.
vault_pass_works() {
	local f probe
	# Any file will do, also one in a folder or the groups list.
	f=$(find "$SAFE_DIR" -name '*.gpg' -type f -print -quit 2>/dev/null)
	[ -n "$f" ] || return 0
	probe=$(tmpfile)
	vault_decrypt "$f" "$1" "$probe"
}

# Asks and hands back what was typed. Never echoes it.
#
# The prompt goes to stderr, and that is not cosmetic: this runs inside
# $(...), so anything written to stdout ends up inside the passphrase.
# It did. What was stored was "Passphrase: " with the answer glued
# behind it -- consistent enough to look like it worked, and wrong
# enough that gpg by hand could never have opened the file.
vault_ask() {
	local pass
	printf '%s' "$1" >&2
	read -rs pass || pass=""
	printf '\n' >&2
	[ -n "$pass" ] || die "no passphrase given"
	printf '%s' "$pass"
}

# Twice, whenever there is nothing to check the answer against. A typo
# in the first passphrase of an empty vault encrypts everything with
# something nobody will ever type again, and nothing would notice.
vault_ask_twice() {
	local first second
	first=$(vault_ask "$1")
	second=$(vault_ask "Again: ")
	[ "$first" = "$second" ] ||
		die "the two do not match — nothing has been changed"
	printf '%s' "$first"
}

# ~/.config/nvim/init.lua  <->  dot_config/nvim/init.lua
#
# The name carries the destination, so there is no list to keep in step
# with reality -- the idea is chezmoi's and it is a good one.
vault_name() {
	printf '%s' "${1#"$HOME"/}" | sed -e 's#^\.#dot_#' -e 's#/\.#/dot_#g'
}

# An app's settings sit in the vault under apps/<App>/<what>, whatever
# long path they have on the Mac; apps/<App>/.bier-map says where each
# <what> belongs, relative to the home folder. Everything else mirrors
# its path below the home folder.
vault_target() {
	local rel=$1 bare app rest entry mapped
	bare=$(vault_strip_scope "$rel")
	case $bare in
	apps/*/*)
		app=${bare#apps/}
		app=${app%%/*}
		rest=${bare#apps/"$app"/}
		entry=${rest%%/*}
		if [ "$entry" = "$rest" ]; then rest=""; else rest=${rest#"$entry"}; fi
		mapped=$(awk -F '\t' -v e="$entry" '$1 == e { print $2; exit }' \
			"$VAULT/${rel%"$bare"}apps/$app/.bier-map" 2>/dev/null || true)
		if [ -n "$mapped" ]; then
			printf '%s/%s%s' "$HOME" "$mapped" "$(printf '%s' "$rest" | sed -e 's#/dot_#/.#g')"
			return 0
		fi
		;;
	esac
	printf '%s/%s' "$HOME" \
		"$(printf '%s' "$bare" | sed -e 's#^dot_#.#' -e 's#/dot_#/.#g')"
}

# A path in the vault may start with a scope: @laptops/dot_zshrc goes to
# the Macs in that group, @mini/dot_zshrc only to that one. A device name
# is simply a group of one, so there is nothing extra to declare for it.
#
# Anything whose name begins with a dot is bier's own -- .groups is not
# a file anybody asked to have in their home.
vault_scope() {
	case $1 in
	@*/*) printf '%s' "${1%%/*}" | cut -c2- ;;
	*) printf '' ;;
	esac
}

vault_strip_scope() {
	case $1 in
	@*/*) printf '%s' "${1#*/}" ;;
	*) printf '%s' "$1" ;;
	esac
}

vault_is_meta() {
	# bier's own files in the vault: .groups, and the README that
	# install.sh leaves there. Without the second one it would travel
	# like any other file and turn up as ~/README.txt on every Mac.
	case $1 in
	README.txt) return 0 ;;
	esac
	case $(basename "$1") in
	.*) return 0 ;;
	esac
	case $1 in
	.*) return 0 ;;
	esac
	return 1
}

# Groups. Every Mac is in exactly one; a Mac in none is new, until it is
# moved. Everything is given to All Macs or to a group -- software in
# Brewfiles/@<group>, files in the vault under @<group>/, rules as
# <group>.<rule> = <value> in the groups file. A Mac has All Macs plus
# its group, and when it moves, it takes on the new group's rules.
groups_source() {
	if [ -f "$GROUPS_FILE" ]; then
		printf '%s' "$GROUPS_FILE"
	elif [ -f "$VAULT/.groups" ]; then
		# Before the groups file: the vault's list, read as it was.
		printf '%s' "$VAULT/.groups"
	fi
}

group_members() {
	local f
	f=$(groups_source)
	[ -n "$f" ] || return 0
	sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$f" | tail -1
}

group_list() {
	local f
	f=$(groups_source)
	[ -n "$f" ] || return 0
	sed -nE 's/^[[:space:]]*([A-Za-z0-9_-]+)[[:space:]]*=.*/\1/p' "$f" | awk '!seen[$0]++'
}

# A group's rule: apply (automatic|ask) or inventory (automatic|manual).
group_rule() {
	[ -n "$1" ] && [ -f "$GROUPS_FILE" ] || return 0
	sed -nE "s/^[[:space:]]*$1\.$2[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$GROUPS_FILE" | tail -1
}

# The group a Mac is in; nothing for a new one.
host_group() {
	local g
	for g in $(group_list); do
		if printf '%s\n' $(group_members "$g") | grep -qxF "$1"; then
			printf '%s\n' "$g"
			return 0
		fi
	done
}

# Sets one line of the groups file: "<key> = <value>", replacing it.
groups_set() {
	local key=$1 value=$2 tmp
	[ -f "$GROUPS_FILE" ] || printf '# bier groups: <group> = <macs>, <group>.<rule> = <value>\n' >"$GROUPS_FILE"
	tmp=$(tmpfile)
	awk -v key="$key" -v value="$value" '
		{ k = $0; sub(/^[[:space:]]*/, "", k); sub(/[[:space:]]*=.*$/, "", k) }
		k == key && index($0, "=") { if (!done) print key " = " value; done = 1; next }
		{ print }
		END { if (!done) print key " = " value }' "$GROUPS_FILE" >"$tmp"
	mv "$tmp" "$GROUPS_FILE"
}

# Takes a Mac out of whatever group it is in. A group left with no Mac,
# no software and no rules is gone with it: nobody made it to keep.
groups_take_out() {
	local g rest
	for g in $(group_list); do
		printf '%s\n' $(group_members "$g") | grep -qxF "$1" || continue
		# Its last member leaving: grep finds nothing, which is no error.
		rest=$(printf '%s\n' $(group_members "$g") | { grep -vxF "$1" || true; } | tr '\n' ' ')
		rest=${rest% }
		if [ -z "$rest" ] && [ -z "$(entries "$BREW_DIR/@$g")" ] &&
			! grep -qE "^[[:space:]]*$g\.[a-z]+[[:space:]]*=" "$GROUPS_FILE" 2>/dev/null; then
			sed -i '' -E "/^[[:space:]]*$g[[:space:]]*=/d" "$GROUPS_FILE"
			rm -f "$BREW_DIR/@$g"
		else
			groups_set "$g" "$rest"
		fi
	done
}

# Once, when bier first keeps groups: the vault's groups come along, and
# every Mac with a list of its own gets a group of its own, holding that
# list -- nothing is lost, and merging groups is then a matter of moving.
groups_migrate() {
	[ -n "$DATA" ] && [ -d "$BREW_DIR" ] && [ ! -f "$GROUPS_FILE" ] || return 0
	# Only a fleet from before groups: one that has software for All Macs
	# and never had a groups file. A freshly installed Mac has neither
	# yet -- it gets the fleet's groups when it pairs, and making itself
	# a group of its own first left a stray group behind.
	[ -n "$(entries "$MAIN_FILE")" ] || return 0
	[ -z "$(git -C "$DATA" log --all --oneline -1 -- groups 2>/dev/null)" ] || return 0
	local h line
	# Data repositories set up before groups lack the merge rule: two
	# Macs creating the file at once would stop at a conflict.
	grep -qx 'groups merge=union' "$DATA/.gitattributes" 2>/dev/null ||
		printf '\ngroups merge=union\n' >>"$DATA/.gitattributes"
	git -C "$DATA" add .gitattributes 2>/dev/null || true
	printf '# bier groups: <group> = <macs>, <group>.<rule> = <value>\n' >"$GROUPS_FILE"
	if [ -f "$VAULT/.groups" ]; then
		grep -E '^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*=' "$VAULT/.groups" >>"$GROUPS_FILE" || true
	fi
	for h in $(host_list); do
		[ -n "$(host_group "$h")" ] || groups_set "$h" "$h"
		[ -n "$(entries "$BREW_DIR/$h")" ] || continue
		grep -E "^[[:space:]]*($KINDS)[[:space:]]+\"" "$BREW_DIR/$h" >>"$BREW_DIR/@$(host_group "$h")" || true
		line=$(tmpfile)
		grep -vE "^[[:space:]]*($KINDS)[[:space:]]+\"" "$BREW_DIR/$h" >"$line" || true
		mv "$line" "$BREW_DIR/$h"
	done
	info "Groups: every Mac is in one now; each list became its Mac's group."
}

# Does this Mac get the file?
vault_wanted() {
	local scope=$(vault_scope "$1") m
	[ -n "$scope" ] || return 0
	[ "$scope" != "$HOST" ] || return 0
	for m in $(group_members "$scope"); do
		[ "$m" != "$HOST" ] || return 0
	done
	return 1
}

cmd_group() {
	need_repo
	groups_migrate
	local name=${1:-} mac g rest
	[ $# -eq 0 ] || shift
	case $name in
	"")
		if [ -z "$(group_list)" ]; then
			info "No groups yet: everything goes to every Mac."
			info "  bier group <name> <mac>…"
		fi
		for g in $(group_list); do
			if printf '%s\n' $(group_members "$g") | grep -qxF "$HOST"; then
				info "  $g = $(group_members "$g")   (this Mac)"
			else
				info "  $g = $(group_members "$g")"
			fi
			for rest in apply inventory; do
				[ -z "$(group_rule "$g" "$rest")" ] || info "      $rest = $(group_rule "$g" "$rest")"
			done
		done
		rest=$(for mac in $(host_list); do [ -n "$(host_group "$mac")" ] || printf '%s ' "$mac"; done)
		[ -z "$rest" ] || info "  new (in no group yet) = ${rest% }"
		return 0
		;;
	move)
		[ $# -eq 2 ] || die "usage: bier group move <mac> <group>"
		group_list | grep -qxF "$2" || die "there is no group $2; make it with: bier group $2 $1"
		groups_take_out "$1"
		local members
		members=$(group_members "$2")
		groups_set "$2" "${members:+$members }$1"
		group_publish "$HOST: $1 moved to $2"
		return 0
		;;
	rule)
		[ $# -eq 3 ] || die "usage: bier group rule <group> apply automatic|ask | inventory automatic|manual"
		group_list | grep -qxF "$1" || die "there is no group $1"
		case $2=$3 in
		apply=automatic | apply=ask | inventory=automatic | inventory=manual) ;;
		*) die "usage: bier group rule <group> apply automatic|ask | inventory automatic|manual" ;;
		esac
		groups_set "$1.$2" "$3"
		group_publish "$HOST: $1 sets $2 = $3"
		return 0
		;;
	--drop)
		[ $# -eq 1 ] || die "which group? bier group --drop laptops"
		group_list | grep -qxF "$1" || die "there is no group $1"
		sed -i '' -E "/^[[:space:]]*$1(\.[a-z]+)?[[:space:]]*=/d" "$GROUPS_FILE"
		rm -f "$BREW_DIR/@$1"
		group_publish "$HOST: group $1 dropped; its Macs are new"
		return 0
		;;
	-*) die "usage: bier group [<group> <mac>… | move <mac> <group> | rule … | --drop <group>]" ;;
	esac
	printf '%s' "$name" | grep -Eq '^[A-Za-z0-9_-]+$' || die "a group's name is letters, digits, - and _"
	case $name in new | main | all) die "$name is taken; call the group something else" ;; esac
	[ $# -gt 0 ] || die "which Macs? bier group $name mini macbook"
	# Exactly these Macs: taken out of their groups, and the group's
	# former members that are not named become new.
	for g in $(group_members "$name"); do groups_take_out "$g"; done
	for mac in "$@"; do
		peer_name_ok "$mac" || die "$mac is not a Mac's name"
		groups_take_out "$mac"
	done
	groups_set "$name" "$*"
	group_publish "$HOST: group $name = $*"
}

# A change of groups goes out at once, and each Mac it concerns takes on
# its group's rules as it arrives -- this one right away.
group_publish() {
	[ ! -d "$VAULT" ] || [ ! -f "$VAULT/.groups" ] || cp "$GROUPS_FILE" "$VAULT/.groups"
	publish "$1"
	if [ -x "$PEER_CLIENT" ] && [ -n "$(peer_list)" ]; then
		sync_peers "$1" || info "The Macs not reached take it on when they are back."
	fi
	(cmd_apply --received) || true
}

# --- Copy mode --------------------------------------------------------------
#
# Every file stays a real file where it belongs. The vault holds a copy,
# the safe the encrypted version, and $STATE_DIR/vault-base what this Mac
# and the safe last agreed on. Links used to stand in for the files;
# sandboxed apps would not follow them, apps that save atomically replaced
# them, and removing bier's folder would have taken the files along.
#
# A tracked folder is marked by <folder>/.bier-folder in the vault and in
# the safe. Files put in it later come along with the next sync, files
# deleted from it go to the Trash on the other Macs.

# Left out of a tracked folder: noise that changes all the time and is
# no setting of anybody's. $1 is the path inside the folder.
vault_excluded() {
	local pattern
	case ${1##*/} in
	.DS_Store | *.lock | *.log | *[Ll]og.txt | .bier-folder) return 0 ;;
	# bier's own copies: a conflict's other side, a replaced file.
	*.from-safe | *.from-safe.[0-9]* | *.backup | *.backup.[0-9]* | *.bier-new) return 0 ;;
	# What holds keys or passwords travels only when added by itself.
	*[Tt]oken* | *[Pp]assword* | *[Ss]ecret* | *[Cc]redential* | *.pem | *.key | *.p12 | *.keychain*) return 0 ;;
	esac
	case "/$1" in
	*/*[Cc]ache*/* | */*CACHE*/* | */[Ll]ogs/* | */.git/*) return 0 ;;
	esac
	# More of an app's own noise, from the config: vault_exclude =
	# *.hbqueue Recent*
	for pattern in $(config_get vault_exclude); do
		# shellcheck disable=SC2254
		case ${1##*/} in
		$pattern) return 0 ;;
		esac
	done
	return 1
}

vault_max_bytes() {
	local v=${BIER_VAULT_MAX_FILE:-$(config_get vault_max_file)}
	v=${v:-10M}
	case $v in
	*[0-9][Kk]) printf '%s' $((${v%?} * 1024)) ;;
	*[0-9][Mm]) printf '%s' $((${v%?} * 1048576)) ;;
	*[0-9][Gg]) printf '%s' $((${v%?} * 1073741824)) ;;
	*[!0-9]* | "") die "vault_max_file must be a size such as 10M, not '$v'" ;;
	*) printf '%s' "$v" ;;
	esac
}

# Every version of every file stays in the history on every Mac, and
# encrypted files do not compress against each other. The vault is for
# settings, not for documents.
vault_too_large() {
	[ "$(stat -f %z "$1")" -gt "$(vault_max_bytes)" ]
}

# A copy of a file about to be overwritten or taken in, unless the config
# says vault_backup = no.
vault_backup() {
	local src=$1 rel dest
	[ -f "$src" ] || return 0
	case $(config_get vault_backup) in
	no | off | false) return 0 ;;
	esac
	case $src in
	"$HOME"/*) rel=${src#"$HOME"/} ;;
	*) rel=${src#/} ;;
	esac
	dest=$STATE_DIR/backups/$(date +%Y-%m-%d)/$rel
	[ ! -e "$dest" ] || dest=$dest.$(date +%H%M%S)
	mkdir -p "$(dirname "$dest")"
	cp -p "$src" "$dest"
}

# A conflict left the safe's version next to this Mac's file. mine keeps
# this Mac's, and the next sync shares it; theirs puts the safe's in its
# place. The one not kept goes to the Trash either way.
vault_resolve() {
	local copy=${1/#\~/$HOME} which=$2 target
	case $copy in
	*.from-safe) target=${copy%.from-safe} ;;
	*.from-safe.[0-9]*) target=${copy%.from-safe.*} ;;
	*) die "$1 is not a conflict copy (…from-safe)" ;;
	esac
	[ -f "$copy" ] || die "$1 is not there"
	case $which in
	mine)
		vault_trash "$copy"
		info "Kept this Mac's $target; the next sync shares it."
		;;
	theirs)
		[ ! -e "$target" ] || vault_trash "$target"
		mv "$copy" "$target"
		info "Took the other Mac's $target; yours is in the Trash."
		;;
	*) die "mine or theirs?" ;;
	esac
}

# Into the Trash, where Finder's "Put Back" can undo it.
vault_trash() {
	local src=$1 dest n=2
	if [ -n "${BIER_TRASH_DIR:-}" ]; then
		mkdir -p "$BIER_TRASH_DIR"
		dest=$BIER_TRASH_DIR/$(basename "$src")
	elif [ -x /usr/bin/trash ] && /usr/bin/trash "$src" >/dev/null 2>&1; then
		return 0
	else
		mkdir -p "$HOME/.Trash"
		dest=$HOME/.Trash/$(basename "$src")
	fi
	while [ -e "$dest" ]; do
		dest=${dest%.[0-9]*}.$n
		n=$((n + 1))
	done
	mv "$src" "$dest"
}

# The app a path belongs to, printed when that app is running. An app
# writes its settings back when it quits, over whatever bier put there.
vault_busy() {
	local p=$1 id="" name=""
	case $p in
	"$HOME"/Library/Containers/*)
		id=${p#"$HOME"/Library/Containers/}
		id=${id%%/*}
		;;
	"$HOME"/Library/Preferences/*.plist) id=$(basename "$p" .plist) ;;
	"$HOME/Library/Application Support/"*)
		name=${p#"$HOME/Library/Application Support/"}
		name=${name%%/*}
		;;
	*) return 1 ;;
	esac
	if [ -n "${BIER_TEST_RUNNING+set}" ]; then
		[ -n "$BIER_TEST_RUNNING" ] || return 1
		[ "$BIER_TEST_RUNNING" = "$id" ] || [ "$BIER_TEST_RUNNING" = "$name" ] || return 1
	elif [ -n "$id" ]; then
		[ -n "$(lsappinfo find bundleid="$id" 2>/dev/null)" ] || return 1
	else
		pgrep -x "$name" >/dev/null 2>&1 || return 1
	fi
	printf '%s' "$id$name"
}

# A sandboxed app's container is made by macOS when the app first
# starts; one made by hand lacks what macOS keeps in it. So the app is
# started once, hidden, and quit again as soon as its container is
# there -- its settings are only written while it is not running.
VAULT_STARTED=""
vault_container_ready() {
	local target=$1 id i=0
	case $target in
	"$HOME"/Library/Containers/*) ;;
	*) return 0 ;;
	esac
	id=${target#"$HOME"/Library/Containers/}
	id=${id%%/*}
	[ ! -d "$HOME/Library/Containers/$id/Data" ] || return 0
	case " $VAULT_STARTED " in
	*" $id "*) return 1 ;;
	esac
	VAULT_STARTED="$VAULT_STARTED $id"
	if ! open -g -j -b "$id" >/dev/null 2>&1; then
		info "waiting: $id is not installed here; its settings follow once it is"
		return 1
	fi
	info "started $id once, hidden, so that macOS sets up its container"
	while [ ! -d "$HOME/Library/Containers/$id/Data" ] && [ "$i" -lt 60 ]; do
		sleep 0.5
		i=$((i + 1))
	done
	osascript -e "tell application id \"$id\" to quit" >/dev/null 2>&1 || true
	i=0
	while vault_busy "$HOME/Library/Containers/$id/x" >/dev/null && [ "$i" -lt 40 ]; do
		sleep 0.5
		i=$((i + 1))
	done
	if [ ! -d "$HOME/Library/Containers/$id/Data" ]; then
		info "waiting: $id did not set up its container; start it once by hand"
		return 1
	fi
}

# A file from the safe into its place. Written next to it and moved over,
# so nothing reads half a file; preference files go through cfprefsd,
# which would otherwise keep serving what it has cached.
vault_put() {
	local plain=$1 target=$2 mode=""
	mkdir -p "$(dirname "$target")"
	case $target in
	"$HOME"/Library/Preferences/*.plist | "$HOME"/Library/Containers/*/Data/Library/Preferences/*.plist)
		# Given as a path, defaults reaches a sandboxed app's own
		# preferences in its container too.
		if [ -z "${BIER_TEST_RUNNING+set}" ]; then
			defaults import "${target%.plist}" "$plain" && return 0
		fi
		;;
	esac
	[ ! -f "$target" ] || mode=$(stat -f %Lp "$target")
	cp "$plain" "$target.bier-new"
	[ -z "$mode" ] || chmod "$mode" "$target.bier-new"
	mv "$target.bier-new" "$target"
}

# What an app's settings location is called in the vault.
vault_app_label() {
	case $1 in
	*/Library/Preferences/*.plist) printf 'Preferences.plist' ;;
	*/Library/Application\ Support/*) printf 'Application Support' ;;
	*/.config/*) printf 'config' ;;
	*) basename "$1" ;;
	esac
}

# Takes an app's settings in, under apps/<App>/ in the vault.
vault_add_app() {
	local app=$1 src=${2%/} scope=${3:-} package=${4:-} label base map n=2 current
	case $src in
	"$HOME"/*) ;;
	*) die "only files below $HOME can go into the vault: $src" ;;
	esac
	[ -e "$src" ] || die "$src does not exist"
	[ ! -L "$src" ] || die "$src is a link -- add what it points to"
	case $app in
	"" | */* | .*) die "not an app name: $app" ;;
	esac
	base=apps/$app
	[ -z "$scope" ] || base=@$scope/$base
	map=$VAULT/$base/.bier-map
	vault_shared_already "$src"
	label=$(vault_app_label "$src")
	while awk -F '\t' -v e="$label" '$1 == e { f = 1 } END { exit !f }' "$map" 2>/dev/null; do
		label="$(vault_app_label "$src") $n"
		n=$((n + 1))
	done
	mkdir -p "$VAULT/$base"
	# Which Brewfile entry the settings belong to, for bier list.
	if [ -n "$package" ] && ! grep -q '^\.package'$'\t' "$map" 2>/dev/null; then
		printf '.package\t%s\n' "$package" >>"$map"
	fi
	printf '%s\t%s\n' "$label" "${src#"$HOME"/}" >>"$map"
	if [ -d "$src" ]; then
		mkdir -p "$VAULT/$base/$label"
		: >"$VAULT/$base/$label/.bier-folder"
		rm -f "$SAFE_DIR/$base/$label/.bier-folder.forgotten"
	else
		! vault_too_large "$src" ||
			die "$src is larger than vault_max_file. The vault is for settings,
     not for documents: every version stays in the history on every Mac."
		cp -p "$src" "$VAULT/$base/$label"
		rm -f "$SAFE_DIR/$base/$label.forgotten"
	fi
	info "$base/$label   <-  $src"
}

# Takes a file or a folder in. The original stays where it is; the vault
# gets a copy.
vault_add() {
	local src=${1%/} scope=${2:-} name dest f inner taken=0 large=""
	case $src in
	"$HOME"/*) ;;
	*) die "only files below $HOME can go into the vault: $src" ;;
	esac
	case $src/ in
	"$VAULT"/* | "$DATA"/* | "$STATE_DIR"/*) die "$src is bier's own" ;;
	esac
	[ -e "$src" ] || die "$src does not exist"
	[ ! -L "$src" ] || die "$src is a link -- add what it points to"

	vault_shared_already "$src"
	name=$(vault_name "$src")
	[ -z "$scope" ] || name=@$scope/$name
	if [ -d "$src" ]; then
		[ ! -e "$VAULT/$name/.bier-folder" ] || die "$name is already in the vault"
		mkdir -p "$VAULT/$name"
		: >"$VAULT/$name/.bier-folder"
		rm -f "$SAFE_DIR/$name/.bier-folder.forgotten"
		while IFS= read -r f; do
			inner=${f#"$src"/}
			vault_excluded "$inner" && continue
			if vault_too_large "$f"; then
				large="$large
  $f"
				continue
			fi
			taken=$((taken + 1))
		done <<EOF
$(find "$src" -type f -print)
EOF
		info "$name/   <-  $src"
		info "  $(count_word "$taken") now, and whatever is put in it later"
		[ -z "$large" ] || info "  not taken, larger than vault_max_file:$large"
		return 0
	fi
	[ -f "$src" ] || die "$src is neither a file nor a folder"
	dest=$VAULT/$name
	[ ! -e "$dest" ] || die "$name is already in the vault"
	! vault_too_large "$src" ||
		die "$src is larger than vault_max_file. The vault is for settings,
     not for documents: every version stays in the history on every Mac."
	vault_backup "$src"
	mkdir -p "$(dirname "$dest")"
	cp -p "$src" "$dest"
	rm -f "$SAFE_DIR/$name.forgotten"
	info "$name   <-  $src"
}

# Two entries for one file would each take and put it, against each
# other. A path is shared once: by itself, inside a shared folder, or as
# an app's settings -- for all Macs or for some.
vault_shared_already() {
	local path=${1%/} map rel entry target
	for map in "$VAULT"/apps/*/.bier-map "$VAULT"/@*/apps/*/.bier-map; do
		[ -f "$map" ] || continue
		while IFS=$'\t' read -r entry target; do
			[ "$entry" != .package ] && [ -n "$target" ] || continue
			case $path/ in
			"$HOME/$target"/* | "$HOME/$target"/)
				die "$path is shared already, as $(dirname "${map#"$VAULT"/}")/$entry" ;;
			esac
			case $HOME/$target/ in
			"$path"/*) die "$path holds $HOME/$target, shared already as $(dirname "${map#"$VAULT"/}")/$entry" ;;
			esac
		done <"$map"
	done
	while IFS= read -r rel; do
		[ -n "$rel" ] || continue
		vault_is_meta "$rel" && continue
		target=$(vault_target "$rel")
		case $path/ in
		"$target"/*) die "$path is shared already, as $rel" ;;
		esac
		case $target/ in
		"$path"/*) die "$path holds $target, shared already as $rel" ;;
		esac
	done <<EOF
$(find "$VAULT" -name .bier-folder -print 2>/dev/null | sed -e "s#^$VAULT/##" -e 's#/\.bier-folder$##'; vault_own_files)
EOF
	return 0
}

# The entries a path names: the file itself, or everything in a folder
# and its marker. Scoped entries (@group/...) are found as well.
vault_entries_for() {
	local path=${1%/} rel
	vault_known | while IFS= read -r rel; do
		case $(vault_target "$rel") in
		"$path" | "$path"/*) printf '%s\n' "$rel" ;;
		esac
	done
}

# Stops syncing it; the file stays on every Mac. The .forgotten marker
# tells the other Macs to stop too instead of moving it to the Trash.
vault_forget() {
	local src=$1 rel n=0
	while IFS= read -r rel; do
		[ -n "$rel" ] || continue
		rm -f "$VAULT/$rel" "$SAFE_DIR/$rel.gpg"
		mkdir -p "$(dirname "$SAFE_DIR/$rel")"
		: >"$SAFE_DIR/$rel.forgotten"
		vault_base_del "$rel"
		n=$((n + 1))
	done <<EOF
$(vault_entries_for "$src")
EOF
	[ "$n" -gt 0 ] || die "$src is not in the vault"
	find "$VAULT" -mindepth 1 -type d -empty -delete 2>/dev/null || true
	info "$src is no longer synced; it stays where it is, here and on the other Macs"
}

# Gone everywhere: here it goes to the Trash, and the other Macs move
# theirs there at their next sync. Asks first.
vault_drop() {
	local src=${1%/} rel answer
	[ -n "$(vault_entries_for "$src")" ] || die "$src is not in the vault"
	info "This removes $src everywhere: here and on every other Mac at its"
	info "next sync, into the Trash. git history keeps the encrypted copies."
	printf 'Remove it? [y/N] '
	read -r answer || answer=""
	case $answer in
	j | J | y | Y) ;;
	*)
		info "Cancelled."
		return 0
		;;
	esac
	while IFS= read -r rel; do
		[ -n "$rel" ] || continue
		rm -f "$VAULT/$rel" "$SAFE_DIR/$rel.gpg"
		vault_base_del "$rel"
	done <<EOF
$(vault_entries_for "$src")
EOF
	find "$VAULT" -mindepth 1 -type d -empty -delete 2>/dev/null || true
	[ ! -e "$src" ] || vault_trash "$src"
	info "$src is gone, into the Trash."
}

# Next to the data, not only in a manual that may not be there any more.
vault_recovery_note() {
	cat >"$SAFE_DIR/README-recovery.txt" <<'NOTE'
These files were encrypted by bier with plain gpg, symmetric, AES-256.

You do not need bier to get them back. With the passphrase:

    gpg -d dot_zshrc.gpg > ~/.zshrc

The name says where the file belongs: dot_ stands for a leading dot, and
directories are mirrored, so dot_config/nvim/init.lua is
~/.config/nvim/init.lua.

Earlier versions are in the git history of this repository.

Nothing can recover the passphrase itself. If it is lost, so are these
files.
NOTE
}

# What belongs to the user, for counting out loud. bier's own files are
# none of their business.
vault_own_files() {
	[ -d "$VAULT" ] || return 0
	local f rel
	find "$VAULT" -type f -print 2>/dev/null | while IFS= read -r f; do
		rel=${f#"$VAULT"/}
		vault_is_meta "$rel" && continue
		printf '%s\n' "$rel"
	done
}

# Every entry this Mac knows of: in the safe, in the vault, agreed on
# before, or found in a tracked folder. Sorted, once each.
vault_known() {
	local f marker folder target inner
	{
		[ ! -d "$SAFE_DIR" ] || find "$SAFE_DIR" -name '*.gpg' -type f -print 2>/dev/null |
			sed -e "s#^$SAFE_DIR/##" -e 's#\.gpg$##'
		[ ! -d "$VAULT" ] || find "$VAULT" -type f -print 2>/dev/null | sed "s#^$VAULT/##"
		[ ! -f "$STATE_DIR/vault-base" ] || cut -f2 "$STATE_DIR/vault-base"
		[ -z "${VAULT_QUICK:-}" ] || return 0
		{
			[ ! -d "$SAFE_DIR" ] || find "$SAFE_DIR" -name '.bier-folder.gpg' -print 2>/dev/null |
				sed -e "s#^$SAFE_DIR/##" -e 's#/\.bier-folder\.gpg$##'
			[ ! -d "$VAULT" ] || find "$VAULT" -name '.bier-folder' -print 2>/dev/null |
				sed -e "s#^$VAULT/##" -e 's#/\.bier-folder$##'
		} | sort -u | while IFS= read -r folder; do
			[ -n "$folder" ] || continue
			vault_wanted "$folder" || continue
			target=$(vault_target "$folder")
			[ -d "$target" ] || continue
			find "$target" -type f -print 2>/dev/null | while IFS= read -r f; do
				inner=${f#"$target"/}
				vault_excluded "$inner" && continue
				printf '%s/%s\n' "$folder" "$(printf '%s' "$inner" | sed -e 's#^\.#dot_#' -e 's#/\.#/dot_#g')"
			done
		done
	} | grep -v '^README.txt$' | grep -v '^$' | sort -u | while IFS= read -r rel; do
		# Noise excluded after it was taken in stays where it is, and
		# is left alone from then on.
		vault_is_meta "$rel" || ! vault_excluded "$rel" || continue
		printf '%s\n' "$rel"
	done || true
}

sha_of() { shasum -a 256 "$1" | cut -d' ' -f1; }

# macOS guards other apps' containers: a program without permission sees
# that a file is there, but cannot read it. Taken for a change, that
# would seal nothing and abort the sync -- so it is told apart.
vault_denied() {
	local p=$1
	if [ -d "$p" ]; then
		! ls "$p" >/dev/null 2>&1
	elif [ -e "$p" ]; then
		! { : <"$p"; } 2>/dev/null
	else
		while [ ! -e "$p" ]; do p=$(dirname "$p"); done
		! ls "$p" >/dev/null 2>&1
	fi
}

# What sealing would do with one entry, without the passphrase:
# new, changed, deleted, both (changed here and in the safe), large,
# or nothing.
vault_outgoing() {
	local rel=$1 target src enc base encb
	enc=$SAFE_DIR/$rel.gpg
	base=$(vault_base_get "$rel")
	encb=$(vault_base_get_safe "$rel")
	if vault_is_meta "$rel"; then
		src=$VAULT/$rel
		[ -f "$src" ] || return 0
		if [ ! -f "$enc" ]; then
			echo new
		elif [ -n "$base" ] && [ "$(vault_hash "$src")" != "$base" ]; then
			if [ "$(sha_of "$enc")" = "$encb" ]; then echo changed; else echo both; fi
		fi
		return 0
	fi
	target=$(vault_target "$rel")
	[ ! -L "$target" ] || return 0
	if vault_denied "$target"; then
		echo denied
		return 0
	fi
	# A running app may be writing its settings right now, and writes
	# them again when it quits: taken now, half a state could travel.
	if vault_busy "$target" >/dev/null; then
		echo busy
		return 0
	fi
	if [ -f "$target" ]; then
		if [ ! -f "$enc" ]; then
			# Deleted on another Mac: that is for opening to sort out.
			[ -z "$base" ] || return 0
			if vault_too_large "$target"; then echo large; else echo new; fi
		elif [ -n "$base" ] && [ "$(vault_hash "$target")" != "$base" ]; then
			if [ "$(sha_of "$enc")" != "$encb" ]; then
				echo both
			elif vault_too_large "$target"; then
				echo large
			else
				echo changed
			fi
		fi
	elif [ -f "$enc" ] && [ -n "$base" ] && [ "$(sha_of "$enc")" = "$encb" ]; then
		echo deleted
	fi
}

# What opening would do with one entry, without the passphrase: new,
# changed, deleted, forgotten, or nothing.
vault_incoming() {
	local rel=$1 enc base encb target
	enc=$SAFE_DIR/$rel.gpg
	base=$(vault_base_get "$rel")
	encb=$(vault_base_get_safe "$rel")
	if [ -f "$enc" ]; then
		if [ -z "$base" ]; then
			if vault_is_meta "$rel"; then
				if [ -f "$VAULT/$rel" ]; then echo check; else echo new; fi
			else
				target=$(vault_target "$rel")
				if [ -f "$target" ]; then echo check; else echo new; fi
			fi
		elif [ "$(sha_of "$enc")" != "$encb" ]; then
			echo changed
		fi
	elif [ -n "$base" ]; then
		if [ -e "$SAFE_DIR/$rel.forgotten" ]; then echo forgotten; else echo deleted; fi
	fi
}

# Links from the time before copy mode become the files they pointed at.
vault_unlink() {
	local rel target n=0
	[ -d "$VAULT" ] || return 0
	while IFS= read -r rel; do
		[ -n "$rel" ] || continue
		vault_is_meta "$rel" && continue
		target=$(vault_target "$rel")
		[ -L "$target" ] || continue
		[ "$(readlink "$target")" = "$VAULT/$rel" ] || continue
		rm -f "$target"
		cp -p "$VAULT/$rel" "$target"
		n=$((n + 1))
	done <<EOF
$(find "$VAULT" -type f -print | sed -e "s#^$VAULT/##")
EOF
	[ "$n" = 0 ] || info "$(count_word "$n") turned from links back into plain files."
}

# This Mac -> safe: what changed here is copied into the vault, sealed,
# and handed on with the sync. A file deleted here leaves the safe.
vault_seal() {
	local pass rel what work target
	vault_unlink
	work=$(tmpfile)
	vault_known | while IFS= read -r rel; do
		vault_wanted "$rel" || continue
		what=$(vault_outgoing "$rel")
		[ -z "$what" ] || printf '%s\t%s\n' "$what" "$rel"
	done >"$work"
	# Said once per app, not once per file.
	{ grep "^busy$(printf '\t')" "$work" || true; } | cut -f2 | while IFS= read -r rel; do
		vault_busy "$(vault_target "$rel")"
		echo
	done | sort -u | while IFS= read -r app; do
		[ -z "$app" ] || info "waiting: $app is running; its settings are shared once it has quit"
	done
	grep -qE '^(new|changed|deleted)'$'\t' "$work" || return 0

	pass=$(vault_pass)
	[ -n "$pass" ] || die "the vault holds files but no passphrase is set.
     bier vault --init"
	need_gpg
	# Checked before anything is encrypted. A wrong passphrase used to
	# seal this Mac's files first and complain only when opening, and
	# the safe then held files the other Macs could not open.
	vault_pass_works "$pass" ||
		die "the safe will not open with the remembered passphrase.
     Nothing was encrypted. Changed on another Mac?  bier vault --init"

	mkdir -p "$SAFE_DIR"
	vault_recovery_note
	while IFS="$(printf '\t')" read -r what rel; do
		case $what in
		new | changed)
			if ! vault_is_meta "$rel"; then
				target=$(vault_target "$rel")
				mkdir -p "$(dirname "$VAULT/$rel")"
				cp -p "$target" "$VAULT/$rel"
			fi
			mkdir -p "$(dirname "$SAFE_DIR/$rel")"
			vault_encrypt "$VAULT/$rel" "$pass" "$SAFE_DIR/$rel.gpg"
			rm -f "$SAFE_DIR/$rel.forgotten"
			vault_base_set "$rel" "$(vault_hash "$VAULT/$rel")" "$SAFE_DIR/$rel.gpg"
			;;
		deleted)
			rm -f "$SAFE_DIR/$rel.gpg" "$VAULT/$rel"
			vault_base_del "$rel"
			info "deleted from the safe: $(vault_target "$rel")"
			;;
		esac
	done <"$work"
	find "$VAULT" -mindepth 1 -type d -empty -delete 2>/dev/null || true
}

# Safe -> this Mac: what changed elsewhere is put in place, what was
# deleted elsewhere goes to the Trash.
vault_open() {
	local pass rel what work
	vault_unlink
	[ ! -f "$SAFE_DIR/.groups.gpg" ] && [ ! -f "$STATE_DIR/vault-base" ] &&
		[ -z "$(find "$SAFE_DIR" -name '*.gpg' -type f -print -quit 2>/dev/null)" ] && return 0
	work=$(tmpfile)
	# The groups first: everything after this asks them whether it
	# belongs here.
	[ -z "$(vault_incoming .groups)" ] || printf 'groups\t.groups\n' >"$work"
	# An app's map says where its files go, so it comes before them.
	vault_known | while IFS= read -r rel; do
		[ "$rel" != .groups ] || continue
		vault_wanted "$rel" || continue
		what=$(vault_incoming "$rel")
		[ -n "$what" ] || continue
		case $rel in
		*/.bier-map) printf '0\t%s\t%s\n' "$what" "$rel" ;;
		*) printf '1\t%s\t%s\n' "$what" "$rel" ;;
		esac
	done | sort -t "$(printf '\t')" -k1,1 -s | cut -f2- >>"$work"
	[ -s "$work" ] || return 0

	if grep -qE '^(groups|new|changed|check)'$'\t' "$work"; then
		case $(vault_pass_state) in
		missing)
			info "The safe holds files, but this Mac has no passphrase yet."
			info "  bier vault --init"
			return 0
			;;
		locked)
			if ! keychain_unlock; then
				info "The safe holds files, but the keychain is locked; they stay closed."
				info "  security unlock-keychain ~/Library/Keychains/login.keychain-db"
				return 0
			fi
			;;
		esac
		pass=$(vault_pass)
		need_gpg
	fi
	while IFS="$(printf '\t')" read -r what rel; do
		case $what in
		groups | new | changed | check) vault_take "$rel" "$pass" ;;
		deleted | forgotten) vault_gone "$rel" "$what" ;;
		esac
	done <"$work"
	find "$VAULT" -mindepth 1 -type d -empty -delete 2>/dev/null || true
}

# One entry from the safe, by what changed since this Mac and the safe
# last agreed:
#
#   only the safe      put it in place, after a backup
#   only here          keep it; the next sync seals it
#   both, or unknown   keep it, and put the safe's version next to it as
#                      .from-safe; the next sync shares this Mac's file
#
# bier's own files take the safe's version when both changed: there is
# no place in anybody's home for a second copy.
vault_take() {
	local rel=$1 pass=$2 plain safe cur base target copy n app
	plain=$(tmpfile)
	vault_decrypt "$SAFE_DIR/$rel.gpg" "$pass" "$plain" ||
		die "the safe will not open with the remembered passphrase.
     Changed on another Mac?  bier vault --init"
	safe=$(vault_hash "$plain")
	base=$(vault_base_get "$rel")
	mkdir -p "$(dirname "$VAULT/$rel")"

	if vault_is_meta "$rel"; then
		if [ -f "$VAULT/$rel" ]; then
			cur=$(vault_hash "$VAULT/$rel")
			if [ "$cur" != "$safe" ] && [ -n "$base" ] && [ "$safe" = "$base" ]; then
				rm -f "$plain"
				vault_base_set "$rel" "$base" "$SAFE_DIR/$rel.gpg"
				return 0
			fi
			if [ "$cur" != "$safe" ] && { [ -z "$base" ] || [ "$cur" != "$base" ]; }; then
				info "$rel changed here and on another Mac; the other version was taken"
			fi
		fi
		cp "$plain" "$VAULT/$rel"
		rm -f "$plain"
		vault_base_set "$rel" "$safe" "$SAFE_DIR/$rel.gpg"
		return 0
	fi

	target=$(vault_target "$rel")
	if [ -L "$target" ]; then
		info "left alone: $target is a link to somewhere else"
		rm -f "$plain"
		return 0
	fi
	if vault_denied "$target"; then
		info "no access: $target -- see: bier access"
		rm -f "$plain"
		return 0
	fi
	if [ -f "$target" ]; then
		cur=$(vault_hash "$target")
	else
		cur=""
	fi
	if [ "$cur" = "$safe" ]; then
		:
	elif [ -n "$base" ] && [ -n "$cur" ] && [ "$safe" = "$base" ]; then
		# Only re-encrypted elsewhere; the change here goes out next time.
		rm -f "$plain"
		vault_base_set "$rel" "$base" "$SAFE_DIR/$rel.gpg"
		return 0
	elif [ -z "$cur" ] || { [ -n "$base" ] && [ "$cur" = "$base" ]; }; then
		if app=$(vault_busy "$target"); then
			info "waiting: $app is running, $target stays as it is for now"
			rm -f "$plain"
			return 0
		fi
		if ! vault_container_ready "$target"; then
			rm -f "$plain"
			return 0
		fi
		vault_backup "$target"
		vault_put "$plain" "$target"
		if [ -z "$cur" ] && [ -n "$base" ]; then
			info "restored: $target (deleted here, changed on another Mac)"
		elif [ -z "$cur" ]; then
			info "added: $target"
		else
			info "updated: $target"
		fi
	elif [ -z "$base" ]; then
		# First arrival over a file this Mac had of its own -- every Mac
		# has a .zshrc. The shared one wins; letting this one win would
		# send a fresh Mac's default to every other Mac. It is kept.
		if app=$(vault_busy "$target"); then
			info "waiting: $app is running, $target stays as it is for now"
			rm -f "$plain"
			return 0
		fi
		copy=$target.backup
		n=2
		while [ -e "$copy" ]; do
			copy=$target.backup.$n
			n=$((n + 1))
		done
		cp -p "$target" "$copy"
		vault_put "$plain" "$target"
		info "kept: $copy"
		info "added: $target"
	else
		copy=$target.from-safe
		n=2
		while [ -e "$copy" ]; do
			copy=$target.from-safe.$n
			n=$((n + 1))
		done
		cp "$plain" "$copy"
		info "changed here and on another Mac: $target"
		info "  the other version is in $copy"
		info "  merge what you need into $target; the next sync keeps it as it is then"
	fi
	cp "$plain" "$VAULT/$rel"
	rm -f "$plain"
	vault_base_set "$rel" "$safe" "$SAFE_DIR/$rel.gpg"
}

# An entry that left the safe on another Mac.
vault_gone() {
	local rel=$1 why=$2 target app
	if vault_is_meta "$rel"; then
		rm -f "$VAULT/$rel"
		vault_base_del "$rel"
		return 0
	fi
	target=$(vault_target "$rel")
	if vault_denied "$target"; then
		info "no access: $target -- see: bier access"
		return 0
	fi
	if [ "$why" = forgotten ]; then
		rm -f "$VAULT/$rel"
		vault_base_del "$rel"
		[ ! -f "$target" ] || info "no longer synced: $target (kept here)"
		return 0
	fi
	if [ ! -f "$target" ]; then
		rm -f "$VAULT/$rel"
		vault_base_del "$rel"
	elif [ "$(vault_hash "$target")" = "$(vault_base_get "$rel")" ]; then
		if app=$(vault_busy "$target"); then
			info "waiting: $app is running, $target stays as it is for now"
			return 0
		fi
		vault_trash "$target"
		rm -f "$VAULT/$rel"
		vault_base_del "$rel"
		info "moved to the Trash: $target (deleted on another Mac)"
	else
		# Changed here: kept, and shared again by the next sync.
		cp -p "$target" "$VAULT/$rel"
		vault_base_del "$rel"
		info "deleted on another Mac, changed here: $target stays and is shared again"
	fi
}

# What this Mac and the safe last agreed on, per vault file, lives in
# $STATE_DIR. A salted hash rather than the plain one: a short secret
# in a file would otherwise be easy to guess back from it. Neither the
# salt nor the list travels.
vault_hash() {
	local salt=$STATE_DIR/vault-salt
	if [ ! -s "$salt" ]; then
		mkdir -p "$STATE_DIR"
		chmod 700 "$STATE_DIR"
		(umask 077 && head -c 32 /dev/urandom | xxd -p | tr -d '\n' >"$salt")
	fi
	{ cat "$salt"; cat "$1"; } | shasum -a 256 | cut -d' ' -f1
}

vault_base_get() {
	[ -f "$STATE_DIR/vault-base" ] || return 0
	awk -F '\t' -v rel="$1" '$2 == rel { hash = $1 } END { if (hash != "") print hash }' "$STATE_DIR/vault-base"
}

# The encrypted file as it was at that moment. A different one in the
# safe means a peer delivered something that the next sync opens --
# which can be told without the passphrase.
vault_base_get_safe() {
	[ -f "$STATE_DIR/vault-base" ] || return 0
	awk -F '\t' -v rel="$1" '$2 == rel { hash = $3 } END { if (hash != "") print hash }' "$STATE_DIR/vault-base"
}

# vault_base_set <rel> <plain hash> [<encrypted file>]
vault_base_set() {
	local list=$STATE_DIR/vault-base next enc=""
	[ -z "${3:-}" ] || [ ! -f "$3" ] || enc=$(sha_of "$3")
	mkdir -p "$STATE_DIR"
	next=$(mktemp "$STATE_DIR/vault-base.XXXXXX")
	[ ! -f "$list" ] || awk -F '\t' -v rel="$1" '$2 != rel' "$list" >"$next"
	printf '%s\t%s\t%s\n' "$2" "$1" "$enc" >>"$next"
	mv "$next" "$list"
}

vault_base_del() {
	local list=$STATE_DIR/vault-base next
	[ -f "$list" ] || return 0
	next=$(mktemp "$STATE_DIR/vault-base.XXXXXX")
	awk -F '\t' -v rel="$1" '$2 != rel' "$list" >"$next"
	mv "$next" "$list"
}

cmd_vault() {
	need_repo
	local pass new n

	case ${1:-} in
	--init)
		need_gpg
		# A locked keychain is not a missing passphrase: storing a new
		# one here would be answered with the same lock anyway.
		[ "$(vault_pass_state)" != locked ] || vault_pass >/dev/null
		if [ -n "$(vault_pass)" ]; then
			info "This Mac already knows a passphrase."
			info "To change it everywhere:  bier vault --passphrase"
			info ""
		fi
		info "The passphrase is the only thing protecting the vault, and"
		info "nothing can recover it. Keep a copy somewhere that is not"
		info "these Macs -- your password manager, or a note in a drawer."
		info "Do that first; this is not the place to invent one."
		info ""
		# With files in the safe the answer is checked against them, so
		# once is enough. With an empty safe there is nothing to check.
		if [ -n "$(find "$SAFE_DIR" -name '*.gpg' -print -quit 2>/dev/null)" ]; then
			pass=$(vault_ask "Passphrase: ")
		else
			pass=$(vault_ask_twice "Passphrase: ")
		fi
		vault_pass_works "$pass" ||
			die "that passphrase does not open the vault that is already there"
		vault_pass_store "$pass"
		info "Remembered on this Mac."
		return 0
		;;
	--passphrase)
		need_gpg
		pass=$(vault_pass)
		[ -n "$pass" ] || die "no passphrase set yet -- bier vault --init"
		new=$(vault_ask_twice "New passphrase: ")
		vault_reseal "$pass" "$new"
		vault_pass_store "$new"
		info "Changed, and everything re-encrypted."
		info "Every other Mac will ask for the new one on its next sync."
		return 0
		;;
	group)
		shift
		cmd_group "$@"
		return 0
		;;
	add)
		need_gpg
		shift
		local scope="" app=""
		while [ $# -gt 0 ]; do
			case $1 in
			--for)
				scope=${2:-}
				[ -n "$scope" ] || die "--for what? a group or a device name"
				shift 2
				;;
			--app)
				app=${2:-}
				[ -n "$app" ] || die "--app what? the app's name, e.g. --app HandBrake"
				shift 2
				;;
			*) break ;;
			esac
		done
		[ $# -gt 0 ] || die "which file? bier vault add ~/.zshrc"
		for pass in "$@"; do
			if [ -n "$app" ]; then vault_add_app "$app" "$pass" "$scope"; else vault_add "$pass" "$scope"; fi
		done
		return 0
		;;
	--unlink)
		# Links from the time before copy mode become plain files. The
		# vault and the safe are left alone.
		vault_unlink
		return 0
		;;
	--restore)
		# Put back what is missing here from the vault's copy. A missing
		# file otherwise counts as deleted here, and the next sync would
		# take it out everywhere.
		local rel target n=0
		while IFS= read -r rel; do
			[ -n "$rel" ] || continue
			vault_is_meta "$rel" && continue
			target=$(vault_target "$rel")
			[ ! -e "$target" ] && [ -f "$VAULT/$rel" ] || continue
			vault_put "$VAULT/$rel" "$target"
			info "restored: $target"
			n=$((n + 1))
		done <<EOF
$(vault_known)
EOF
		info "$(count_word "$n") restored."
		return 0
		;;
	seal)
		vault_seal
		return 0
		;;
	open)
		vault_open
		return 0
		;;
	drop)
		shift
		[ $# -gt 0 ] || die "which file? bier vault drop ~/.zshrc"
		for pass in "$@"; do vault_drop "$pass"; done
		return 0
		;;
	resolve)
		shift
		[ $# -eq 2 ] || die "usage: bier vault resolve <file>.from-safe mine|theirs"
		vault_resolve "$1" "$2"
		return 0
		;;
	forget)
		shift
		[ $# -gt 0 ] || die "which file? bier vault forget ~/.zshrc"
		for pass in "$@"; do vault_forget "$pass"; done
		return 0
		;;
	esac

	n=$(vault_own_files | wc -l | tr -d ' ')
	info "Vault:  $VAULT"
	info "Safe:   $SAFE_DIR"
	info "  $(count_word "$n") in it"
	case $(vault_pass_state) in
	known) info "  the passphrase is remembered on this Mac" ;;
	locked) info "  the passphrase is in the keychain, but the keychain is locked" ;;
	*) info "  no passphrase yet -- bier vault --init" ;;
	esac
}

# Re-encrypts everything from one passphrase to another. Writes to a
# temporary place first: a passphrase change that dies halfway through
# would otherwise leave half the safe unreadable with either of them.
vault_reseal() {
	local old=$1 new=$2 rel plain staging plain_hash
	[ -d "$SAFE_DIR" ] || return 0
	[ -n "$(find "$SAFE_DIR" -name '*.gpg' -type f -print -quit)" ] || return 0

	staging=$(mktemp -d "${TMPDIR:-/tmp}/bier-reseal.XXXXXX")
	while IFS= read -r rel; do
		plain=$(tmpfile)
		vault_decrypt "$SAFE_DIR/$rel" "$old" "$plain" ||
			die "the remembered passphrase does not open $rel -- nothing changed"
		mkdir -p "$(dirname "$staging/$rel")"
		vault_encrypt "$plain" "$new" "$staging/$rel"
	done <<EOF
$(find "$SAFE_DIR" -name '*.gpg' -type f -print | sed "s#^$SAFE_DIR/##")
EOF
	while IFS= read -r rel; do
		mv "$staging/$rel" "$SAFE_DIR/$rel"
		# Same content under a new key: not news for status.
		rel=${rel%.gpg}
		plain_hash=$(vault_base_get "$rel")
		[ -z "$plain_hash" ] || vault_base_set "$rel" "$plain_hash" "$SAFE_DIR/$rel.gpg"
	done <<EOF
$(cd "$staging" && find . -name '*.gpg' -type f -print | sed 's#^\./##')
EOF
	rm -rf "$staging"
}

# Looks this Mac over the way brew doctor does: installation, agent,
# peers, data repository, vault, lists. Changes nothing; each finding
# says how to put it right. Exits 1 when it found something.
#
# Findings go to a file, not a counter: some are found inside pipes,
# which run in subshells.
BREWMASTER_LOG=/dev/null
brewmaster_warn() {
	local line
	{
		printf '\nWarning: %s\n' "$1"
		shift
		for line in "$@"; do printf '  %s\n' "$line"; done
	} >>"$BREWMASTER_LOG"
}

cmd_brewmaster() {
	local peer app version release target copy f found
	BREWMASTER_LOG=$(tmpfile)
	info "Checking this Mac, its peers and the vault …"

	# Installation
	[ "$CONFIG_FILE" != "$LEGACY_CONFIG" ] ||
		brewmaster_warn "this installation has not moved into $BARREL yet." "$ROOT/install.sh"
	case ":$PATH:" in
	*":$BARREL/bin:"*) ;;
	*) brewmaster_warn "$BARREL/bin is not on your PATH." \
		"Add to ~/.zshrc:  export PATH=\"$BARREL/bin:\$PATH\"" ;;
	esac
	release=$(latest_release)
	if [ -n "$release" ] && newer_version "$BIER_VERSION" "$release"; then
		brewmaster_warn "bier $release is out; this is $BIER_VERSION." "bier upgrade"
	fi
	app=$BARREL/BierMenu.app
	version=$(plutil -extract CFBundleShortVersionString raw -o - "$app/Contents/Info.plist" 2>/dev/null || true)
	[ -z "$version" ] || [ "$version" = "$BIER_VERSION" ] ||
		brewmaster_warn "BierMenu is $version, bier is $BIER_VERSION." "bier upgrade --force"

	# Agent
	if [ ! -f "$HOME/Library/LaunchAgents/com.bier.agent.plist" ]; then
		brewmaster_warn "the Bier agent is not installed; other Macs cannot reach this one." "$ROOT/install.sh"
	elif ! curl -fsS --max-time 3 "http://127.0.0.1:$PEER_PORT/v1/health" 2>/dev/null | grep -q '"status":"ok"'; then
		brewmaster_warn "the Bier agent does not answer on port $PEER_PORT." \
			"launchctl kickstart -k gui/$(id -u)/com.bier.agent"
	fi

	# Peers
	if [ -n "$(peer_list)" ] && [ ! -x "$PEER_CLIENT" ]; then
		brewmaster_warn "the peer client is not built." "$ROOT/install.sh"
	elif [ -x "$PEER_CLIENT" ]; then
		for peer in $(peer_list); do
			if ! peer_call hello "$peer" --identity "$PEER_IDENTITY" >/dev/null 2>&1; then
				case $peer in
				*@*) brewmaster_warn "$peer does not answer over SSH." \
					"ssh $peer true   has to work without a password (ssh-copy-id $peer)" ;;
				*) brewmaster_warn "$peer does not answer." \
					"Is it awake, on this network or on Tailscale, and running bier?" ;;
				esac
			elif [ -z "$(peer_sent_get "$peer")" ]; then
				brewmaster_warn "$peer has never been synced with." "bier sync"
			fi
		done
	fi
	pending_list | while read -r f _ peer _; do
		brewmaster_warn "$f was introduced by $peer and waits to be trusted." "bier peer accept $f   (or: bier peer reject $f)"
	done

	# Data repository and lists
	if [ -z "$DATA" ] || [ ! -d "$DATA/.git" ]; then
		brewmaster_warn "there is no data repository at ${DATA:-(not set)}." "$ROOT/install.sh"
	else
		# A repository on no branch needs no finding: every bier command
		# puts it back on main before it starts (repair_repo).
		if [ -d "$DATA/.git/rebase-merge" ] || [ -d "$DATA/.git/rebase-apply" ]; then
			brewmaster_warn "a git rebase in $DATA was left half-done." "git -C $DATA rebase --abort"
		fi
		[ -z "$(git -C "$DATA" status --porcelain -- Brewfiles Safe 2>/dev/null)" ] ||
			brewmaster_warn "Brewfiles or the safe have changes not committed." "bier sync"
		[ -n "$(git -C "$DATA" config user.name 2>/dev/null)" ] ||
			brewmaster_warn "git has no name to commit with." "git config --global user.name \"Your Name\""
		for f in "$MAIN_FILE" "$BREW_DIR/$HOST"; do
			[ -z "$(foreign_lines "$f")" ] ||
				brewmaster_warn "$f holds lines that are not entries; brew would run them." "bier status   shows them"
		done
	fi

	# Vault
	if [ -n "$(find "$SAFE_DIR" -name '*.gpg' -type f -print -quit 2>/dev/null)" ]; then
		case $(vault_pass_state) in
		missing) brewmaster_warn "the safe holds files, but this Mac has no passphrase." "bier vault --init" ;;
		locked) brewmaster_warn "the keychain is locked; the vault stays closed." \
			"security unlock-keychain ~/Library/Keychains/login.keychain-db" ;;
		esac
	fi
	vault_duplicates | while IFS= read -r target; do
		[ -n "$target" ] || continue
		brewmaster_warn "$target is shared twice; the two entries work against each other." \
			"bier list   shows both; take one back with: bier vault forget"
	done || true
	vault_arrived | sed -n 's/^VAULT_LEFT'$'\t''//p' | while IFS= read -r copy; do
		brewmaster_warn "$copy is left from a conflict." \
			"Merge what you need into ${copy%.from-safe*}, delete it, then: bier sync"
	done || true
	if { vault_report || true; } | grep -q '^VAULT_DENIED'; then
		brewmaster_warn "macOS does not let bier read some app settings." "bier access"
	fi
	vault_known | while IFS= read -r f; do
		vault_is_meta "$f" && continue
		case ${f##*/} in
		*.hbqueue | *.sqlite-wal | *.sqlite-shm | *-journal) printf '%s\n' "${f##*.}" ;;
		esac
	done | sort -u | while IFS= read -r f; do
		brewmaster_warn "files ending in .$f are shared, and change all the time." \
			"Add to $CONFIG_FILE:  vault_exclude = *.$f"
	done || true

	found=$(grep -c '^Warning:' "$BREWMASTER_LOG" || true)
	cat "$BREWMASTER_LOG"
	info ""
	if [ "$found" = 0 ]; then
		info "Your bier is ready to pour."
		return 0
	fi
	info "Your bier is ready to pour, apart from $found thing(s) above."
	return 1
}

# Paths two vault entries lay claim to.
vault_duplicates() {
	local map entry target folder rel
	{
		for map in "$VAULT"/apps/*/.bier-map "$VAULT"/@*/apps/*/.bier-map; do
			[ -f "$map" ] || continue
			while IFS=$'\t' read -r entry target; do
				[ "$entry" = .package ] || [ -z "$target" ] || printf '%s\n' "$HOME/$target"
			done <"$map"
		done
		[ ! -d "$VAULT" ] || find "$VAULT" -name .bier-folder -print | sed -e "s#^$VAULT/##" -e 's#/\.bier-folder$##' |
			while IFS= read -r folder; do
				[[ $(vault_strip_scope "$folder") == apps/* ]] && continue
				printf '%s\n' "$(vault_target "$folder")"
			done
		vault_own_files | while IFS= read -r rel; do
			[[ $(vault_strip_scope "$rel") == apps/* ]] && continue
			printf '%s\n' "$(vault_target "$rel")"
		done
	} | sort | uniq -d || true
}

# Reading an app's settings in its container needs Full Disk Access, for
# the terminal bier runs in and for BierMenu, which runs it on its own.
# macOS lets nobody grant that but the person at the Mac, in System
# Settings; this opens the place and shows the app to drag in.
cmd_access() {
	local app=$BARREL/BierMenu.app
	info "bier reads app settings inside their sandbox containers. macOS"
	info "allows that only with Full Disk Access, granted by you:"
	info ""
	info "  1. System Settings > Privacy & Security > Full Disk Access"
	info "  2. add your terminal, and BierMenu -- drag it from the Finder"
	info "     window into the list: $app"
	info ""
	info "BierMenu is signed on this Mac only, so after bier upgrade macOS"
	info "may ask again."
	[ -z "${BIER_TEST_SYSTEM:-}" ] || return 0
	open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles" 2>/dev/null || true
	[ ! -d "$app" ] || open -R "$app" 2>/dev/null || true
}

# Takes bier off this Mac, and this Mac out of the group -- the tidy way
# out; "rm -rf ~/.barrel" is the blunt one. The other Macs are told, so
# they stop trusting this one and stop trying to reach it, and the files
# from the vault stay where they are, as plain files.
cmd_knockout() {
	local dry=no answer peers="" peer unsigned="" left_out="" profile tmp agent_plist
	[ "${1:-}" != --dry-run ] || dry=yes
	[ ! -x "$PEER_CLIENT" ] || peers=$(peer_list)

	info "This takes bier off $HOST and out of the group:"
	info ""
	info "  1. sync one last time, so nothing made here is lost"
	info "  2. take $HOST out: Brewfiles/$HOST and the vault groups"
	if [ -n "$peers" ]; then
		info "  3. sign off at every paired Mac: $(printf '%s ' $peers | sed 's/ $//; s/ /, /g')"
		info "     (each forgets this Mac's key and address)"
	else
		info "  3. no paired Macs to sign off at"
	fi
	info "  4. take bier off this Mac: the agent, BierMenu, the bier command,"
	info "     the PATH line and the passphrase in the keychain."
	info "     Files from the vault stay where they are, as plain files."
	info "  5. ask whether to delete $BARREL as well"
	if [ "$dry" = yes ]; then
		info ""
		info "Nothing has been changed."
		return 0
	fi
	[ -t 0 ] || [ -n "${BIER_TEST_TTY:-}" ] ||
		die "knockout asks before it changes anything, and there is no terminal to ask at"
	info ""
	printf 'Type "knockout" to go on: '
	read -r answer || answer=""
	if [ "$answer" != knockout ]; then
		info "Cancelled. Nothing was changed."
		return 0
	fi

	if [ -n "$DATA" ] && [ -d "$DATA/.git" ]; then
		info ""
		info "== 1. The last sync"
		if ! (cmd_sync "$HOST: last sync before leaving"); then
			printf 'The last sync failed. Go on anyway? [y/N] '
			read -r answer || answer=""
			case $answer in
			y | Y | j | J) ;;
			*) die "stopped; nothing after the sync was changed" ;;
			esac
		fi

		info ""
		info "== 2. Out of the group"
		if [ -f "$BREW_DIR/$HOST" ] || [ -n "$(host_group "$HOST")" ]; then
			[ -f "$BREW_DIR/$HOST" ] || : >"$BREW_DIR/$HOST"
			(RETIRE_CONFIRMED=yes cmd_retire --self) || info "  could not take $HOST out -- do it from another Mac: bier retire $HOST"
		else
			info "  $HOST has no list of its own and is in no group"
		fi
		# The removal travels before the sign-off: afterwards the other
		# Macs no longer take anything from here.
		for peer in $peers; do
			(cmd_peer_sync "$peer") >/dev/null 2>&1 || left_out="$left_out $peer"
		done
	fi

	info ""
	info "== 3. Signing off"
	for peer in $peers; do
		if peer_call leave "$peer" --identity "$PEER_IDENTITY"; then
			peer_forget "$peer"
		else
			unsigned="$unsigned $peer"
		fi
	done
	[ -n "$peers" ] || info "  no paired Macs"

	info ""
	info "== 4. Taking bier off this Mac"
	vault_unlink
	pkill -f 'MacOS/BierMenu' >/dev/null 2>&1 && info "  stopped BierMenu" || true
	agent_plist=$HOME/Library/LaunchAgents/com.bier.agent.plist
	if [ -f "$agent_plist" ]; then
		launchctl bootout "gui/$(id -u)" "$agent_plist" >/dev/null 2>&1 || true
		rm -f "$agent_plist"
		info "  stopped and removed the Bier agent"
	fi
	for profile in "$HOME/.zshrc" "$HOME/.bash_profile"; do
		[ -f "$profile" ] && grep -q '^# added by bier$' "$profile" || continue
		tmp=$(tmpfile)
		awk '
			/^# added by bier$/ { held = $0; next }
			held != "" && /export PATH=.*(\/\.barrel\/bin|\/\.local\/bin)/ { held = ""; next }
			held != "" { print held; held = "" }
			{ print }
			END { if (held != "") print held }
		' "$profile" >"$tmp"
		cat "$tmp" >"$profile"
		info "  removed the PATH line from $profile"
	done
	security delete-generic-password -s bier-vault -a vault >/dev/null 2>&1 &&
		info "  removed the vault passphrase from the keychain" || true
	case $(readlink "$HOME/.local/bin/bier" 2>/dev/null || true) in
	*/Sources/bier-core/bier) rm -f "$HOME/.local/bin/bier" ;;
	esac
	for tmp in /Applications/BierMenu.app "$HOME/Applications/BierMenu.app"; do
		[ ! -d "$tmp" ] || { rm -rf "$tmp" && info "  removed $tmp"; }
	done

	info ""
	info "== 5. What is left"
	if [ -n "$unsigned" ]; then
		info "  Not reached to sign off:$unsigned. On each of them, run:"
		info "    bier peer remove $HOST"
		info "  and remove this Mac's address there as well (bier peer list)."
	fi
	[ -z "$left_out" ] ||
		info "  Did not get the removal of $HOST:$left_out -- it reaches them through the other Macs, or run there: bier retire $HOST"
	info "  If \"Start at login\" was on: System Settings > General > Login Items."
	case $ROOT/ in
	"$BARREL"/*) ;;
	*) info "  The program's working copy stays: $ROOT" ;;
	esac
	if [ -d "$BARREL" ]; then
		printf 'Delete %s as well -- the data, the vault copies and the backups? Your files stay where they are. [y/N] ' "$BARREL"
		read -r answer || answer=""
		case $answer in
		y | Y | j | J)
			info ""
			info "bier is gone. Cheers."
			rm -rf "$BARREL"
			exit 0
			;;
		esac
		rm -rf "$BARREL/bin" "$BARREL/BierMenu.app" "$BARREL/agent"
		case $ROOT/ in
		"$BARREL"/*) rm -rf "$ROOT" ;;
		esac
		info "  Kept in $BARREL: the data, the vault copies, the backups and the config."
		info "  rm -rf $BARREL takes them too."
	else
		info "  Kept: $DATA, $VAULT and $(dirname "$CONFIG_FILE")"
		rm -rf "$AGENT_HOME"
	fi
	info ""
	info "bier is off $HOST."
	exit 0
}

# Takes a Mac out of the fleet: the one that broke, was lost, or was
# wiped before anybody thought of uninstalling. Run it on a Mac that is
# still there.
#
# Its own files under @<name>/ are reported but not deleted. Throwing
# somebody's files away as a side effect of tidying up the device list
# would be a surprise, and the encrypted copies cost nothing to keep.
cmd_retire() {
	need_repo
	local name=${1:-} own answer g
	if [ "$name" = "--self" ]; then
		# What install.sh --uninstall calls. Taking yourself out is
		# allowed; doing it by name from the same Mac is a slip.
		name=$HOST
	else
		[ -n "$name" ] || die "which Mac? bier retire mini"
		[ "$name" != "$HOST" ] ||
			die "that is this Mac. To take bier off it:
     bier knockout"
	fi
	[ -f "$BREW_DIR/$name" ] ||
		die "no Mac called $name has ever recorded anything"

	info "$name has $(count_word "$(entries "$BREW_DIR/$name" | wc -l | tr -d ' ')") of its own."
	for g in $(group_list); do
		# No "&&" here: when the Mac is in no group at all the compound
		# returns 1 and set -e takes the whole command down with it.
		if printf '%s\n' $(group_members "$g") | grep -qx "$name"; then
			info "  in group $g"
		fi
	done
	own=0
	[ ! -d "$SAFE_DIR/@$name" ] ||
		own=$(find "$SAFE_DIR/@$name" -name '*.gpg' | wc -l | tr -d ' ')
	[ "$own" = 0 ] ||
		info "  $(count_word "$own") in the vault only for it — those stay"

	if [ "${RETIRE_CONFIRMED:-}" != yes ]; then
		printf 'Take %s out? [y/N] ' "$name"
		read -r answer || answer=""
		case $answer in
		j | J | y | Y) ;;
		*)
			info "Cancelled."
			return 0
			;;
		esac
	fi

	rm -f "$BREW_DIR/$name"
	if [ -f "$GROUPS_FILE" ]; then
		groups_take_out "$name"
	elif [ -f "$VAULT/.groups" ]; then
		local g rest
		for g in $(group_list); do
			rest=$(printf '%s\n' $(group_members "$g") | grep -vx "$name" | tr '\n' ' ')
			rest=${rest% }
			sed -i '' -E "/^[[:space:]]*$g[[:space:]]*=/d" "$VAULT/.groups"
			[ -z "$rest" ] || printf '%s = %s\n' "$g" "$rest" >>"$VAULT/.groups"
		done
		vault_seal
	fi
	publish "$HOST: $name taken out"
	info "$name is out. Its inventory is gone; the git history still has it."
}

# Releases can be verified against a key that is published somewhere
# other than the code. Fetching it once and remembering it is the whole
# trick: whoever takes over the code server has to have taken over that
# other host as well, and before the key was ever fetched.
#
# Nothing is remembered by default, and then nothing is checked. That is
# on purpose. Insisting on a key that a fresh clone has no way of having
# would strand every installation that never asked for this.
cmd_trust_keys() {
	local signers=$1 signers_url=$2 scope=$3 usage=$4 url=${5:-} tmp line key fp

	case $url in
	--forget)
		rm -f "$signers" "$signers_url"
		info "Forgotten. $scope are no longer verified."
		return 0
		;;
	"")
		if [ -s "$signers" ]; then
			info "$scope are verified against:"
			while IFS= read -r line; do
				[ -n "$line" ] || continue
				key=$(tmpfile)
				printf '%s\n' "$line" | cut -d' ' -f2- >"$key"
				info "  $(ssh-keygen -l -f "$key" 2>/dev/null || printf '%s' "$line")"
			done <"$signers"
			info ""
			info "Fetched from: $(cat "$signers_url" 2>/dev/null || echo '?')"
			info "Stop:         $usage --forget"
		else
			info "No key remembered, so $scope are not verified."
			info "  $usage <url>   fetch one and remember it"
		fi
		return 0
		;;
	esac

	tmp=$(tmpfile)
	curl -fsSL --max-time 20 "$url" >"$tmp" ||
		die "could not fetch $url"
	[ -s "$tmp" ] || die "$url is empty"

	# Every line has to be a key, or this is not the file we wanted —
	# a login page returns 200 just as happily as a key does.
	info "From $url:"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		key=$(tmpfile)
		printf '%s\n' "$line" | cut -d' ' -f2- >"$key"
		fp=$(ssh-keygen -l -f "$key" 2>/dev/null) ||
			die "$url does not hold signing keys — this line is not one:
     $line"
		info "  $fp"
	done <"$tmp"

	mkdir -p "$(dirname "$signers")"
	cp "$tmp" "$signers"
	printf '%s\n' "$url" >"$signers_url"
	info ""
	info "Remembered. Compare the fingerprint above with the one you were"
	info "given elsewhere — fetching it proves nothing on its own."
	info "From now on $scope are verified with it."
}

cmd_trust() {
	cmd_trust_keys "$SIGNERS_FILE" "$SIGNERS_URL_FILE" \
		"Bier releases" "bier trust" "$@"
}

cmd_peer_trust() {
	cmd_trust "$@"
}

# Checking a tag out means running its code straight afterwards, so the
# signature is looked at first — but only when a key was remembered.
check_signature() {
	local tag=$1

	if [ ! -s "$SIGNERS_FILE" ]; then
		info "Note: releases are not verified. See bier trust."
		return 0
	fi

	git -C "$ROOT" cat-file tag "$tag" 2>/dev/null |
		grep -q 'BEGIN \(SSH\|PGP\) SIGNATURE' ||
		die "$tag carries no signature, and this Mac verifies releases.
     Not upgrading. Give it up with: bier trust --forget"

	git -C "$ROOT" -c gpg.ssh.allowedSignersFile="$SIGNERS_FILE" \
		verify-tag "$tag" >/dev/null 2>&1 ||
		die "$tag is not signed with the key this Mac trusts — not upgrading.
     Somebody may have put a tag on the server who should not have."

	info "Signature on $tag verified."
}

# Lifts the program itself onto a newer version. Touches no Brewfile —
# that is what "bier sync" is for. Asks nothing.
cmd_upgrade() {
	local force=no
	case ${1:-} in
	--force | -f) force=yes ;;
	esac

	info "Checking the program …"
	local fresh=no
	if check_code; then fresh=yes; fi
	if [ "$fresh" = no ] && [ "$force" = no ]; then
		info "Rebuild anyway: bier upgrade --force"
		return 0
	fi

	[ -z "$UPGRADE_TAG" ] || check_signature "$UPGRADE_TAG"

	# Nothing newer, but --force was given: rebuild what is here instead
	# of moving anywhere. Without this a forced rebuild would try to pull
	# a branch that a released install is not even on.
	local move=yes
	if [ "$fresh" = no ]; then move=no; fi

	info ""
	# The checkout overwrites this very script while it is still running —
	# bash reads it in chunks and would stumble over the changed file.
	# So from here on a new process, whose commands live in memory
	# instead of being read back from a file.
	exec /bin/bash -c '
		set -eu
		root=$1 tag=$2 move=$3
		if [ "$move" = yes ]; then
			if [ -n "$tag" ]; then
				# Land on the release, not on whatever the branch has
				# drifted to since it was cut.
				git -C "$root" checkout --quiet --detach "$tag"
			else
				git -C "$root" pull --rebase --autostash --quiet
			fi
			printf "Now at: %s\n" "$(git -C "$root" log --oneline -1)"
		fi
		exec "$root/install.sh" --yes --no-inventory
	' bier "$ROOT" "$UPGRADE_TAG" "$move"
}

# Commits the Brewfiles and pushes them to the server.
cmd_push() {
	need_repo
	publish "${1:-$HOST: inventory updated}"
}

# The everyday command: record what changed here, then bring this Mac and
# its peers into line. Existing installations without peers retain the
# legacy private-server path until they add their first peer.
cmd_sync() {
	need_repo
	local record=no
	# --record records even in manual mode: that is somebody asking for
	# it, which is what manual mode waits for.
	if [ "${1:-}" = --record ]; then
		record=yes
		shift
	fi
	groups_migrate
	if [ "$(inventory_mode)" = automatic ] || [ "$record" = yes ]; then
		cmd_dump
	else
		info "Inventory is manual; keeping the Brewfiles as written."
	fi
	vault_seal
	local status=0
	if [ -x "$PEER_CLIENT" ] && [ -n "$(peer_list)" ]; then
		# What arrived from the Macs reached goes into place even when
		# one was away.
		sync_peers "${1:-$HOST: inventory updated}" || status=1
	else
		sync_data "${1:-$HOST: inventory updated}"
	fi
	vault_open
	(cmd_apply --received) || true
	return "$status"
}

# Until 0.12.0 "update" did both jobs under one word, and nobody could say
# which of the two they had just asked for. Both have their own word now,
# so the old one points at them instead of guessing.
cmd_update() {
	die "\"bier update\" did two jobs at once and was split in 0.12.0.

     Sync the Macs:        bier sync
     Upgrade the program:  bier upgrade"
}

# Machine-readable state for the menu bar app. Tab-separated lines:
#   STATE  ok|drift        glass full or empty: empty only when something
#                          arrived (STALE, DROPPED, GONE, VAULT_IN) or a
#                          conflict copy waits (VAULT_LEFT)
#   HOST   <name>
#   VERSION <number>      so BierMenu notices that it is old itself
#   NEWCODE <number>      a newer release waits on the code server
#   OFFLINE <which>       a server could not be reached: data, code, or both
#   REPO   <path>         for the info menu
#   COMMIT <short> <date> for the info menu
#   NEW    brew "htop"     installed here, not recorded yet (no drift)
#   STALE  brew "ghidra"   removed elsewhere, still installed here
#   DROPPED brew "nmap"    taken out of main, kept by another Mac, still here
#   GONE   brew "wget"     recorded but not installed here
#   VAULT_IN <file> <how>  settings from another Mac, not in place yet
#   VAULT_LEFT <path>      a .from-safe copy from a conflict
#   PENDING <mac> <by>     a Mac introduced by a peer, waiting for accept
#   INFO   <what> <value>  about this Mac: macos, model, disk
#   MYGROUP <name>         the group this Mac is in; new when in none
#   TRUSTS <mac>           a Mac this one trusts (has its key)
#
# What other devices have more or less of is deliberately absent: it says
# nothing about whether there is anything to do on *this* Mac, and in the
# menu bar it would be noise past a couple of devices. That is what
# "bier list" is for.
cmd_state() {
	need_brew
	need_repo

	local offline=""
	if [ "${1:-}" = "--fetch" ]; then
		# Two things a fetch must not do when the server is away: hang,
		# and pass unnoticed. Without the timeout the menu bar waits on
		# it; without noticing, the glass looks full while nothing has
		# been heard for days.
		local ssh_quick="ssh -o ConnectTimeout=5 -o BatchMode=yes"
		GIT_SSH_COMMAND=$ssh_quick \
			git -C "$DATA" fetch --quiet 2>/dev/null || offline="$offline data"
		# The program as well, so the menu bar can say that a release is
		# out instead of waiting for someone to type "bier upgrade".
		GIT_SSH_COMMAND=$ssh_quick \
			git -C "$ROOT" fetch --tags --quiet 2>/dev/null || offline="$offline code"
	fi

	local tmp
	tmp=$(tmpfile)
	brew bundle dump --force --file "$tmp" >/dev/null 2>&1

	local add fresh stale dropped gone classes
	add=$(comm -23 <(entries "$tmp") <(own_entries) || true)
	gone=$(comm -13 <(entries "$tmp") <(own_entries) || true)
	classes=$(classify_add "$add")
	fresh=$(printf '%s\n' "$classes" | sed -n 's/^NEW'$'\t''//p')
	stale=$(printf '%s\n' "$classes" | sed -n 's/^STALE'$'\t''//p')
	dropped=$(printf '%s\n' "$classes" | sed -n 's/^DROPPED'$'\t''//p')

	# The glass empties for two things only: something arrived from
	# another Mac -- to install, to remove, settings to put in place --
	# or something is wrong. What is only waiting to go out is for the
	# next sync, not for the menu bar.
	local arrived
	arrived=$(vault_arrived)
	if [ -z "$stale$dropped$gone$arrived" ]; then
		printf 'STATE\tok\n'
	else
		printf 'STATE\tdrift\n'
	fi
	printf 'HOST\t%s\n' "$HOST"
	printf 'VERSION\t%s\n' "$BIER_VERSION"
	printf 'MYGROUP\t%s\n' "$(host_group "$HOST" | grep . || echo new)"
	# Whom this Mac trusts: asked of every Mac, it draws the real mesh.
	[ ! -f "$LOCAL_PEER_SIGNERS" ] || awk 'NF >= 2 { printf "TRUSTS\t%s\n", $1 }' "$LOCAL_PEER_SIGNERS"
	mac_info
	local release
	release=$(latest_release)
	if [ -n "$release" ] && newer_version "$BIER_VERSION" "$release"; then
		printf 'NEWCODE\t%s\n' "$release"
	fi
	printf 'REPO\t%s\n' "$ROOT"
	printf 'COMMIT\t%s\t%s\n' \
		"$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')" \
		"$(git -C "$ROOT" log -1 --format=%cs 2>/dev/null || echo '?')"
	if [ -n "$fresh" ]; then printf '%s\n' "$fresh" | sed 's/^/NEW'$'\t''/'; fi
	if [ -n "$stale" ]; then printf '%s\n' "$stale" | sed 's/^/STALE'$'\t''/'; fi
	if [ -n "$dropped" ]; then printf '%s\n' "$dropped" | sed 's/^/DROPPED'$'\t''/'; fi
	if [ -n "$gone" ]; then printf '%s\n' "$gone" | sed 's/^/GONE'$'\t''/'; fi
	[ -z "$arrived" ] || printf '%s\n' "$arrived"
	pending_list | awk '{ printf "PENDING\t%s\t%s\n", $1, $3 }'
	[ -z "$offline" ] || printf 'OFFLINE\t%s\n' "${offline# }"
}

# Version, origin and the paths in effect — the first question in any bug
# report.
cmd_version() {
	info "bier $BIER_VERSION"
	if [ -d "$ROOT/.git" ]; then
		local commit date
		commit=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo "?")
		date=$(git -C "$ROOT" log -1 --format=%cs 2>/dev/null || echo "?")
		info "  Commit  $commit of $date"
	fi
	info "  Code    $ROOT"
	if [ -n "$DATA" ]; then
		info "  Data    $DATA"
	else
		info "  Data    not set up yet"
	fi
	info "  Device  $HOST"

	local app
	for app in "$BARREL/BierMenu.app" /Applications/BierMenu.app "$HOME/Applications/BierMenu.app"; do
		if [ -d "$app" ]; then
			info "  App     $(defaults read "$app/Contents/Info" \
				CFBundleShortVersionString 2>/dev/null || echo "?") ($app)"
		fi
	done
}

# Shows which values are actually in effect, config and environment
# combined.
cmd_config() {
	if [ $# -gt 0 ]; then
		[ $# -eq 2 ] || die "usage: bier config [inventory <automatic|manual> | apply <automatic|ask>]"
		case $1=$2 in
		inventory=automatic | inventory=manual) INVENTORY_MODE=$2 ;;
		apply=automatic | apply=ask) APPLY_MODE=$2 ;;
		*) die "usage: bier config [inventory <automatic|manual> | apply <automatic|ask>]" ;;
		esac
		config_set_value "$1" "$2"
		info "$1 = $2"
		return 0
	fi
	info "File:   $CONFIG_FILE"
	info "root  = $ROOT   (the program)"
	if [ -n "$DATA" ]; then
		info "data  = $DATA   (your Brewfiles)"
	else
		info "data  = not set up yet — $ROOT/install.sh"
	fi
	info "host  = $HOST"
	info "inventory = $INVENTORY_MODE"
	info "apply = $APPLY_MODE   (changes marked install now: automatic, or ask)"
	info ""
	if [ -z "$DATA" ]; then
		info "Without a data repository bier can neither record nor sync anything."
	elif [ -d "$BREW_DIR" ]; then
		info "Devices in Brewfiles/: $(host_list | tr '\n' ' ')"
	else
		info "Brewfiles/ is missing under $DATA"
	fi
}

cmd_help() {
	cat <<'EOF'
bier — keeps Brewfiles in sync across Macs

  bier dump [--adopt]     record what this Mac has that no list gives it
                          (not assigned); --adopt takes in what was
                          removed elsewhere too
  bier main [--no-push]   make this Mac's software what All Macs have, and
                          tidy every other list onto it (commits + pushes)
  bier status             check the system against the Brewfiles
  bier diff [host...]     compare the inventory with other devices
  bier install            install what All Macs and this Mac's group have
  bier add <pkg>          install it if needed, give it to All Macs or a
                          group, and offer to share the app's settings
  bier uninstall <pkg>    uninstall here; asks: off every list, off All Macs
                          (some groups keep it), or off a group
  bier prune [--yes]      remove what was deleted elsewhere or left main
  bier list | ls          everything bier keeps: packages, their settings, files
  bier group [<group> <mac>…]  groups of Macs; every Mac is in one
  bier group move <mac> <group>   the Mac takes on the group's rules
  bier group rule <group> apply automatic|ask | inventory automatic|manual
  bier place <pkg> --all | --on <group>,… | --none [--now]
                          where a package belongs; --now installs it on
                          every Mac as soon as the change reaches it
  bier apply [--everywhere]  install and remove what the lists say, here
                          or on every Mac as the request reaches it
  bier undo <commit>      take back one change, on every Mac
  bier search <name>      what Homebrew and the App Store have by that name
  bier share [--for <group>] <app>
                          share an installed app's settings and profiles
  bier push [message]     commit the Brewfiles and push them
  bier sync [--record] [message]
                          record, fetch, merge, push — the everyday command
  bier upgrade [--force]  install a newer release of bier itself
  bier retire <name>      take a Mac out of the fleet — the one that
                          broke, or was wiped without uninstalling
  bier admin offer        let Bierkasten connect to this Mac (one-time code)
  bier fleet              every paired Mac's own state, asked over the network
  bier brewmaster         check this Mac, its peers and the vault, and say
                          how to fix what is wrong (like brew doctor)
  bier access             how to let bier read app settings in their
                          sandbox (Full Disk Access)
  bier knockout           take bier off this Mac: sign off at the others,
                          leave the vault's files in place
  bier vault [--init]     files that are not Brewfiles, encrypted
       [--passphrase]     with one passphrase all your Macs share
  bier trust [url]        trust Bier program releases; no url shows the key
  bier peer add <host>    remember a Mac that Bier may contact
  bier peer list          show remembered Macs
  bier peer remove <host> forget a remembered Mac, its address or its key
  bier peer address <mac> <new-address>  reach a Mac another way; its key stays
  bier peer pending       Macs another peer introduced, waiting to be trusted
  bier peer accept <mac>|all  trust an introduced Mac, on both sides
  bier peer reject <mac>|all  drop an introduced Mac
  bier peer check <host>  check safe, non-interactive SSH access
  bier peer hello <host>  prove authenticated Bier Agent access
  bier peer offer [--address <own-host>]  show a one-time code for SSH-free pairing
  bier peer pair <host> [--address <own-host>] [--code <code>]  pair using its one-time code
  bier peer compare <host> compare verified data without changing it
  bier peer sync <host>   synchronise data and history with a peer
  bier peer seed <host>   copy data to a new, empty Bier peer
  bier peer trust [url]   alias for bier trust
  bier peer discover      show Bier agents announced via Bonjour
  bier peer install <host> install a signed Bier agent via SSH
  bier peer upgrade <host> replace an agent with the latest signed release
  bier peer uninstall <host> stop and remove a Bier agent via SSH
  bier config             show which settings are in effect
  bier config inventory manual|automatic
                          choose whether sync records all installed apps
  bier state [--fetch]    machine-readable state (for the menu bar app)
  bier version            version, commit and the paths in effect
  bier help               this overview

Brewfiles/main is the shared inventory, Brewfiles/<host> only what one Mac
has on top. Anything that does not belong everywhere does not belong in main.

Code and data live in two repositories: "root" is the program, "data" the
private repository holding your Brewfiles. They reveal what runs on your
Macs and therefore do not belong in the public program repository.
install.sh sets up both.

The config lives in ~/.barrel/config and is created on first run.
It knows "root", "data", "host" (the device name) and whether inventory
collection is "automatic" or "manual".

Environment: BIER_CONFIG (a different config file), BIER_ROOT, BIER_DATA,
BIER_VAULT, BIER_HOST and BIER_INVENTORY (override the matching config values
for one invocation).
EOF
}

# --- Entry point -------------------------------------------------------------

cmd=${1:-help}
if [ $# -gt 0 ]; then
	shift
fi

case $cmd in
dump)
	# "bier dump --main" is the spelling that suggests itself — but what
	# is meant is the rebuild, not the dump.
	if [ "${1:-}" = "--main" ]; then
		shift
		cmd_main "$@"
	else
		cmd_dump "$@"
	fi
	;;
main) cmd_main "$@" ;;
uninstall | rm) cmd_uninstall "$@" ;;
add) cmd_add "$@" ;;
prune) cmd_prune ;;
list | ls) cmd_list ;;
status) cmd_status "$@" ;;
diff) cmd_diff "$@" ;;
install) cmd_install "$@" ;;
take) cmd_take "$@" ;;
push) cmd_push "$@" ;;
sync) cmd_sync "$@" ;;
upgrade) cmd_upgrade "$@" ;;
update) cmd_update ;;
state) cmd_state "$@" ;;
config) cmd_config "$@" ;;
trust) cmd_trust "$@" ;;
peer) cmd_peer "$@" ;;
vault) cmd_vault "$@" ;;
retire) cmd_retire "$@" ;;
knockout) cmd_knockout "$@" ;;
access) cmd_access ;;
brewmaster | doctor) cmd_brewmaster ;;
report) cmd_report ;;
fleet) cmd_fleet ;;
place) cmd_place "$@" ;;
undo) cmd_undo "$@" ;;
group) cmd_group "$@" ;;
apply) cmd_apply "$@" ;;
search) cmd_search "$@" ;;
share) cmd_share "$@" ;;
admin) cmd_admin "$@" ;;
version | --version | -V) cmd_version ;;
help | -h | --help) cmd_help ;;
*) die "unknown command: $cmd (bier help)" ;;
esac
