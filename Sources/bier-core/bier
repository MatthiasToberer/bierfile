#!/usr/bin/env bash
#
# bier — keeps Brewfiles in sync across several Macs.
#
# Code and data live in two repositories:
#
#   ROOT  the program — public, this is what gets developed
#   DATA  the Brewfiles — private, they reveal what runs on the Macs
#
# Both are recorded in ~/.config/bier/config. Git commands go to DATA
# unless the code itself is meant (bier upgrade, bier version).
#
# Brewfiles/main is the shared inventory, Brewfiles/<host> holds only what
# one Mac has on top of it. Both are valid Brewfiles; together they are
# what a device is supposed to have.
#
# A device file can only add, never subtract. Anything a device must not
# run therefore cannot live in main — it belongs in the device file of
# the Mac that wants it.

set -euo pipefail

# One source for the version number: build.sh reads it from here and
# writes it into the app bundle, bier state reports it, and that is how
# BierMenu notices that it is out of date itself.
BIER_VERSION=0.35.0

# Set by check_code, read by cmd_upgrade: the release tag to move to.
# Empty means "follow the branch" — see check_code for when that applies.
UPGRADE_TAG=""

# --- Environment ------------------------------------------------------------

die() {
	printf 'bier: %s\n' "$*" >&2
	exit 1
}

info() { printf '%s\n' "$*"; }

# "1 entry" rather than "1 entries".
count_word() {
	if [ "$1" = "1" ]; then printf '1 entry'; else printf '%s entries' "$1"; fi
}

CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/bier
CONFIG_FILE=${BIER_CONFIG:-$CONFIG_DIR/config}
PEER_IDENTITY=${BIER_PEER_IDENTITY:-$HOME/.local/share/bier/agent/identity}

# Where the program lives when the config says nothing: the repository root.
# this script. Resolve symlinks by hand, readlink -f is not everywhere on
# macOS.
script_root() {
	local self=$0 link
	while [ -L "$self" ]; do
		link=$(readlink "$self")
		case $link in
		/*) self=$link ;;
		*) self=$(dirname "$self")/$link ;;
		esac
	done
	(cd "$(dirname "$self")/../.." && pwd)
}

# Read one value from the config: lines of the form  key = value
# Comments and blank lines are ignored, the last match wins.
config_get() {
	[ -f "$CONFIG_FILE" ] || return 0
	sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$CONFIG_FILE" |
		sed -E 's/[[:space:]]+$//; s/^"(.*)"$/\1/' |
		tail -1
}

config_set_value() {
	local key=$1 value=$2 tmp
	mkdir -p "$(dirname "$CONFIG_FILE")"
	[ -f "$CONFIG_FILE" ] || write_config
	tmp=$(mktemp "$(dirname "$CONFIG_FILE")/config.XXXXXX")
	awk -v key="$key" -v value="$value" '
		BEGIN { written = 0 }
		$0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
			if (!written) print key " = " value
			written = 1
			next
		}
		{ print }
		END { if (!written) print key " = " value }
	' "$CONFIG_FILE" >"$tmp"
	mv "$tmp" "$CONFIG_FILE"
}

write_config() {
	mkdir -p "$(dirname "$CONFIG_FILE")"
	cat >"$CONFIG_FILE" <<EOF
# Configuration for bier. Created on first run.

# Where the program lives.
root = $(script_root)

# Where your Brewfiles live — your own, private repository. They reveal
# which software runs on your Macs and therefore do not belong in the
# public program repository. Set it up with install.sh.
# data = $HOME/bierdata

# Device name; decides which file under Brewfiles/ belongs to this Mac.
host = $(hostname -s)

# Where the plain files of the vault live. Outside any repository, so
# that nothing can commit them by accident. Only the encrypted copies
# under Safe/ in the data repository ever leave this Mac.
vault = $HOME/.bierfilevault
EOF
	info "Config created: $CONFIG_FILE"
}

if [ ! -f "$CONFIG_FILE" ]; then
	write_config
fi

# Precedence: environment variable, then config, then default.
ROOT=${BIER_ROOT:-$(config_get root)}
ROOT=${ROOT:-$(script_root)}
case $ROOT in
"~/"*) ROOT=$HOME/${ROOT#\~/} ;;
esac

# Where the Brewfiles live.
#
# Deliberately no fallback to the code directory: whoever clones the
# public repository would otherwise get their inventory written into it —
# and that inventory is exactly what must not be published. Empty means
# "not set up yet", and need_repo trips over it with instructions.
#
# The one exception is an older setup where code and data lived together;
# that is recognisable by the Brewfiles folder, which a fresh clone never
# has.
# Where a remembered signing key lives, next to the config that names
# where it came from.
SIGNERS_FILE=$(dirname "$CONFIG_FILE")/allowed_signers
SIGNERS_URL_FILE=$SIGNERS_FILE.url
# The agent is part of Bier itself, so it is built only from the same signed
# release tag that authorises an upgrade of the command-line program.
RELEASE_TRUST_URL=${BIER_RELEASE_TRUST_URL:-https://bier.uber.space/bier/allowed_signers}
# Peers describe reachable Macs only. They deliberately live next to the
# local configuration rather than in the Brewfile repository: knowing which
# machines may be contacted is not an inventory change to be synchronised.
PEERS_FILE=$(dirname "$CONFIG_FILE")/peers
PEER_PORT=${BIER_PEER_PORT:-53991}
PEER_CLIENT=${BIER_PEER_CLIENT:-$ROOT/Sources/bier-peer/build/bier-peer}
PAIRING_OFFER=$HOME/.local/share/bier/agent/state/pairing-offer.json
LOCAL_PEER_SIGNERS=$HOME/.local/share/bier/agent/peer_signers

DATA=${BIER_DATA:-$(config_get data)}
if [ -z "$DATA" ] && [ -d "$ROOT/Brewfiles" ]; then
	DATA=$ROOT
fi
case $DATA in
"~/"*) DATA=$HOME/${DATA#\~/} ;;
esac

HOST=${BIER_HOST:-$(config_get host)}
HOST=${HOST:-$(hostname -s)}

INVENTORY_MODE=${BIER_INVENTORY:-$(config_get inventory)}
INVENTORY_MODE=${INVENTORY_MODE:-automatic}
case $INVENTORY_MODE in
automatic | manual) ;;
*) die "inventory must be 'automatic' or 'manual' in $CONFIG_FILE" ;;
esac

BREW_DIR=$DATA/Brewfiles

# Everything that is not a Brewfile. The plain files live outside any
# repository on purpose: a .gitignore is a rule that can be got wrong,
# a different directory is a fact. Only the encrypted copies travel.
VAULT=${BIER_VAULT:-$(config_get vault)}
VAULT=${VAULT:-$HOME/.bierfilevault}
case $VAULT in
"~/"*) VAULT=$HOME/${VAULT#\~/} ;;
esac
SAFE_DIR=$DATA/Safe
HOST_FILE=$BREW_DIR/$HOST
MAIN_FILE=$BREW_DIR/main

# Temporary files: one directory for the whole run, cleaned up on exit.
#
# Two traps I have fallen into here. A "trap ... RETURN" per function does
# not work: the trap stays armed and fires again when the *calling*
# function returns — by then the local variable is gone and set -u aborts.
# And creating the directory lazily inside tmpfile does not work either:
# tmp=$(tmpfile) runs in a subshell, the assignment to BIER_TMP evaporates
# there and the EXIT trap deletes the directory right away. So: here,
# once per invocation.
BIER_TMP=$(mktemp -d -t bier)
trap 'rm -rf "$BIER_TMP"' EXIT
tmpfile() { mktemp "$BIER_TMP/XXXXXX"; }

need_brew() {
	command -v brew >/dev/null 2>&1 || die "Homebrew not found"
}

# Guards against a wrong config entry creating folders somewhere — and
# catches the case where somebody cloned the program but does not own a
# repository for their Brewfiles yet. Those do not belong in the public
# program repository: they reveal what is installed on the Macs, and a
# person who cloned the program has no write access here anyway.
need_repo() {
	if [ -n "$DATA" ] && [ -d "$DATA/.git" ]; then
		return 0
	fi
	if [ -z "$DATA" ] || [ "$DATA" = "$ROOT" ]; then
		die "No repository of your own set up for your Brewfiles yet.

     The inventory of your Macs belongs in a private repository that is
     yours — not here, where the program lives.

     Set it up:  $ROOT/install.sh"
	fi
	die "no git repository at $DATA

     Does \"data\" in $CONFIG_FILE point at the right path?
     Set it up again:  $ROOT/install.sh"
}

# For commands that work on the code rather than on the data.
need_code() {
	[ -d "$ROOT/.git" ] ||
		die "no git repository at $ROOT — check \"root\" in $CONFIG_FILE"
}

# Print the entries of a Brewfile normalised: 'kind "name"', sorted.
# Comment lines and options (args:, id: …) are dropped.
entries() {
	[ -f "$1" ] || return 0
	# No match is not an error — an empty file is a valid state. Without
	# the || true, pipefail drags every assignment down with it.
	{ grep -E '^[[:space:]]*(tap|brew|cask|mas|vscode)[[:space:]]+"' "$1" || true; } |
		sed -E 's/^[[:space:]]*([a-z]+)[[:space:]]+"([^"]+)".*/\1 "\2"/' |
		sort -u
}

# A Brewfile is Ruby, and "brew bundle" evaluates it. Anything in it
# that is not an entry is therefore a program somebody put there — and
# "entries" above would not show it, because it reads only the front of
# a line: brew "wget"; system("…") is displayed as plain brew "wget".
#
# So the whole line has to fit. Options are allowed by name, and
# "postinstall" is deliberately not among them: its value is a shell
# command. A trailing comment is fine — nothing can hide behind a #,
# not even a quote.
brewfile_grammar() {
	local name='"[^"]*"'
	local key='(id|trusted|args|link|greedy|require_sha|conflicts_with|restart_service|start_service)'
	local value='(true|false|nil|[0-9]+|"[^"]*"|\[[^]]*\]|\{[^}]*\})'
	local opt="([[:space:]]*,[[:space:]]*$key:[[:space:]]*$value)"
	printf '%s%s%s' \
		'^[[:space:]]*(tap|brew|cask|mas|vscode)[[:space:]]+' \
		"$name$opt*[[:space:]]*(#.*)?\$" \
		'|^[[:space:]]*(#.*)?$'
}

# The lines of a Brewfile that are not entries, numbered.
foreign_lines() {
	[ -f "$1" ] || return 0
	grep -nvE "$(brewfile_grammar)" "$1" || true
}

# Refuses to hand a file to "brew bundle", which would run it.
verify_brewfile() {
	local bad
	bad=$(foreign_lines "$1")
	[ -z "$bad" ] || die "$1 holds lines that are not entries:

$(printf '%s\n' "$bad" | sed 's/^/       /')

     A Brewfile is Ruby and \"brew bundle\" runs it, so these would be
     executed on this Mac — and no bier command shows them, because
     they only have to look like an entry at the front of the line.

     Take them out. If you put them there yourself and mean it, run
     brew bundle install --file \"$1\" by hand."
}

# What a device is supposed to have: its device file plus main. Only
# together do the two describe what should run on that Mac.
host_entries() {
	{
		entries "$BREW_DIR/$1"
		entries "$MAIN_FILE"
	} | sort -u
}

own_entries() { host_entries "$HOST"; }

# Every entry recorded anywhere in the repository — main and each device.
all_entries() {
	local f
	{
		for f in "$BREW_DIR"/*; do
			[ -f "$f" ] || continue
			entries "$f"
		done
	} | sort -u
}

# All devices in Brewfiles/ — every file except main is a device.
host_list() {
	[ -d "$BREW_DIR" ] || return 0
	for f in "$BREW_DIR"/*; do
		[ -f "$f" ] || continue
		name=$(basename "$f")
		if [ "$name" != "main" ]; then
			printf '%s\n' "$name"
		fi
	done
}

# A peer may be an SSH host alias, a DNS name, an address, or user@host. Do
# not pass a value beginning with '-' to ssh, and keep the persisted format
# one name per line so it remains auditable and easy to repair by hand.
peer_name_ok() {
	[ -n "${1:-}" ] && printf '%s\n' "$1" |
		grep -Eq '^[A-Za-z0-9][A-Za-z0-9._:@-]*$'
}

peer_list() {
	[ -f "$PEERS_FILE" ] || return 0
	grep -E '^[A-Za-z0-9][A-Za-z0-9._:@-]*$' "$PEERS_FILE" | sort -u
}

peer_remember() {
	local peer=$1
	if peer_list | grep -qxF "$peer"; then
		return 0
	fi
	mkdir -p "$(dirname "$PEERS_FILE")"
	printf '%s\n' "$peer" >>"$PEERS_FILE"
}

peer_forget() {
	local peer=$1 tmp
	if ! peer_list | grep -qxF "$peer"; then
		return 0
	fi
	tmp=$(tmpfile)
	peer_list | grep -vxF "$peer" >"$tmp" || true
	mkdir -p "$(dirname "$PEERS_FILE")"
	mv "$tmp" "$PEERS_FILE"
}

# Every SSH/SCP call in the peer setup path is deliberately non-interactive
# and refuses unknown host keys. A peer name was checked before it reaches
# these helpers, so it cannot be interpreted as an option.
peer_ssh() {
	ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=yes "$@"
}

peer_scp() {
	scp -q -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=yes "$@"
}

peer_http_request() {
	local method=$1 path=$2 peer=$3 body=$4 response=$5
	local key=$PEER_IDENTITY network_host request signature time nonce body_hash
	[ -r "$key" ] || return 1
	network_host=${peer##*@}
	time=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	nonce=$(uuidgen | tr '[:upper:]' '[:lower:]')
	body_hash=$(shasum -a 256 "$body" | awk '{print $1}') || return 1
	request=$(tmpfile)
	printf '%s\n%s\n%s\n%s\n%s\n%s\n' "$method" "$path" "$HOST" "$time" "$nonce" "$body_hash" >"$request"
	ssh-keygen -q -Y sign -f "$key" -n bier-peer "$request" || return 1
	signature=$(base64 <"$request.sig" | tr -d '\n')
	curl -fsS --max-time 20 -X "$method" -H 'Content-Type: application/json' \
		-H "X-Bier-Peer: $HOST" -H "X-Bier-Time: $time" -H "X-Bier-Nonce: $nonce" \
		-H "X-Bier-Signature: $signature" --data-binary @"$body" \
		"http://$network_host:$PEER_PORT$path" >"$response"
}

peer_is_self() {
	local host=${1%.} short
	short=${host%%.*}
	[ "$short" = "$HOST" ]
}

peer_authorize() {
	local peer=$1 key=$HOME/.ssh/id_ed25519.pub

	info "1/4  Connecting to $peer …"
	if peer_ssh "$peer" true; then
		info "     SSH access is ready."
		return 0
	fi

	[ -r "$key" ] || die "SSH to $peer needs a public key on this Mac.

     Create one once with:
     ssh-keygen -t ed25519"

	info "     First connection: verify the host fingerprint and enter the password once."
	cat "$key" | ssh -o BatchMode=no -o ConnectTimeout=10 -o StrictHostKeyChecking=ask "$peer" '
		set -eu
		umask 077
		mkdir -p "$HOME/.ssh"
		touch "$HOME/.ssh/authorized_keys"
		while IFS= read -r key; do
			if ! grep -qxF "$key" "$HOME/.ssh/authorized_keys"; then
				printf "%s\n" "$key" >>"$HOME/.ssh/authorized_keys"
				mkdir -p "$HOME/.local/share/bier/agent"
				printf "%s\n" "$key" >"$HOME/.local/share/bier/agent/ssh-key-installed"
			fi
		done
	' || die "could not authorise this Mac for SSH on $peer"

	peer_ssh "$peer" true ||
		die "SSH key authorisation on $peer did not work"
	info "     SSH access is ready."
}

# --- Helpers -----------------------------------------------------------------

# Print the entries of $1 that are not already in $2 — in their original
# spelling, options included (mas … id:, tap … URL). Comments are dropped:
# a delta file would otherwise carry descriptions of packages it no longer
# lists.
delta() {
	local base_keys line key
	# On the very first dump the device file does not exist yet. Without
	# this line grep complains, and the first impression of bier is an
	# error message.
	[ -f "$1" ] || return 0
	base_keys=$(entries "$2")
	{ grep -E '^[[:space:]]*(tap|brew|cask|mas|vscode)[[:space:]]+"' "$1" || true; } |
		while IFS= read -r line; do
			key=$(printf '%s\n' "$line" |
				sed -E 's/^[[:space:]]*([a-z]+)[[:space:]]+"([^"]+)".*/\1 "\2"/')
			if ! printf '%s\n' "$base_keys" | grep -qxF "$key"; then
				printf '%s\n' "$line"
			fi
		done
}

# Defuse special characters in package names (python@3.12, gtk+) for use
# in a regular expression.
rx_quote() {
	printf '%s' "$1" | sed -E 's/[][\.^$*+?(){}|]/\\&/g'
}

# Was this entry ever in a Brewfile? Then it is not an addition but a
# removal made on another device. The git history is the only place where
# that difference is recorded.
was_tracked() {
	# If the entry is still listed somewhere in the repository it is not
	# orphaned — it simply runs on another device. Without this check,
	# bier reports a package picked up from the other Mac as "removed
	# elsewhere".
	if all_entries | grep -qxF "$1"; then
		return 1
	fi
	git -C "$DATA" log --format=%h -1 -S"$1" -- Brewfiles/ 2>/dev/null | grep -q .
}

# Splits "installed but not recorded" into NEW and STALE.
classify_add() {
	local entry
	printf '%s\n' "$1" | while IFS= read -r entry; do
		[ -n "$entry" ] || continue
		if was_tracked "$entry"; then
			printf 'STALE\t%s\n' "$entry"
		else
			printf 'NEW\t%s\n' "$entry"
		fi
	done
}

# Removes an entry from every Brewfile — including the comment line that
# "brew bundle dump" writes above it.
strip_entry() {
	local kind=$1 name=$2 rx f tmp
	rx="^[[:space:]]*$(rx_quote "$kind")[[:space:]]+\"([^\"]*/)?$(rx_quote "$name")\""
	for f in "$BREW_DIR"/*; do
		[ -f "$f" ] || continue
		tmp=$(tmpfile)
		awk -v re="$rx" '
			/^[[:space:]]*#/ { pending = pending $0 "\n"; next }
			$0 ~ re          { pending = ""; next }
			                 { printf "%s", pending; pending = ""; print }
			END              { printf "%s", pending }
		' "$f" >"$tmp"
		mv "$tmp" "$f"
	done
}

# Works out how a package was installed. The order is the crux: a short
# name like "sikarugir" matches both the tap "sikarugir-app/sikarugir" and
# the cask "sikarugir-app/sikarugir/sikarugir". So: exact matches first,
# then ask Homebrew, and taps last.
kind_of() {
	local name=$1 rx kind
	rx="^[[:space:]]*(tap|brew|cask|mas|vscode)[[:space:]]+\"$(rx_quote "$name")\""
	kind=$({ grep -hE "$rx" "$BREW_DIR"/* 2>/dev/null || true; } |
		head -1 | sed -E 's/^[[:space:]]*([a-z]+).*/\1/')
	if [ -n "$kind" ]; then
		printf '%s' "$kind"
		return 0
	fi

	# What is actually installed is something Homebrew knows better than
	# the file does.
	if brew list --formula --full-name 2>/dev/null | grep -qxF "$name"; then
		printf 'brew'
		return 0
	fi
	if brew list --cask 2>/dev/null | grep -qxF "$name"; then
		printf 'cask'
		return 0
	fi
	if brew tap 2>/dev/null | grep -qxF "$name"; then
		printf 'tap'
		return 0
	fi

	# Last resort: the short name of a fully qualified entry, taps excluded.
	rx="^[[:space:]]*(brew|cask|mas|vscode)[[:space:]]+\"[^\"]*/$(rx_quote "$name")\""
	{ grep -hE "$rx" "$BREW_DIR"/* 2>/dev/null || true; } |
		head -1 | sed -E 's/^[[:space:]]*([a-z]+).*/\1/' | tr -d '\n'
}

# Uninstalls a package. mas cannot do that without help, so that stays
# manual — better to say so than to pretend.
uninstall_one() {
	local kind=$1 name=$2
	case $kind in
	brew) brew uninstall "$name" ;;
	cask) brew uninstall --cask "$name" ;;
	tap) brew untap "$name" ;;
	vscode) code --uninstall-extension "$name" ;;
	mas)
		info "  $name came from the App Store — please remove it from"
		info "  /Applications by hand. I will take it out of the Brewfiles."
		;;
	*) die "unknown kind for $name" ;;
	esac
}

# The original line behind a normalised entry, so that options such as
# "id:" or "trusted:" survive being moved around.
find_line() {
	local key=$1 kind name rx f line
	kind=${key%% *}
	name=$(printf '%s' "$key" | sed -E 's/^[a-z]+ "([^"]+)"$/\1/')
	rx="^[[:space:]]*$(rx_quote "$kind")[[:space:]]+\"$(rx_quote "$name")\""
	for f in "$BREW_DIR"/*; do
		[ -f "$f" ] || continue
		line=$({ grep -m1 -E "$rx" "$f" || true; })
		if [ -n "$line" ]; then
			printf '%s\n' "$line"
			return 0
		fi
	done
	printf '%s\n' "$key"
}

# Which devices list a given entry?
hosts_with() {
	local h out=""
	for h in $(host_list); do
		if entries "$BREW_DIR/$h" | grep -qxF "$1"; then
			out="$out $h"
		fi
	done
	printf '%s' "${out# }"
}

# "1 3-5, 8" into single, validated numbers.
expand_selection() {
	local input=$1 max=$2 tok a b i
	{
		for tok in $(printf '%s' "$input" | tr ',' ' '); do
			case $tok in
			*[!0-9-]*) die "not a number: $tok" ;;
			*-*)
				a=${tok%%-*}
				b=${tok##*-}
				if [ -z "$a" ] || [ -z "$b" ]; then die "invalid range: $tok"; fi
				i=$a
				while [ "$i" -le "$b" ]; do
					printf '%s\n' "$i"
					i=$((i + 1))
				done
				;;
			*) printf '%s\n' "$tok" ;;
			esac
		done
	} | sort -un | while read -r i; do
		if [ "$i" -ge 1 ] && [ "$i" -le "$max" ]; then
			printf '%s\n' "$i"
		fi
	done
}

# Moves entries between main and the device files.
#
#   bier take               what other devices have on top, to here or to main
#   bier take --from-main   hand something from main to a single device
#
# Into main means: added to main and removed from every device file,
# because main applies to all and listing it twice would be wrong. Into
# the own file means: added here only, the others keep their entry.
cmd_take() {
	need_repo
	local from_main=no
	if [ "${1:-}" = "--from-main" ]; then from_main=yes; fi

	local listing n entry
	listing=$(tmpfile)
	if [ "$from_main" = yes ]; then
		entries "$MAIN_FILE" >"$listing"
	else
		{
			local h
			for h in $(host_list); do
				if [ "$h" != "$HOST" ]; then
					entries "$BREW_DIR/$h"
				fi
			done
		} | sort -u >"$listing"
	fi

	if [ ! -s "$listing" ]; then
		if [ "$from_main" = yes ]; then
			info "Brewfiles/main is empty."
		else
			info "No other device has anything on top of main."
		fi
		return 0
	fi

	if [ "$from_main" = yes ]; then
		info "In Brewfiles/main — pick one to hand it to a device:"
	else
		info "What other devices have on top of main:"
	fi
	info ""
	n=0
	while IFS= read -r entry; do
		n=$((n + 1))
		if [ "$from_main" = yes ]; then
			printf '  %2s  %s\n' "$n" "$entry"
		else
			printf '  %2s  %-44s %s\n' "$n" "$entry" "$(hosts_with "$entry")"
		fi
	done <"$listing"

	info ""
	printf 'Numbers (e.g. 1 3-5), empty = cancel: '
	read -r sel || sel=""
	if [ -z "$sel" ]; then
		info "Cancelled."
		return 0
	fi
	local picks
	picks=$(expand_selection "$sel" "$n")
	if [ -z "$picks" ]; then
		info "Nothing selected."
		return 0
	fi

	# Decide on the destination.
	local target answer i
	if [ "$from_main" = yes ]; then
		if [ -z "$(host_list)" ]; then
			die "there is no device file yet — run 'bier dump' first"
		fi
		info ""
		info "Hand it to which device?"
		i=0
		for h in $(host_list); do
			i=$((i + 1))
			printf '  %2s  %s\n' "$i" "$h"
		done
		printf 'Number: '
		read -r answer || answer=""
		target=$(host_list | sed -n "${answer}p")
		[ -n "$target" ] || die "no device with number $answer"
	else
		info ""
		printf 'Where to?  [m] into main, for all devices   [h] only %s   [c] cancel: ' "$HOST"
		read -r answer || answer=""
		case $answer in
		m | M) target=main ;;
		h | H) target=$HOST ;;
		*)
			info "Cancelled."
			return 0
			;;
		esac
	fi

	# Show the plan before anything happens.
	local key line
	info ""
	info "Plan:"
	for i in $picks; do
		key=$(sed -n "${i}p" "$listing")
		info "  $key"
		if [ "$from_main" = yes ]; then
			info "    + Brewfiles/$target"
			info "    - Brewfiles/main"
		elif [ "$target" = main ]; then
			info "    + Brewfiles/main"
			for h in $(hosts_with "$key"); do
				info "    - Brewfiles/$h"
			done
		else
			info "    + Brewfiles/$target   (the others keep their entry)"
		fi
	done

	info ""
	printf 'Apply and push? [y/N] '
	read -r answer || answer=""
	case $answer in
	j | J | y | Y) ;;
	*)
		info "Cancelled."
		return 0
		;;
	esac

	local taken kind name
	taken=$(tmpfile)
	for i in $picks; do
		key=$(sed -n "${i}p" "$listing")
		line=$(find_line "$key")
		kind=${key%% *}
		name=$(printf '%s' "$key" | sed -E 's/^[a-z]+ "([^"]+)"$/\1/')
		printf '%s\n' "$line" >>"$taken"

		if [ "$from_main" = yes ]; then
			strip_entry "$kind" "$name"
			printf '%s\n' "$line" >>"$BREW_DIR/$target"
		elif [ "$target" = main ]; then
			strip_entry "$kind" "$name"
			printf '%s\n' "$line" >>"$MAIN_FILE"
		else
			printf '%s\n' "$line" >>"$BREW_DIR/$target"
		fi
	done

	if [ "$from_main" = yes ]; then
		publish "$HOST: $(count_word "$(wc -l <"$taken" | tr -d ' ')") from main to $target"
	else
		publish "$HOST: took $(count_word "$(wc -l <"$taken" | tr -d ' ')") into $target"
	fi

	# Install only if this Mac is supposed to have them afterwards.
	if [ "$target" = main ] || [ "$target" = "$HOST" ]; then
		info ""
		printf 'Install now? [y/N] '
		read -r answer || answer=""
		case $answer in
		j | J | y | Y)
			verify_brewfile "$taken"
			brew bundle install --file "$taken"
			;;
		*) info "Not installed — bier status reports it as missing, bier install fetches it." ;;
		esac
	fi
}

# Fetches from the server and resolves conflicts on its own.
#
# .gitattributes makes git union-merge the Brewfiles, which covers the
# normal case. If a conflict survives anyway, we do the same by hand:
# Brewfiles are lists, keeping both sides is right. Duplicate lines do not
# bother brew and disappear with the next dump.
#
# Nobody should have to know git commands to keep their Macs in step.
resolve_union() {
	local open f
	open=$(git -C "$DATA" diff --name-only --diff-filter=U 2>/dev/null || true)
	[ -n "$open" ] || return 1

	while [ -n "$open" ]; do
		# Only Brewfiles get merged without asking.
		if printf '%s\n' "$open" | grep -qv '^Brewfiles/'; then
			return 1
		fi
		printf '%s\n' "$open" | while IFS= read -r f; do
			[ -n "$f" ] || continue
			sed -i '' -e '/^<<<<<<< /d' -e '/^=======$/d' -e '/^>>>>>>> /d' "$DATA/$f"
		done
		git -C "$DATA" add Brewfiles
		GIT_EDITOR=true git -C "$DATA" rebase --continue >/dev/null 2>&1 || return 1
		open=$(git -C "$DATA" diff --name-only --diff-filter=U 2>/dev/null || true)
	done
	return 0
}

fetch_rebase() {
	local out
	if out=$(git -C "$DATA" pull --rebase --autostash 2>&1); then
		return 0
	fi

	if printf '%s' "$out" | grep -q 'CONFLICT'; then
		if resolve_union; then
			info "Both Macs had changes — merged."
			return 0
		fi
	fi

	# Not resolvable: roll everything back so nothing is left half done.
	git -C "$DATA" rebase --abort 2>/dev/null || true
	printf '%s\n' "$out" >&2
	die "Syncing with the server failed. Nothing was changed."
}

# Commits, fetches and pushes. Even without local changes it syncs,
# otherwise you miss the commits made on the other device.
publish() {
	local branch remote
	# Only the Brewfiles. "git add -A" would sweep up changes to the
	# script or the README as well and hide them under an inventory
	# message — that happened to me exactly once.
	git -C "$DATA" add Brewfiles
	[ ! -d "$SAFE_DIR" ] || git -C "$DATA" add Safe
	if git -C "$DATA" diff --cached --quiet; then
		info "Nothing to commit."
	else
		git -C "$DATA" commit -q -m "$1"
		info "Commit: $1"
	fi

	# A freshly created private repository has no branch to pull yet.
	# Publish the first local branch directly and make it its upstream;
	# every later call takes the normal fetch/rebase path below.
	branch=$(git -C "$DATA" branch --show-current)
	[ -n "$branch" ] || die "the data repository has no current branch"
	if ! git -C "$DATA" remote get-url origin >/dev/null 2>&1; then
		info "Saved in the local Bier history."
		return 0
	fi
	if ! remote=$(git -C "$DATA" ls-remote --heads origin "$branch" 2>&1); then
		printf '%s\n' "$remote" >&2
		die "the data server could not be reached"
	fi
	if [ -z "$remote" ]; then
		git -C "$DATA" push --quiet --set-upstream origin "HEAD:$branch" ||
			die "could not create the first branch on the data server"
		info "First inventory pushed to origin."
		return 0
	fi

	fetch_rebase
	git -C "$DATA" push --quiet
	info "In sync with origin."
}

# --- Commands ----------------------------------------------------------------

cmd_peer_add() {
	local peer=${1:-}
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer add <host>'
	if peer_list | grep -qxF "$peer"; then
		info "Peer already known: $peer"
		return 0
	fi
	peer_remember "$peer"
	info "Peer added: $peer"
}

cmd_peer_list() {
	local peers n=0 peer
	peers=$(peer_list)
	if [ -z "$peers" ]; then
		info 'No peers known. Add one: bier peer add <host>'
		return 0
	fi
	info 'Known peers:'
	while IFS= read -r peer; do
		[ -n "$peer" ] || continue
		n=$((n + 1))
		printf '  %2s  %s\n' "$n" "$peer"
	done <<EOF
$peers
EOF
}

cmd_peer_remove() {
	local peer=${1:-} tmp
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer remove <host>'
	peer_list | grep -qxF "$peer" || die "no peer called $peer"
	peer_forget "$peer"
	info "Peer removed: $peer"
}

cmd_peer_check() {
	local peer=${1:-}
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer check <host>'
	info "Checking SSH to $peer …"
	peer_ssh "$peer" true || die "cannot reach $peer over SSH"
	info "SSH to $peer works."
}

cmd_peer_hello() {
	local peer=${1:-} key=$PEER_IDENTITY body response output
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer hello <host>'
	[ -r "$key" ] || die "no SSH identity at $key"
	if [ -x "$PEER_CLIENT" ]; then
		info "Checking authenticated Bier Agent access to $peer …"
		"$PEER_CLIENT" hello "$peer" --local "$HOST" --identity "$key" --port "$PEER_PORT" ||
			die "the Bier Agent on $peer did not accept this Mac"
		return 0
	fi
	body=$(tmpfile)
	response=$(tmpfile)
	info "Checking authenticated Bier Agent access to $peer …"
	peer_http_request GET /v1/peer/hello "$peer" "$body" "$response" ||
		die "the Bier Agent on $peer did not accept this Mac"
	output=$(cat "$response")
	printf '%s' "$output" | grep -q '"status":"peer-ok"' ||
		die "the Bier Agent on $peer sent an invalid peer response"
	info "Bier Agent on $peer accepted $HOST as a peer."
}

peer_pair_address_ok() {
	case $1 in
	'' | [!a-zA-Z0-9]* | *[!a-zA-Z0-9.-]*) return 1 ;;
	esac
}

cmd_peer_offer() {
	local address="$(hostname -s).local"
	if [ $# -ne 0 ]; then
		[ $# -eq 2 ] && [ "$1" = --address ] && peer_pair_address_ok "$2" ||
			die 'usage: bier peer offer [--address <own-host>]'
		address=$2
	fi
	[ -x "$HOME/.local/share/bier/agent/bin/bier-agent" ] || die "the local Bier agent is not installed; run install.sh"
	[ -r "$PEER_IDENTITY.pub" ] || die "the local Bier peer identity is missing; run install.sh"
	local code expires tmp shown
	code=$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]')
	expires=$(date -v+10M +%s)
	mkdir -p "$(dirname "$PAIRING_OFFER")"
	tmp=$(mktemp "$(dirname "$PAIRING_OFFER")/pairing-offer.XXXXXX")
	printf '{"version":1,"code":"%s","expires":%s,"attempts":0}\n' "$code" "$expires" >"$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$PAIRING_OFFER"
	shown=$(printf '%s' "$code" | sed -E 's/(.{4})/\1-/g; s/-$//')
	info "Pairing is open for 10 minutes."
	info "On the other Mac run:  bier peer pair $address"
	info "One-time code: $shown"
}

cmd_peer_pair() {
	local peer=${1:-} code code_file
	local -a address_args=()
	{ [ $# -eq 1 ] || [ $# -eq 3 ]; } && peer_name_ok "$peer" ||
		die 'usage: bier peer pair <host> [--address <own-host>]'
	if [ $# -eq 3 ]; then
		[ "$2" = --address ] && peer_pair_address_ok "$3" ||
			die 'usage: bier peer pair <host> [--address <own-host>]'
		address_args=(--address "$3")
	fi
	[ -x "$PEER_CLIENT" ] || die "the Swift peer client is not built; run install.sh"
	[ -r "$PEER_IDENTITY" ] && [ -r "$PEER_IDENTITY.pub" ] || die "the local Bier peer identity is missing; run install.sh"
	code=${BIER_PAIR_CODE:-}
	if [ -z "$code" ]; then
		printf 'One-time code from %s: ' "$peer"
		read -r code || code=
	fi
	[ -n "$code" ] || die "no pairing code entered"
	code_file=$(tmpfile)
	printf '%s\n' "$code" >"$code_file"
	chmod 600 "$code_file"
	info "Pairing with $peer …"
	"$PEER_CLIENT" pair "$peer" ${address_args[@]+"${address_args[@]}"} --local "$HOST" --identity "$PEER_IDENTITY" --code-file "$code_file" --peer-signers "$LOCAL_PEER_SIGNERS" --port "$PEER_PORT" ||
		die "pairing with $peer failed"
	peer_remember "$peer"
	info "Peer added: $peer"
	if [ -n "$DATA" ] && [ -d "$DATA/.git" ]; then
		info "Checking whether the new peer needs this Mac's Bier data …"
		"$PEER_CLIENT" seed-if-pristine "$peer" --local "$HOST" --identity "$PEER_IDENTITY" --data "$DATA" --port "$PEER_PORT" ||
			die "paired successfully, but could not initialise the peer data"
		# A peer that already recorded its own inventory keeps it, and
		# only a sync makes the two histories one.
		info "Synchronising Bier data with $peer …"
		"$PEER_CLIENT" sync "$peer" --local "$HOST" --identity "$PEER_IDENTITY" --data "$DATA" --port "$PEER_PORT" ||
			die "paired successfully, but could not synchronise with $peer; try again with: bier peer sync $peer"
	fi
}

peer_snapshot_files() {
	local output=$1 root=${2:-$DATA} top absolute relative
	: >"$output"
	if [ -L "$root/.gitattributes" ]; then
		die 'the Bier data snapshot contains a symbolic link: .gitattributes'
	fi
	[ ! -f "$root/.gitattributes" ] || printf '%s\n' .gitattributes >>"$output"
	for top in Brewfiles Safe; do
		[ -e "$root/$top" ] || continue
		if find "$root/$top" -type l -print -quit | grep -q .; then
			die "the Bier data snapshot contains a symbolic link under $top"
		fi
		while IFS= read -r absolute; do
			relative=${absolute#"$root/"}
			printf '%s\n' "$relative" | grep -Eq '^(Brewfiles|Safe)/[A-Za-z0-9._@/+:-]+$' ||
				die "unsupported path in the Bier data snapshot: $relative"
			printf '%s\n' "$relative" >>"$output"
		done < <(find "$root/$top" -type f -print | LC_ALL=C sort)
	done
}

peer_snapshot_manifest() {
	local snapshot=$1 files=$2 body=$3 path file bytes hash comma=
	printf '{"id":"%s","manifest":{"version":1,"entries":[' "$snapshot" >"$body"
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		file=$DATA/$path
		bytes=$(wc -c <"$file" | tr -d ' ')
		[ "$bytes" -le 1073741824 ] || die "Bier data file is larger than 1 GiB: $path"
		hash=$(shasum -a 256 "$file" | awk '{print $1}')
		printf '%s{"path":"%s","bytes":%s,"sha256":"%s"}' "$comma" "$path" "$bytes" "$hash" >>"$body"
		comma=,
	done <"$files"
	printf ']}}' >>"$body"
}

peer_send_snapshot() {
	local peer=$1 snapshot=$2 files=$3 begin=$4 response=$5
	local path file bytes offset first raw chunk_bytes encoded put commit
	peer_http_request POST /v1/peer/snapshot/begin "$peer" "$begin" "$response" || return 1
	grep -q '"status":"snapshot-ready"' "$response" || return 1
	raw=$(tmpfile)
	put=$(tmpfile)
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		file=$DATA/$path
		bytes=$(wc -c <"$file" | tr -d ' ')
		offset=0
		first=yes
		while [ "$offset" -lt "$bytes" ] || [ "$first" = yes ]; do
			dd if="$file" of="$raw" bs=32768 count=1 skip=$((offset / 32768)) 2>/dev/null
			chunk_bytes=$(wc -c <"$raw" | tr -d ' ')
			[ "$bytes" = 0 ] || [ "$chunk_bytes" -gt 0 ] || return 1
			encoded=$(base64 <"$raw" | tr -d '\n')
			printf '{"id":"%s","path":"%s","offset":%s,"data":"%s"}' "$snapshot" "$path" "$offset" "$encoded" >"$put"
			peer_http_request POST /v1/peer/snapshot/put "$peer" "$put" "$response" || return 1
			grep -q '"status":"snapshot-staged"' "$response" || return 1
			offset=$((offset + chunk_bytes))
			first=no
		done
	done <"$files"
	commit=$(tmpfile)
	printf '{"id":"%s"}' "$snapshot" >"$commit"
	peer_http_request POST /v1/peer/snapshot/commit "$peer" "$commit" "$response" || return 1
	grep -q '"status":"snapshot-committed"' "$response"
}

peer_fetch_snapshot() {
	local peer=$1 destination=$2 body response count index path bytes hash target offset length chunk_bytes actual
	body=$(tmpfile)
	response=$(tmpfile)
	peer_http_request GET /v1/peer/manifest "$peer" "$body" "$response" || return 1
	[ "$(/usr/bin/plutil -extract version raw -o - "$response" 2>/dev/null)" = 1 ] || return 1
	count=$(/usr/bin/plutil -extract entries raw -expect array -o - "$response" 2>/dev/null) || return 1
	mkdir -p "$destination"
	index=0
	while [ "$index" -lt "$count" ]; do
		path=$(/usr/bin/plutil -extract "entries.$index.path" raw -expect string -o - "$response" 2>/dev/null) || return 1
		bytes=$(/usr/bin/plutil -extract "entries.$index.bytes" raw -expect integer -o - "$response" 2>/dev/null) || return 1
		hash=$(/usr/bin/plutil -extract "entries.$index.sha256" raw -expect string -o - "$response" 2>/dev/null) || return 1
		printf '%s\n' "$path" | grep -Eq '^(\.gitattributes|(Brewfiles|Safe)/[A-Za-z0-9._@/+:-]+)$' || return 1
		printf '%s\n' "$bytes" | grep -Eq '^[0-9]+$' || return 1
		[ "$bytes" -le 1073741824 ] || return 1
		printf '%s\n' "$hash" | grep -Eq '^[0-9a-f]{64}$' || return 1
		target=$destination/$path
		[ ! -e "$target" ] || return 1
		mkdir -p "$(dirname "$target")"
		: >"$target"
		offset=0
		while [ "$offset" -lt "$bytes" ]; do
			length=$((bytes - offset))
			[ "$length" -le 32768 ] || length=32768
			printf '{"path":"%s","offset":%s,"length":%s}' "$path" "$offset" "$length" >"$body"
			peer_http_request POST /v1/peer/data/read "$peer" "$body" "$response" || return 1
			chunk_bytes=$(wc -c <"$response" | tr -d ' ')
			[ "$chunk_bytes" = "$length" ] || return 1
			cat "$response" >>"$target"
			offset=$((offset + chunk_bytes))
		done
		actual=$(shasum -a 256 "$target" | awk '{print $1}')
		[ "$actual" = "$hash" ] || return 1
		index=$((index + 1))
	done
}

cmd_peer_compare() {
	local peer=${1:-} remote local_files remote_files paths path differences=0
	[ $# -eq 1 ] && peer_name_ok "$peer" || die 'usage: bier peer compare <host>'
	need_repo
	if [ -x "$PEER_CLIENT" ]; then
		info "Reading and verifying Bier data from $peer …"
		"$PEER_CLIENT" compare "$peer" --local "$HOST" --identity "$PEER_IDENTITY" --data "$DATA" --port "$PEER_PORT" ||
			die "could not compare Bier data with $peer"
		return 0
	fi
	remote=$BIER_TMP/peer-data
	info "Reading and verifying Bier data from $peer …"
	peer_fetch_snapshot "$peer" "$remote" || die "could not read a verified Bier data snapshot from $peer"
	local_files=$(tmpfile)
	remote_files=$(tmpfile)
	peer_snapshot_files "$local_files" "$DATA"
	peer_snapshot_files "$remote_files" "$remote"
	paths=$(tmpfile)
	{ cat "$local_files"; cat "$remote_files"; } | LC_ALL=C sort -u >"$paths"
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		if [ ! -f "$DATA/$path" ] || [ ! -f "$remote/$path" ] || ! cmp -s "$DATA/$path" "$remote/$path"; then
			if [ "$differences" = 0 ]; then info 'Data differs:'; fi
			printf '  %s\n' "$path"
			differences=$((differences + 1))
		fi
	done <"$paths"
	if [ "$differences" = 0 ]; then
		info "Bier data is identical on $HOST and $peer."
	else
		info "$differences data file(s) differ. Nothing was changed."
	fi
}

cmd_peer_sync() {
	local peer=${1:-}
	[ $# -eq 1 ] && peer_name_ok "$peer" || die 'usage: bier peer sync <host>'
	need_repo
	[ -r "$PEER_IDENTITY" ] || die "the local Bier peer identity is missing; run install.sh"
	[ -x "$PEER_CLIENT" ] || die "the Swift peer client is not built; run install.sh"
	info "Synchronising Bier data with $peer …"
	"$PEER_CLIENT" sync "$peer" --local "$HOST" --identity "$PEER_IDENTITY" --data "$DATA" --port "$PEER_PORT" ||
		die "could not synchronise Bier data with $peer"
}

peer_seed() {
	local peer=$1 mode=$2 command=seed body response remote snapshot files begin
	[ "$mode" != if-empty ] || command=seed-if-empty
	if [ -x "$PEER_CLIENT" ]; then
		info "Checking and sending Bier data to $peer …"
		"$PEER_CLIENT" "$command" "$peer" --local "$HOST" --identity "$PEER_IDENTITY" --data "$DATA" --port "$PEER_PORT" ||
			die "the Bier data snapshot was not accepted by $peer"
		return 0
	fi
	body=$(tmpfile)
	response=$(tmpfile)
	info "1/3  Checking the Bier data store on $peer …"
	peer_http_request GET /v1/peer/manifest "$peer" "$body" "$response" ||
		die "cannot read the Bier data store on $peer"
	remote=$(cat "$response")
	if ! printf '%s' "$remote" | grep -Eq '"entries"[[:space:]]*:[[:space:]]*\[[[:space:]]*\]'; then
		if [ "$mode" = if-empty ]; then
			info '     Existing peer data was kept unchanged.'
			return 0
		fi
		die "the Bier data store on $peer is not empty; refusing to replace it"
	fi
	info '     The peer is empty.'
	info '2/3  Preparing the local Bier data snapshot …'
	snapshot=$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]')
	files=$(tmpfile)
	begin=$(tmpfile)
	peer_snapshot_files "$files"
	peer_snapshot_manifest "$snapshot" "$files" "$begin"
	info "3/3  Sending the verified snapshot to $peer …"
	peer_send_snapshot "$peer" "$snapshot" "$files" "$begin" "$response" ||
		die "the Bier data snapshot was not accepted by $peer"
	info "Done. $peer now has the Bier data from $HOST."
}

cmd_peer_seed() {
	local peer=${1:-}
	[ $# -eq 1 ] && peer_name_ok "$peer" || die 'usage: bier peer seed <host>'
	need_repo
	[ -r "$PEER_IDENTITY" ] || die "the local Bier peer identity is missing; run install.sh"
	peer_seed "$peer" required
}

# A remote installation adds a LaunchAgent, an agent directory, a remembered
# peer and an SSH connection.  Uninstall reverses each of those changes.  It
# removes only the matching public key, never the remote user's SSH setup.
cmd_peer_uninstall() {
	local peer=${1:-} key=$HOME/.ssh/id_ed25519.pub network_host answer
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer uninstall <host>'
	info "This permanently removes Bier from $peer:"
	info '  - the Bier agent, its files and its LaunchAgent'
	info '  - the remembered peer and saved SSH host key on this Mac'
	info '  - the public SSH key this Mac uses to reach that host'
	info ''
	printf 'Remove it? [y/N] '
	read -r answer || answer=""
	case $answer in
	j | J | y | Y) ;;
	*)
		info 'Cancelled.'
		return 0
		;;
	esac

	info "1/3  Checking SSH access to $peer …"
	peer_ssh "$peer" true || die "cannot reach $peer over SSH"
	info '     SSH access is ready.'
	peer_ssh "$peer" 'mkdir -p "$HOME/.local/share/bier/agent"' ||
		die "cannot prepare Bier removal on $peer"
	if [ -r "$key" ]; then
		peer_scp "$key" "$peer:.local/share/bier/agent/uninstall-key.new" ||
			die "cannot prepare SSH key removal on $peer"
	fi
	info '2/3  Removing the Bier agent and SSH access …'
	peer_ssh "$peer" 'set -e
plist="$HOME/Library/LaunchAgents/com.bier.agent.plist"
legacy_plist="$HOME/Library/LaunchAgents/com.bierkasten.agent.plist"
state_dir="$HOME/.local/share/bier/agent"
legacy_state_dir="$HOME/.local/share/bierkasten"
authorized_keys="$HOME/.ssh/authorized_keys"
launchctl bootout "gui/$(id -u)" "$plist" >/dev/null 2>&1 || true
launchctl bootout "gui/$(id -u)" "$legacy_plist" >/dev/null 2>&1 || true
rm -f "$plist"
rm -f "$legacy_plist"

if [ -f "$authorized_keys" ]; then
  for key_file in "$state_dir/ssh-key-installed" "$legacy_state_dir/ssh-key-installed" "$state_dir/uninstall-key.new"; do
    [ -s "$key_file" ] || continue
    tmp=$(mktemp "$HOME/.ssh/authorized_keys.bier.XXXXXX")
    grep -vxFf "$key_file" "$authorized_keys" >"$tmp" || true
    mv "$tmp" "$authorized_keys"
  done
fi
rm -rf "$state_dir"' ||
		die "cannot remove the Bier agent from $peer"
	network_host=${peer##*@}
	peer_forget "$peer"
	ssh-keygen -q -f "$HOME/.ssh/known_hosts" -R "$network_host" >/dev/null 2>&1 || true
	info '3/3  Removing local Bier connection details …'
	info "Done. Bier agent removed from $peer."
}

latest_agent_tag() {
	local api=${BIER_AGENT_RELEASE_API:-https://api.github.com/repos/MatthiasToberer/bierfile/releases/latest} json tag
	json=$(curl -fsSL --max-time 20 "$api") || die 'could not check the latest Bier agent release'
	tag=$(printf '%s\n' "$json" | sed -nE 's/.*"tag_name"[[:space:]]*:[[:space:]]*"(v[0-9]+(\.[0-9]+)*)".*/\1/p' | head -1)
	[ -n "$tag" ] || die 'the latest Bier agent release has no valid version tag'
	printf '%s' "$tag"
}

need_agent_release_trust() {
	local output
	if [ -s "$SIGNERS_FILE" ]; then
		info "2/4  Checking secure release verification …"
		info "     Release verification is ready."
		return 0
	fi
	info "2/4  Setting up secure release verification …"
	if ! output=$(cmd_trust "$RELEASE_TRUST_URL" 2>&1); then
		printf '%s\n' "$output" >&2
		die "could not set up release verification"
	fi
	info "     Release verification is ready."
}

write_agent_launch_agent() {
	local path=$1 home=$2 agent=$3 data=$4
	cat >"$path" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.bier.agent</string>
  <key>ProgramArguments</key><array>
    <string>$home/.local/share/bier/agent/bin/bier-agent</string>
    <string>serve</string>
    <string>--agent</string><string>$agent</string>
    <string>--allowed-signers</string><string>$home/.local/share/bier/agent/allowed_signers</string>
    <string>--peer-signers</string><string>$home/.local/share/bier/agent/peer_signers</string>
    <string>--peer-key</string><string>$home/.local/share/bier/agent/identity.pub</string>
	<string>--peers-file</string><string>$home/.config/bier/peers</string>
    <string>--data-dir</string><string>$data</string>
    <string>--port</string><string>53991</string>
    <string>--state-dir</string><string>$home/.local/share/bier/agent/state</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
EOF
}

cmd_peer_install() {
	local peer=${1:-} tag home data agent plist network_host peer_key=$PEER_IDENTITY.pub
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer install <host>'
	[ -r "$peer_key" ] || die "the local Bier peer identity is missing; run install.sh"
	peer_authorize "$peer"
	need_agent_release_trust
	tag=$(latest_agent_tag)
	info "3/4  Installing verified Bier agent $tag …"

	home=$(peer_ssh "$peer" 'printf "%s\n" "$HOME"') ||
		die "cannot determine the home directory of $peer"
	home=$(printf '%s' "$home" | tr -d '\r\n')
	printf '%s\n' "$home" | grep -Eq '^/[A-Za-z0-9._/-]+$' ||
		die "the home directory reported by $peer is not safe to install into"
	data=$(peer_ssh "$peer" 'config="$HOME/.config/bier/config" # bier-agent-data-directory
data=$(sed -nE "s/^[[:space:]]*data[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$config" 2>/dev/null | tail -1)
case "$data" in "~/"*) data="$HOME/${data#\~/}" ;; esac
if [ -n "$data" ] && [ -d "$data/.git" ]; then printf "%s\n" "$data"; else printf "%s\n" "$HOME/.local/share/bier/data"; fi') ||
		die "cannot determine the Bier data directory on $peer"
	data=$(printf '%s' "$data" | tr -d '\r\n')
	printf '%s\n' "$data" | grep -Eq '^/[A-Za-z0-9._/-]+$' ||
		die "the Bier data directory reported by $peer is not safe to use"
	agent=$(peer_ssh "$peer" hostname -s) || die "cannot determine the agent name of $peer"
	agent=$(printf '%s' "$agent" | tr -d '\r\n')
	peer_name_ok "$agent" || die "the agent name reported by $peer is not valid"
	plist=$(tmpfile)
	write_agent_launch_agent "$plist" "$home" "$agent" "$data"

	peer_ssh "$peer" 'set -e
mkdir -p "$HOME/.local/share/bier/agent/bin" "$HOME/Library/LaunchAgents"
if [ ! -r "$HOME/.local/share/bier/agent/identity" ] || [ ! -r "$HOME/.local/share/bier/agent/identity.pub" ]; then
	rm -f "$HOME/.local/share/bier/agent/identity" "$HOME/.local/share/bier/agent/identity.pub"
	ssh-keygen -q -t ed25519 -N "" -C "bier@$(hostname -s)" -f "$HOME/.local/share/bier/agent/identity"
fi
chmod 600 "$HOME/.local/share/bier/agent/identity" "$HOME/.local/share/bier/agent/identity.pub"' ||
		die "cannot prepare the Bier agent directory on $peer"
	peer_scp "$SIGNERS_FILE" "$peer:.local/share/bier/agent/allowed_signers.new" ||
		die "cannot copy the public release keys to $peer"
	peer_scp "$peer_key" "$peer:.local/share/bier/agent/peer-key.new" ||
		die "cannot copy this Mac's peer key to $peer"
	peer_scp "$plist" "$peer:Library/LaunchAgents/com.bier.agent.plist.new" ||
		die "cannot copy the Bier agent LaunchAgent to $peer"
	peer_ssh "$peer" "set -e
rm -rf \"\$HOME/.local/share/bier/agent/source.new\"
git init --quiet \"\$HOME/.local/share/bier/agent/source.new\"
git -C \"\$HOME/.local/share/bier/agent/source.new\" remote add origin https://github.com/MatthiasToberer/bierfile.git
git -C \"\$HOME/.local/share/bier/agent/source.new\" fetch --quiet --depth 1 origin \"refs/tags/$tag:refs/tags/$tag\"
git -C \"\$HOME/.local/share/bier/agent/source.new\" checkout --quiet --detach \"$tag\"
git -C \"\$HOME/.local/share/bier/agent/source.new\" -c gpg.ssh.allowedSignersFile=\"\$HOME/.local/share/bier/agent/allowed_signers.new\" verify-tag \"$tag\" >/dev/null
\"\$HOME/.local/share/bier/agent/source.new/Sources/bier-agent/build.sh\" \"\$HOME/.local/share/bier/agent/bin/bier-agent.new\" >/dev/null
mv \"\$HOME/.local/share/bier/agent/bin/bier-agent.new\" \"\$HOME/.local/share/bier/agent/bin/bier-agent\"
chmod 700 \"\$HOME/.local/share/bier/agent/bin/bier-agent\"
mv \"\$HOME/.local/share/bier/agent/allowed_signers.new\" \"\$HOME/.local/share/bier/agent/allowed_signers\"
touch \"\$HOME/.local/share/bier/agent/peer_signers\"
awk -v peer=\"$HOST\" '\$1 != peer' \"\$HOME/.local/share/bier/agent/peer_signers\" >\"\$HOME/.local/share/bier/agent/peer_signers.new\" || true
printf '%s ' \"$HOST\" >>\"\$HOME/.local/share/bier/agent/peer_signers.new\"
cat \"\$HOME/.local/share/bier/agent/peer-key.new\" >>\"\$HOME/.local/share/bier/agent/peer_signers.new\"
mv \"\$HOME/.local/share/bier/agent/peer_signers.new\" \"\$HOME/.local/share/bier/agent/peer_signers\"
rm -f \"\$HOME/.local/share/bier/agent/peer-key.new\"
rm -rf \"\$HOME/.local/share/bier/agent/source\"
mv \"\$HOME/.local/share/bier/agent/source.new\" \"\$HOME/.local/share/bier/agent/source\"
rm -rf \"\$HOME/.local/share/bierkasten\"
mv \"\$HOME/Library/LaunchAgents/com.bier.agent.plist.new\" \"\$HOME/Library/LaunchAgents/com.bier.agent.plist\"
launchctl bootout \"gui/\$(id -u)\" \"\$HOME/Library/LaunchAgents/com.bier.agent.plist\" >/dev/null 2>&1 || true
launchctl bootout \"gui/\$(id -u)\" \"\$HOME/Library/LaunchAgents/com.bierkasten.agent.plist\" >/dev/null 2>&1 || true
rm -f \"\$HOME/Library/LaunchAgents/com.bierkasten.agent.plist\"
launchctl bootstrap \"gui/\$(id -u)\" \"\$HOME/Library/LaunchAgents/com.bier.agent.plist\"" ||
		die "cannot start the Bier agent on $peer"

	network_host=${peer##*@}
	info "4/4  Checking whether the agent is reachable …"
	curl -fsS --max-time 5 "http://$network_host:53991/v1/health" |
		grep -q '"status":"ok"' || die "the Bier agent on $peer did not answer on TCP port 53991"
	peer_remember "$peer"
	if [ -n "$DATA" ] && [ -d "$DATA/.git" ]; then
		peer_seed "$peer" if-empty
	fi
	info "Done. $agent is ready on $peer."
}

# Releases/latest is deliberately resolved only when the user asks. A remote
# agent must never replace itself in the background: the same signed install
# path is an update, and it remains visible in the terminal.
cmd_peer_upgrade() {
	local peer=${1:-}
	[ $# -eq 1 ] && peer_name_ok "$peer" ||
		die 'usage: bier peer upgrade <host>'
	info "Updating the Bier agent on $peer from the latest trusted release …"
	cmd_peer_install "$peer"
}

peer_discover_wait() {
	local seconds=${BIER_PEER_DISCOVER_SECONDS:-3}
	case $seconds in
	'' | *[!0-9]*) die 'BIER_PEER_DISCOVER_SECONDS must be a whole number' ;;
	esac
	[ "$seconds" -le 30 ] || die 'BIER_PEER_DISCOVER_SECONDS must not exceed 30'
	printf '%s' "$seconds"
}

# dns-sd browse and lookup commands stay alive to watch for later changes.
# Run each briefly in the background, then collect the snapshot and stop it.
peer_discover_run() {
	local output=$1 seconds=$2
	shift 2
	dns-sd "$@" >"$output" 2>&1 &
	local pid=$!
	sleep "$seconds"
	kill "$pid" 2>/dev/null || true
	wait "$pid" 2>/dev/null || true
}

cmd_peer_discover() {
	command -v dns-sd >/dev/null 2>&1 ||
		die 'Bonjour discovery needs dns-sd (included with macOS)'
	[ "$#" -le 1 ] || die 'usage: bier peer discover [-ssh]'
	local mode=${1:-} service title suggestion seconds browse lookup instances instance host n=0
	case $mode in
	"")
		service=_bier-agent._tcp
		title='Bier agents found on the local network:'
		suggestion='To remember one: bier peer add <host>'
		;;
	-ssh)
		service=_ssh._tcp
		title='Macs with Remote Login found on the local network:'
		suggestion='To install one: bier peer install <user>@<host>'
		;;
	*) die 'usage: bier peer discover [-ssh]' ;;
	esac
	seconds=$(peer_discover_wait)
	browse=$(tmpfile)
	peer_discover_run "$browse" "$seconds" -B "$service" local.
	instances=$(awk '
		/ Add / {
			for (i = 1; i <= NF; i++) {
				if ($i == service || $i == service ".") {
					for (j = i + 1; j <= NF; j++) {
						printf "%s%s", (j == i + 1 ? "" : " "), $j
					}
					printf "\n"
					break
				}
			}
		}
	' service="$service" "$browse" | sed '/^$/d' | sort -u)
	if [ -z "$instances" ]; then
		if [ "$mode" = -ssh ]; then
			info 'No Macs with Remote Login found on the local network.'
		else
			info 'No Bier agents found on the local network.'
		fi
		return 0
	fi

	info "$title"
	while IFS= read -r instance; do
		[ -n "$instance" ] || continue
		lookup=$(tmpfile)
		peer_discover_run "$lookup" "$seconds" -L "$instance" "$service" local.
		host=$(sed -nE 's/.*can be reached at ([^ ]+)\.?(:[0-9]+)?.*/\1/p' "$lookup" |
			sed 's/\.$//' | head -1)
		if peer_name_ok "$host" && ! peer_is_self "$host"; then
			n=$((n + 1))
			printf '  %2s  %s\n' "$n" "$host"
		fi
	done <<EOF
$instances
EOF
	if [ "$n" = 0 ]; then
		info 'No usable host address was announced.'
	else
		info ''
		info "$suggestion"
	fi
}

cmd_peer_help() {
	cat <<'EOF'
bier peer — manage Macs Bier may contact

  bier peer discover      show Bier agents announced via Bonjour
  bier peer discover -ssh show Macs with Remote Login via Bonjour
  bier peer add <host>    remember a Mac locally
  bier peer list          show remembered Macs
  bier peer check <host>  check safe, non-interactive SSH access
  bier peer hello <host>  prove authenticated Bier Agent access
  bier peer offer [--address <own-host>]  show a one-time code for SSH-free pairing
  bier peer pair <host> [--address <own-host>]  pair with a Mac using its one-time code
  bier peer compare <host> compare verified data without changing it
  bier peer sync <host>   synchronise data and history with a peer
  bier peer seed <host>   copy data to a new, empty Bier peer
  bier peer trust [url]   alias for bier trust
  bier peer install <host> install a signed Bier agent via SSH
  bier peer upgrade <host> replace an agent with the latest signed release
  bier peer uninstall <host> stop and remove a Bier agent via SSH
  bier peer remove <host> forget a remembered Mac
EOF
}

cmd_peer() {
	if [ $# -eq 0 ]; then
		cmd_peer_help
		return 0
	fi
	local sub=$1
	shift
	case $sub in
	add) cmd_peer_add "$@" ;;
	list) cmd_peer_list "$@" ;;
	remove | rm) cmd_peer_remove "$@" ;;
check) cmd_peer_check "$@" ;;
hello) cmd_peer_hello "$@" ;;
offer) cmd_peer_offer "$@" ;;
pair) cmd_peer_pair "$@" ;;
compare) cmd_peer_compare "$@" ;;
sync) cmd_peer_sync "$@" ;;
seed) cmd_peer_seed "$@" ;;
trust) cmd_peer_trust "$@" ;;
install) cmd_peer_install "$@" ;;
upgrade | update) cmd_peer_upgrade "$@" ;;
uninstall) cmd_peer_uninstall "$@" ;;
discover) cmd_peer_discover "$@" ;;
help | -h | --help) cmd_peer_help ;;
*) die 'usage: bier peer <discover|add|list|check|hello|offer|pair|compare|sync|seed|trust|install|upgrade|uninstall|remove> [host]' ;;
	esac
}

cmd_dump() {
	need_brew
	need_repo
	mkdir -p "$BREW_DIR"

	local adopt=no
	if [ "${1:-}" = "--adopt" ]; then adopt=yes; fi

	local tmp
	tmp=$(tmpfile)
	brew bundle dump --force --file "$tmp" >/dev/null

	# Whatever was removed on another Mac must not slip into the device
	# file here — a dump would otherwise turn that removal into a
	# device-specific installation and it would be lost for good. Such
	# entries stay out and thus remain visible as "removed elsewhere".
	local stale_now base
	stale_now=$(classify_add "$(comm -23 <(entries "$tmp") <(own_entries) || true)" |
		sed -n 's/^STALE'$'\t''//p')

	base=$(tmpfile)
	cat "$MAIN_FILE" >"$base" 2>/dev/null || true
	if [ -n "$stale_now" ] && [ "$adopt" = no ]; then
		printf '%s\n' "$stale_now" >>"$base"
	fi

	# What is installed and not already in main.
	local new_lines keep_base old_lines out
	new_lines=$(tmpfile)
	delta "$tmp" "$base" >"$new_lines"

	# What was already recorded here but is not (yet) installed stays.
	# Otherwise a dump would throw away what you deliberately picked with
	# "bier take". An entry really goes away only through "bier uninstall"
	# or "bier prune".
	keep_base=$(tmpfile)
	cat "$base" "$new_lines" >"$keep_base"
	old_lines=$(tmpfile)
	delta "$HOST_FILE" "$keep_base" >"$old_lines"

	out=$(tmpfile)
	{
		printf '# %s — what this Mac has on top of Brewfiles/main.\n' "$HOST"
		printf '# Written by "bier dump", do not edit by hand.\n\n'
		cat "$new_lines" "$old_lines"
	} >"$out"
	mv "$out" "$HOST_FILE"

	local n m
	n=$(entries "$HOST_FILE" | wc -l | tr -d ' ')
	m=$(entries "$MAIN_FILE" | wc -l | tr -d ' ')
	info "Brewfiles/$HOST written: $n on top of $m in main"

	if [ -n "$stale_now" ]; then
		if [ "$adopt" = no ]; then
			info ""
			info "Not adopted, because removed elsewhere (bier prune):"
			printf '%s\n' "$stale_now" | sed 's/^/  ~ /'
			info "To keep it here: bier dump --adopt"
		else
			info "Adopted although removed elsewhere:"
			printf '%s\n' "$stale_now" | sed 's/^/  + /'
		fi
	fi
}

# Creates Brewfiles/main from this Mac's inventory and rewrites every
# device file as a delta against it. Not a dump but a rebuild — hence a
# command of its own.
cmd_main() {
	need_brew
	need_repo
	mkdir -p "$BREW_DIR"

	local push=yes
	if [ "${1:-}" = "--no-push" ]; then push=no; fi

	# Dump into a copy first: only that way can we say beforehand what
	# would drop out of main.
	local incoming existing lost
	incoming=$(tmpfile)
	brew bundle dump --force --file "$incoming" >/dev/null

	existing=$(entries "$MAIN_FILE" | wc -l | tr -d ' ')
	if [ "$existing" != "0" ]; then
		info "Brewfiles/main holds $(count_word "$existing") and will be replaced"
		info "by the inventory of $HOST. What other devices have on top of it"
		info "stays in their device file."

		# Entries that are in main but not installed here disappear from
		# the repository — even if another Mac still has them. That is
		# the dangerous part and belongs before the question.
		lost=$(comm -23 <(entries "$MAIN_FILE") <(entries "$incoming") || true)
		if [ -n "$lost" ]; then
			info ""
			info "Will drop out of main for good, because it is not installed"
			info "on $HOST — even if another device still has it:"
			printf '%s\n' "$lost" | sed 's/^/  - /'
			info ""
			info "To keep it, hand it to a device first:"
			info "  bier take --from-main"
		fi

		info ""
		printf 'Continue? [y/N] '
		read -r answer || answer=""
		case $answer in
		j | J | y | Y) ;;
		*) die "cancelled" ;;
		esac
	fi

	cp "$incoming" "$MAIN_FILE"
	info "Brewfiles/main: inventory of $HOST, $(count_word "$(entries "$MAIN_FILE" | wc -l | tr -d ' ')")"

	# Rebase every device file onto the new main.
	local host file tmp
	for host in $(host_list); do
		file=$BREW_DIR/$host
		tmp=$(tmpfile)
		{
			printf '# %s — what this Mac has on top of Brewfiles/main.\n' "$host"
			printf '# Written by "bier dump", do not edit by hand.\n\n'
			delta "$file" "$MAIN_FILE"
		} >"$tmp"
		mv "$tmp" "$file"
		info "  $host: $(entries "$file" | wc -l | tr -d ' ') entries left"
	done

	if [ "$push" = yes ]; then
		publish "main: inventory of $HOST as the shared baseline"
	else
		info "Not pushed — later with 'bier sync'."
	fi
}

# Uninstalls packages, takes them out of every Brewfile and pushes that.
# Removal becomes an action instead of something guessed from a dump.
cmd_uninstall() {
	need_brew
	need_repo
	[ $# -ge 1 ] || die "usage: bier uninstall <package> [...]"

	local name kind done_any=no
	for name in "$@"; do
		kind=$(kind_of "$name")
		[ -n "$kind" ] || die "$name is neither installed here nor in the Brewfiles"
		info "$name ($kind)"
		if uninstall_one "$kind" "$name"; then
			strip_entry "$kind" "$name"
			done_any=yes
		else
			info "  stays in the Brewfiles as long as it is installed"
		fi
	done

	if [ "$done_any" = no ]; then
		info "Nothing removed."
		return 0
	fi
	cmd_dump
	publish "$HOST: removed $*"
}

# Removes what is still installed here but was deleted on another device.
# The git history is what tells that apart from a new addition.
cmd_prune() {
	need_brew
	need_repo

	local tmp stale entry kind name
	tmp=$(tmpfile)
	brew bundle dump --force --file "$tmp" >/dev/null

	stale=$(classify_add "$(comm -23 <(entries "$tmp") <(own_entries) || true)" |
		sed -n 's/^STALE'$'\t''//p')
	if [ -z "$stale" ]; then
		info "Nothing stale: nothing is installed here that was removed elsewhere."
		return 0
	fi

	info "Removed elsewhere, still installed here:"
	printf '%s\n' "$stale" | sed 's/^/  /'
	printf 'Uninstall? [y/N] '
	read -r answer || answer=""
	case $answer in
	j | J | y | Y) ;;
	*)
		info "Cancelled."
		return 0
		;;
	esac

	# Taps last: brew refuses to untap while something from the tap is
	# still installed.
	local ordered
	ordered=$({ printf '%s\n' "$stale" | grep -v '^tap ' || true
		printf '%s\n' "$stale" | grep '^tap ' || true; })

	printf '%s\n' "$ordered" | while IFS= read -r entry; do
		[ -n "$entry" ] || continue
		kind=${entry%% *}
		name=$(printf '%s' "$entry" | sed -E 's/^[a-z]+ "([^"]+)"$/\1/')
		info ""
		info "-> $kind $name"
		uninstall_one "$kind" "$name" || info "  failed, stays for now"
	done

	cmd_dump
	publish "$HOST: removed packages deleted elsewhere"

	# Whatever survived the uninstall has to stay visible.
	local rest
	rest=$(cmd_state | sed -n 's/^STALE'$'\t''//p' || true)
	if [ -n "$rest" ]; then
		info ""
		info "Not removed and still reported:"
		printf '%s\n' "$rest" | sed 's/^/  ~ /'
	fi
}

# Overview of all devices. Belongs in the terminal, not in the menu bar:
# with ten Macs it would be a wall up there.
cmd_list() {
	need_repo
	local h count all entry hosts text

	# Collect everything first, then print it in one go. Writing line by
	# line takes a while here (one comparison per entry per device) — and
	# whoever pipes the output into "head" would see a broken pipe as
	# soon as head bows out.
	text="Brewfiles/main: $(entries "$MAIN_FILE" | wc -l | tr -d ' ') entries, applies to every device"$'\n'
	text=$text$'\n'"Device               on top"$'\n'
	for h in $(host_list); do
		count=$(entries "$BREW_DIR/$h" | wc -l | tr -d ' ')
		if [ "$h" = "$HOST" ]; then
			text=$text$(printf '  %-20s %5s   (this Mac)' "$h" "$count")$'\n'
		else
			text=$text$(printf '  %-20s %5s' "$h" "$count")$'\n'
		fi
	done

	all=$(for h in $(host_list); do entries "$BREW_DIR/$h"; done | sort -u)
	if [ -z "$all" ]; then
		printf '%s\nNo device has anything on top of main.\n' "$text"
		return 0
	fi

	text=$text$'\n'"On top of main, and where:"$'\n'
	while IFS= read -r entry; do
		hosts=""
		for h in $(host_list); do
			if entries "$BREW_DIR/$h" | grep -qxF "$entry"; then
				hosts="$hosts $h"
			fi
		done
		text=$text$(printf '  %-44s %s' "$entry" "${hosts# }")$'\n'
	done <<<"$all"

	printf '%s' "$text"
}

cmd_status() {
	need_brew
	need_repo

	local trouble
	trouble=$(vault_trouble)
	if [ -n "$trouble" ]; then
		printf '%s\n' "$trouble" | sed -n 's/^DEAD\t/  ! link points nowhere: /p'
		printf '%s\n' "$trouble" | sed -n 's/^MISSING\t/  ! link points nowhere, the file is gone: /p'
		printf '%s\n' "$trouble" | sed -n 's/^GONE\t/  ! link is missing: /p'
		printf '%s\n' "$trouble" | sed -n 's/^LOOSE\t/  ! no longer a link: /p'
		info "    bier vault --restore puts the links back."
		info ""
	fi

	# Say it here as well. Aborting only at install time would mean the
	# line sits in the file for weeks without anybody being told.
	local f bad
	for f in "$MAIN_FILE" "$HOST_FILE"; do
		bad=$(foreign_lines "$f")
		[ -z "$bad" ] || {
			info "WARNING  $f holds lines that are not entries:"
			printf '%s\n' "$bad" | sed 's/^/           /'
			info "         brew would run them. bier install refuses until they are gone."
			info ""
		}
	done

	local tmp
	tmp=$(tmpfile)
	brew bundle dump --force --file "$tmp"

	local drift_add drift_gone
	drift_add=$(comm -23 <(entries "$tmp") <(own_entries) || true)
	drift_gone=$(comm -13 <(entries "$tmp") <(own_entries) || true)

	local fresh stale
	fresh=$(classify_add "$drift_add" | sed -n 's/^NEW'$'\t''//p')
	stale=$(classify_add "$drift_add" | sed -n 's/^STALE'$'\t''//p')

	if [ -z "$drift_add" ] && [ -z "$drift_gone" ]; then
		info "$HOST: Brewfile matches the system."
	else
		if [ -n "$fresh" ]; then
			info "Installed on $HOST but not recorded (bier dump):"
			printf '%s\n' "$fresh" | sed 's/^/  + /'
		fi
		if [ -n "$stale" ]; then
			info "Removed on another device, still here (bier prune):"
			printf '%s\n' "$stale" | sed 's/^/  ~ /'
		fi
		if [ -n "$drift_gone" ]; then
			info "Recorded but not installed on $HOST (bier install):"
			printf '%s\n' "$drift_gone" | sed 's/^/  - /'
		fi
	fi

	info ""
	info "Git:"
	git -C "$DATA" status --short --branch | sed 's/^/  /'
}

cmd_diff() {
	need_repo
	local others
	if [ $# -gt 0 ]; then
		others=$*
	else
		others=$(host_list | grep -v "^$HOST$" || true)
	fi
	[ -n "$others" ] || die "no other device found in Brewfiles/"

	for other in $others; do
		local other_file=$BREW_DIR/$other
		[ -f "$other_file" ] || die "Brewfiles/$other is missing"

		info "== $HOST  vs.  $other =="
		local only_here only_there
		only_here=$(comm -23 <(own_entries) <(host_entries "$other") || true)
		only_there=$(comm -13 <(own_entries) <(host_entries "$other") || true)

		if [ -z "$only_here" ] && [ -z "$only_there" ]; then
			info "  identical"
		else
			if [ -n "$only_here" ]; then
				printf '%s\n' "$only_here" | sed "s/^/  only $HOST:  /"
			fi
			if [ -n "$only_there" ]; then
				printf '%s\n' "$only_there" | sed "s/^/  only $other:  /"
			fi
		fi
		info ""
	done
}

cmd_install() {
	need_brew
	need_repo
	# Both before either: finding the second one poisoned after the
	# first has already been installed would be half a rescue.
	verify_brewfile "$MAIN_FILE"
	verify_brewfile "$HOST_FILE"
	if [ -f "$MAIN_FILE" ]; then
		brew bundle install --file "$MAIN_FILE"
	fi
	if [ -f "$HOST_FILE" ]; then
		brew bundle install --file "$HOST_FILE"
	fi
	info "The inventory of $HOST is installed."
}

# Syncs the Brewfiles with the legacy private server: record what is pending,
# push what is ours, fetch what is theirs. Not a command of its own —
# publish fetches before every push anyway, and update needs it here.
sync_data() {
	local msg=${1:-"$HOST: inventory updated"}
	if ! git -C "$DATA" remote get-url origin >/dev/null 2>&1; then
		publish "$msg"
		return 0
	fi

	# Safe as well as Brewfiles. A run in which only a vault file
	# changed would otherwise fall through here and never be committed
	# at all -- which is exactly what happened the first time.
	if [ -n "$(git -C "$DATA" status --porcelain -- Brewfiles Safe)" ]; then
		publish "$msg"
		return 0
	fi

	local before after outgoing incoming
	before=$(git -C "$DATA" rev-parse HEAD)
	fetch_rebase
	after=$(git -C "$DATA" rev-parse HEAD)

	outgoing=$(git -C "$DATA" log --oneline '@{u}..HEAD' 2>/dev/null || true)
	if [ -n "$outgoing" ]; then
		git -C "$DATA" push --quiet
		info "Pushed our own inventory changes."
	fi

	if [ "$before" != "$after" ]; then
		incoming=$(git -C "$DATA" diff --stat "$before..$after" -- Brewfiles 2>/dev/null || true)
		if [ -n "$incoming" ]; then
			info "New inventory from the other Mac:"
			printf '%s\n' "$incoming" | sed 's/^/  /'
		fi
	fi
}

sync_peers() {
	local msg=$1 peer peers
	git -C "$DATA" add Brewfiles
	[ ! -d "$SAFE_DIR" ] || git -C "$DATA" add Safe
	if git -C "$DATA" diff --cached --quiet; then
		info "Nothing to commit."
	else
		git -C "$DATA" commit -q -m "$msg"
		info "Commit: $msg"
	fi
	peers=$(peer_list)
	[ -n "$peers" ] || die "no Bier peers are configured"
	# First collect every peer's history. A second pass distributes the
	# resulting common head to peers visited before the final merge.
	for peer in $peers; do cmd_peer_sync "$peer"; done
	for peer in $peers; do cmd_peer_sync "$peer"; done
	info "In sync with Bier peers."
}

# The newest release published on the code server, without the leading
# "v". Empty when nobody has tagged one — which is the normal state of a
# server that is only ever pushed to, such as the private one during
# development.
latest_release() {
	git -C "$ROOT" tag -l 'v*' --sort=-v:refname 2>/dev/null | head -1 | sed 's/^v//'
}

# Is $2 a higher version than $1? "sort -V" is what gets 0.9.1 < 0.11.0
# right; comparing the strings would call 0.9.1 the newer one.
newer_version() {
	[ "$1" != "$2" ] &&
		[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]
}

# Looks whether a newer version of the program exists. Returning 0 means:
# there is something that wants building.
check_code() {
	need_code
	git -C "$ROOT" fetch --tags --quiet 2>/dev/null ||
		die "code server unreachable — is the network plugged in?"

	UPGRADE_TAG=""

	# A tagged server publishes releases, and then the version decides.
	local release
	release=$(latest_release)
	if [ -n "$release" ]; then
		if ! newer_version "$BIER_VERSION" "$release"; then
			info "Program is up to date: $BIER_VERSION"
			return 1
		fi
		UPGRADE_TAG="v$release"
		info ""
		info "bier $release is out — this one is $BIER_VERSION."
		return 0
	fi

	# No release anywhere: that is a working copy which is pushed to
	# rather than released from, so follow the branch as before.
	local here there count
	here=$(git -C "$ROOT" rev-parse HEAD)
	there=$(git -C "$ROOT" rev-parse '@{u}' 2>/dev/null || true)
	if [ -z "$there" ]; then
		info "The code branch has no counterpart on the server."
		return 1
	fi
	if [ "$here" = "$there" ]; then
		# The version first, because that is the number anyone compares
		# against. The commit follows because without a release it is the
		# only thing that tells two builds of one version apart.
		info "Program is up to date: $BIER_VERSION ($(git -C "$ROOT" rev-parse --short HEAD))"
		return 1
	fi

	count=$(git -C "$ROOT" log --oneline "$here..$there" | wc -l | tr -d ' ')
	info ""
	if [ "$count" = "1" ]; then
		info "1 new commit to the program:"
	else
		info "$count new commits to the program:"
	fi
	git -C "$ROOT" log --oneline "$here..$there" | sed 's/^/  /'
	return 0
}

# --- The vault ---------------------------------------------------------
#
# Files that are not Brewfiles: dotfiles, notes, whatever belongs on
# every Mac. They are encrypted symmetrically with one passphrase that
# every Mac knows, so a new Mac needs nothing but that passphrase --
# no key to carry over, nobody else's machine to ask.
#
# Brewfiles stay readable. Encrypting them was tried and measured: a
# union merge glues two ciphertexts together and the file is quietly
# ruined, and "removed elsewhere" stops working because it searches the
# history for the entry.

need_gpg() {
	command -v gpg >/dev/null 2>&1 ||
		die "gpg is missing, and the vault is encrypted with it.
     Install it:  brew install gnupg"
}

# The passphrase. It lives in this Mac's own keychain, not in iCloud:
# a working copy, not a place to keep it. BIER_VAULT_PASS overrides it
# for tests and for anyone scripting this.
vault_pass() {
	if [ -n "${BIER_VAULT_PASS:-}" ]; then
		printf '%s' "$BIER_VAULT_PASS"
		return 0
	fi
	local pass status=0 why
	why=$(tmpfile)
	pass=$(security find-generic-password -s bier-vault -a vault -w 2>"$why") || status=$?
	if [ "$status" = 36 ] && [ "${1:-}" != --no-unlock ] && keychain_unlock; then
		status=0
		pass=$(security find-generic-password -s bier-vault -a vault -w 2>"$why") || status=$?
	fi
	# 44 is "no such item". Anything else means the passphrase is there
	# but locked away -- over SSH, typically. Reporting that as "no
	# passphrase yet" sent people to set a new one.
	case $status in
	0) printf '%s' "$pass"; return 0 ;;
	44) return 0 ;;
	esac
	[ "${1:-}" != --no-unlock ] || return 1
	die "the keychain holds the vault passphrase but would not hand it out:
     $(cat "$why")

     Unlock the login keychain and try again:
       security unlock-keychain ~/Library/Keychains/login.keychain-db"
}

# Over SSH the login keychain stays locked, and security answers every
# request with status 36, "User interaction is not allowed". That is
# what kept the passphrase out of the keychain during installation.
# With somebody at the terminal, unlocking it is one password away.
keychain_unlock() {
	[ -t 0 ] || [ -n "${BIER_TEST_TTY:-}" ] || return 1
	info "The login keychain is locked, as it usually is over SSH." >&2
	info "Unlock it with your macOS login password (not the vault passphrase):" >&2
	security unlock-keychain "$HOME/Library/Keychains/login.keychain-db"
}

# Whether this Mac remembers a passphrase, without stopping when the
# keychain is locked: "known", "missing" or "locked".
vault_pass_state() {
	if [ -n "${BIER_VAULT_PASS:-}" ]; then
		echo known
		return 0
	fi
	local status=0
	security find-generic-password -s bier-vault -a vault >/dev/null 2>&1 || status=$?
	if [ "$status" != 0 ]; then
		echo missing
	elif vault_pass --no-unlock >/dev/null 2>&1; then
		echo known
	else
		echo locked
	fi
}

vault_pass_store() {
	[ -z "${BIER_VAULT_PASS:-}" ] || return 0
	local why status=0
	# Say what security said. Swallowing it left "could not write the
	# passphrase to the keychain" and no way to find out why.
	why=$(security add-generic-password -s bier-vault -a vault -w "$1" -U 2>&1) || status=$?
	if [ "$status" = 36 ] && keychain_unlock; then
		status=0
		why=$(security add-generic-password -s bier-vault -a vault -w "$1" -U 2>&1) || status=$?
	fi
	[ "$status" = 0 ] ||
		die "the keychain would not take the passphrase:
     $why

     A locked or missing login keychain is the usual reason. Unlock it
     with 'security unlock-keychain ~/Library/Keychains/login.keychain-db',
     or work without it for now by putting the passphrase in
     BIER_VAULT_PASS."
}

vault_encrypt() {
	printf '%s' "$2" | gpg --batch --yes --quiet --passphrase-fd 0 \
		--pinentry-mode loopback -c --cipher-algo AES256 -o "$3" "$1"
}

vault_decrypt() {
	printf '%s' "$2" | gpg --batch --yes --quiet --passphrase-fd 0 \
		--pinentry-mode loopback -d -o "$3" "$1" 2>/dev/null
}

# Does this passphrase open what is already there? An empty safe cannot
# say, and then anything is as good as anything else.
vault_pass_works() {
	local f probe
	# Any file will do, also one in a folder or the groups list.
	f=$(find "$SAFE_DIR" -name '*.gpg' -type f -print -quit 2>/dev/null)
	[ -n "$f" ] || return 0
	probe=$(tmpfile)
	vault_decrypt "$f" "$1" "$probe"
}

# Asks and hands back what was typed. Never echoes it.
#
# The prompt goes to stderr, and that is not cosmetic: this runs inside
# $(...), so anything written to stdout ends up inside the passphrase.
# It did. What was stored was "Passphrase: " with the answer glued
# behind it -- consistent enough to look like it worked, and wrong
# enough that gpg by hand could never have opened the file.
vault_ask() {
	local pass
	printf '%s' "$1" >&2
	read -rs pass || pass=""
	printf '\n' >&2
	[ -n "$pass" ] || die "no passphrase given"
	printf '%s' "$pass"
}

# Twice, whenever there is nothing to check the answer against. A typo
# in the first passphrase of an empty vault encrypts everything with
# something nobody will ever type again, and nothing would notice.
vault_ask_twice() {
	local first second
	first=$(vault_ask "$1")
	second=$(vault_ask "Again: ")
	[ "$first" = "$second" ] ||
		die "the two do not match — nothing has been changed"
	printf '%s' "$first"
}

# ~/.config/nvim/init.lua  <->  dot_config/nvim/init.lua
#
# The name carries the destination, so there is no list to keep in step
# with reality -- the idea is chezmoi's and it is a good one.
vault_name() {
	printf '%s' "${1#"$HOME"/}" | sed -e 's#^\.#dot_#' -e 's#/\.#/dot_#g'
}

vault_target() {
	printf '%s/%s' "$HOME" \
		"$(vault_strip_scope "$1" | sed -e 's#^dot_#.#' -e 's#/dot_#/.#g')"
}

# A path in the vault may start with a scope: @laptops/dot_zshrc goes to
# the Macs in that group, @mini/dot_zshrc only to that one. A device name
# is simply a group of one, so there is nothing extra to declare for it.
#
# Anything whose name begins with a dot is bier's own -- .groups is not
# a file anybody asked to have in their home.
vault_scope() {
	case $1 in
	@*/*) printf '%s' "${1%%/*}" | cut -c2- ;;
	*) printf '' ;;
	esac
}

vault_strip_scope() {
	case $1 in
	@*/*) printf '%s' "${1#*/}" ;;
	*) printf '%s' "$1" ;;
	esac
}

vault_is_meta() {
	# bier's own files in the vault: .groups, and the README that
	# install.sh leaves there. Without the second one it would travel
	# like any other file and turn up as ~/README.txt on every Mac.
	case $1 in
	README.txt) return 0 ;;
	esac
	case $(basename "$1") in
	.*) return 0 ;;
	esac
	case $1 in
	.*) return 0 ;;
	esac
	return 1
}

# Who is in a group. Reads the file in the vault, which travels
# encrypted like everything else.
group_members() {
	[ -f "$VAULT/.groups" ] || return 0
	sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$VAULT/.groups" |
		tail -1
}

group_list() {
	[ -f "$VAULT/.groups" ] || return 0
	sed -nE 's/^[[:space:]]*([A-Za-z0-9_-]+)[[:space:]]*=.*/\1/p' "$VAULT/.groups"
}

# Does this Mac get the file?
vault_wanted() {
	local scope=$(vault_scope "$1") m
	[ -n "$scope" ] || return 0
	[ "$scope" != "$HOST" ] || return 0
	for m in $(group_members "$scope"); do
		[ "$m" != "$HOST" ] || return 0
	done
	return 1
}

cmd_group() {
	local name=${1:-} line rest
	[ $# -eq 0 ] || shift

	case $name in
	"")
		if [ ! -f "$VAULT/.groups" ]; then
			info "No groups. Everything in the vault goes to every Mac."
			info "  bier vault group laptops mini macbook"
			return 0
		fi
		for line in $(group_list); do
			rest=$(group_members "$line")
			if printf '%s\n' $rest | grep -qx "$HOST"; then
				info "  $line = $rest   (this Mac)"
			else
				info "  $line = $rest"
			fi
		done
		return 0
		;;
	--drop)
		[ $# -gt 0 ] || die "which group? bier vault group --drop laptops"
		[ -f "$VAULT/.groups" ] || die "no groups at all"
		sed -i '' -E "/^[[:space:]]*$1[[:space:]]*=/d" "$VAULT/.groups"
		info "Group $1 is gone. Files under @$1/ go to nobody until"
		info "the group exists again — bier vault drop removes them."
		return 0
		;;
	esac

	[ $# -gt 0 ] || die "which Macs? bier vault group laptops mini macbook"
	mkdir -p "$VAULT"
	touch "$VAULT/.groups"
	for line in "$@"; do
		host_list | grep -qx "$line" ||
			info "Note: no Mac called $line has recorded anything yet."
	done
	sed -i '' -E "/^[[:space:]]*$name[[:space:]]*=/d" "$VAULT/.groups"
	printf '%s = %s\n' "$name" "$*" >>"$VAULT/.groups"
	info "$name = $*"
}

# Moves the file into the vault and leaves a link behind, so it goes on
# living where the program that reads it expects it.
vault_add() {
	local src=$1 scope=${2:-} name dest
	case $src in
	"$HOME"/*) ;;
	*) die "only files below $HOME can go into the vault: $src" ;;
	esac
	[ -e "$src" ] || die "$src does not exist"
	[ ! -L "$src" ] || die "$src is already a link -- in the vault already?"
	if [ -d "$src" ]; then
		local f
		# A directory is taken in file by file. Moving it whole would
		# leave the link on the folder, and anything written into it
		# later would silently stay outside the vault.
		find "$src" -type f -print | while IFS= read -r f; do
			vault_add "$f" "$scope"
		done
		return 0
	fi
	[ -f "$src" ] || die "$src is neither a file nor a directory"

	name=$(vault_name "$src")
	[ -z "$scope" ] || name=@$scope/$name
	dest=$VAULT/$name
	[ ! -e "$dest" ] || die "$name is already in the vault"

	mkdir -p "$(dirname "$dest")"
	mv "$src" "$dest"
	ln -s "$dest" "$src"
	info "$name   <-  $src"
}

# Takes it back out: the real file returns to its place, and the
# encrypted copy goes. The file stays on this Mac -- that is the whole
# difference to drop.
vault_forget() {
	local src=$1 name dest
	name=$(vault_name "$src")
	dest=$VAULT/$name
	[ -e "$dest" ] || die "$name is not in the vault"
	rm -f "$src"
	mv "$dest" "$src"
	rm -f "$SAFE_DIR/$name.gpg"
	info "$src is a plain file again"
}

# Gone everywhere: out of the vault, out of the safe, and the link at
# the destination goes too. Unlike forget, this does not leave a file
# behind -- so it asks first.
vault_drop() {
	local src=$1 name dest answer
	name=$(vault_name "$src")
	dest=$VAULT/$name
	[ -e "$dest" ] || die "$name is not in the vault"

	info "This deletes $name everywhere: here, in the safe, and on every"
	info "other Mac at its next sync. git history keeps the encrypted"
	info "copies, but nothing else will."
	printf 'Delete it? [y/N] '
	read -r answer || answer=""
	case $answer in
	j | J | y | Y) ;;
	*)
		info "Cancelled."
		return 0
		;;
	esac

	rm -f "$dest" "$SAFE_DIR/$name.gpg"
	[ ! -L "$src" ] || rm -f "$src"
	git -C "$DATA" rm -q --ignore-unmatch "Safe/$name.gpg" >/dev/null 2>&1 || true
	info "$name is gone."
}

# What is wrong with the links. Both sides have to be walked: a dead
# link is precisely the case where the vault file is gone, so looking
# only at the vault would find nothing to complain about. And a dead
# link is the dangerous one -- zsh falls back to its defaults and you
# notice in three weeks.
vault_trouble() {
	local rel target
	{
		[ ! -d "$SAFE_DIR" ] ||
			find "$SAFE_DIR" -name '*.gpg' -type f -print 2>/dev/null |
			sed -e "s#^$SAFE_DIR/##" -e 's#\.gpg$##'
		[ ! -d "$VAULT" ] ||
			find "$VAULT" -type f -print 2>/dev/null | sed -e "s#^$VAULT/##"
	} | sort -u | while IFS= read -r rel; do
		[ -n "$rel" ] || continue
		vault_is_meta "$rel" && continue
		vault_wanted "$rel" || continue
		target=$(vault_target "$rel")
		if [ ! -f "$VAULT/$rel" ]; then
			printf 'MISSING\t%s\n' "$target"
		elif [ -L "$target" ]; then
			[ -e "$target" ] || printf 'DEAD\t%s\n' "$target"
		elif [ -e "$target" ]; then
			printf 'LOOSE\t%s\n' "$target"
		else
			printf 'GONE\t%s\n' "$target"
		fi
	done
}

# Next to the data, not only in a manual that may not be there any more.
vault_recovery_note() {
	cat >"$SAFE_DIR/README-recovery.txt" <<'NOTE'
These files were encrypted by bier with plain gpg, symmetric, AES-256.

You do not need bier to get them back. With the passphrase:

    gpg -d dot_zshrc.gpg > ~/.zshrc

The name says where the file belongs: dot_ stands for a leading dot, and
directories are mirrored, so dot_config/nvim/init.lua is
~/.config/nvim/init.lua.

Earlier versions are in the git history of this repository.

Nothing can recover the passphrase itself. If it is lost, so are these
files.
NOTE
}

# Puts the link at its destination. Four cases, and only one of them
# used to be handled:
#
#   nothing there      link it
#   our own link       done already
#   a plain file       keep it as .backup, then link
#   somebody's link    leave it alone and say so
#
# The third is the normal case on the second Mac -- every Mac has a
# .zshrc -- and it used to mean nothing happened at all: no link, no
# word, and the file sitting decrypted in the vault where nobody looks.
vault_link() {
	local src=$1 target=$2 backup n

	if [ -L "$target" ]; then
		[ "$(readlink "$target")" != "$src" ] || return 0
		info "left alone: $target is a link to somewhere else"
		return 0
	fi

	mkdir -p "$(dirname "$target")"

	if [ -e "$target" ]; then
		if cmp -s "$target" "$src"; then
			# Identical, so there is nothing a backup could save.
			rm -f "$target"
			ln -s "$src" "$target"
			info "linked: $target (was the same file)"
			return 0
		fi
		backup=$target.backup
		n=2
		while [ -e "$backup" ]; do
			backup=$target.backup.$n
			n=$((n + 1))
		done
		mv "$target" "$backup"
		info "kept: $backup"
	fi

	ln -s "$src" "$target"
	info "linked: $target"
}

# Two different questions, and putting them in one answer cost a whole
# test to find.
#
# What has to be sealed: everything except the README, which explains
# the folder and is the same on every Mac. .groups does travel -- a
# group changed on a Mac with no files of its own would otherwise never
# leave it, and would be overwritten by the old version on the way back.
vault_sealable() {
	[ -d "$VAULT" ] || return 0
	local f rel
	find "$VAULT" -type f -print 2>/dev/null | while IFS= read -r f; do
		rel=${f#"$VAULT"/}
		[ "$rel" != "README.txt" ] || continue
		printf '%s\n' "$rel"
	done
}

# What belongs to the user, for counting out loud. bier's own files are
# none of their business.
vault_own_files() {
	[ -d "$VAULT" ] || return 0
	local f rel
	find "$VAULT" -type f -print 2>/dev/null | while IFS= read -r f; do
		rel=${f#"$VAULT"/}
		vault_is_meta "$rel" && continue
		printf '%s\n' "$rel"
	done
}

# vault -> Safe, encrypting only what really changed. gpg writes
# different bytes every time, so re-encrypting everything would make a
# commit out of every single run.
vault_seal() {
	local pass f rel enc old
	[ -d "$VAULT" ] || return 0
	# An empty vault asks for nothing. Demanding a passphrase from
	# somebody who never put a file in would be absurd -- and since
	# install.sh leaves a README in there, "empty" has to mean "nothing
	# of yours", not "no files at all".
	[ -n "$(vault_sealable)" ] || return 0
	pass=$(vault_pass)
	[ -n "$pass" ] || die "the vault holds files but no passphrase is set.
     bier vault --init"
	need_gpg
	# Checked before anything is encrypted. A wrong passphrase used to
	# seal this Mac's files first and complain only when opening, and
	# the safe then held files the other Macs could not open.
	vault_pass_works "$pass" ||
		die "the safe will not open with the remembered passphrase.
     Nothing was encrypted. Changed on another Mac?  bier vault --init"

	mkdir -p "$SAFE_DIR"
	vault_recovery_note

	find "$VAULT" -type f -print | while IFS= read -r f; do
		rel=${f#"$VAULT"/}
		# The README explains the folder to whoever opens it. It is the
		# same on every Mac and has no business travelling.
		[ "$rel" != "README.txt" ] || continue
		enc=$SAFE_DIR/$rel.gpg
		mkdir -p "$(dirname "$enc")"
		if [ -f "$enc" ]; then
			old=$(mktemp "${TMPDIR:-/tmp}/bier.XXXXXX")
			if vault_decrypt "$enc" "$pass" "$old" && cmp -s "$f" "$old"; then
				rm -f "$old"
				continue
			fi
			rm -f "$old"
		fi
		vault_encrypt "$f" "$pass" "$enc"
	done
}

# Safe -> vault, and a link at the destination for anything that has
# none yet.
vault_open() {
	local pass f rel out target
	[ -d "$SAFE_DIR" ] || return 0
	[ -n "$(find "$SAFE_DIR" -name '*.gpg' -type f -print -quit 2>/dev/null)" ] || return 0
	case $(vault_pass_state) in
	missing)
		info "The safe holds files, but this Mac has no passphrase yet."
		info "  bier vault --init"
		return 0
		;;
	locked)
		if ! keychain_unlock; then
			info "The safe holds files, but the keychain is locked; they stay closed."
			info "  security unlock-keychain ~/Library/Keychains/login.keychain-db"
			return 0
		fi
		;;
	esac
	pass=$(vault_pass)
	need_gpg

	# The groups first, and on their own: everything after this asks
	# them whether it belongs here, and find gives no order worth
	# relying on.
	if [ -f "$SAFE_DIR/.groups.gpg" ]; then
		mkdir -p "$VAULT"
		vault_decrypt "$SAFE_DIR/.groups.gpg" "$pass" "$VAULT/.groups" || {
			rm -f "$VAULT/.groups"
			die "the safe will not open with the remembered passphrase.
     Changed on another Mac?  bier vault --init"
		}
	fi

	find "$SAFE_DIR" -name '*.gpg' -type f -print | while IFS= read -r f; do
		rel=${f#"$SAFE_DIR"/}
		rel=${rel%.gpg}
		# Not ours: another group's file. It stays in the safe, it just
		# never gets decrypted here.
		vault_wanted "$rel" || continue
		out=$VAULT/$rel
		mkdir -p "$(dirname "$out")"
		vault_decrypt "$f" "$pass" "$out" || {
			rm -f "$out"
			die "the safe will not open with the remembered passphrase.
     Changed on another Mac?  bier vault --init"
		}
		# bier's own files have no home to be linked into.
		vault_is_meta "$rel" && continue
		target=$(vault_target "$rel")
		vault_link "$out" "$target"
	done
}

cmd_vault() {
	need_repo
	local pass new n

	case ${1:-} in
	--init)
		need_gpg
		# A locked keychain is not a missing passphrase: storing a new
		# one here would be answered with the same lock anyway.
		[ "$(vault_pass_state)" != locked ] || vault_pass >/dev/null
		if [ -n "$(vault_pass)" ]; then
			info "This Mac already knows a passphrase."
			info "To change it everywhere:  bier vault --passphrase"
			info ""
		fi
		info "The passphrase is the only thing protecting the vault, and"
		info "nothing can recover it. Keep a copy somewhere that is not"
		info "these Macs -- your password manager, or a note in a drawer."
		info "Do that first; this is not the place to invent one."
		info ""
		# With files in the safe the answer is checked against them, so
		# once is enough. With an empty safe there is nothing to check.
		if [ -n "$(find "$SAFE_DIR" -name '*.gpg' -print -quit 2>/dev/null)" ]; then
			pass=$(vault_ask "Passphrase: ")
		else
			pass=$(vault_ask_twice "Passphrase: ")
		fi
		vault_pass_works "$pass" ||
			die "that passphrase does not open the vault that is already there"
		vault_pass_store "$pass"
		info "Remembered on this Mac."
		return 0
		;;
	--passphrase)
		need_gpg
		pass=$(vault_pass)
		[ -n "$pass" ] || die "no passphrase set yet -- bier vault --init"
		new=$(vault_ask_twice "New passphrase: ")
		vault_reseal "$pass" "$new"
		vault_pass_store "$new"
		info "Changed, and everything re-encrypted."
		info "Every other Mac will ask for the new one on its next sync."
		return 0
		;;
	group)
		shift
		cmd_group "$@"
		return 0
		;;
	add)
		need_gpg
		shift
		local scope=""
		case ${1:-} in
		--for)
			scope=${2:-}
			[ -n "$scope" ] || die "--for what? a group or a device name"
			shift 2
			;;
		esac
		[ $# -gt 0 ] || die "which file? bier vault add ~/.zshrc"
		for pass in "$@"; do vault_add "$pass" "$scope"; done
		return 0
		;;
	--unlink)
		# Every link becomes the file it points at. The vault and the
		# safe are left alone: the other Macs still need them, and this
		# is what uninstalling does before it tidies up.
		local rel target n=0
		[ -d "$VAULT" ] || return 0
		while IFS= read -r rel; do
			[ -n "$rel" ] || continue
			vault_is_meta "$rel" && continue
			target=$(vault_target "$rel")
			[ -L "$target" ] || continue
			rm -f "$target"
			cp "$VAULT/$rel" "$target"
			n=$((n + 1))
		done <<EOF
$([ ! -d "$VAULT" ] || find "$VAULT" -type f -print | sed -e "s#^$VAULT/##")
EOF
		info "$(count_word "$n") turned back into plain files."
		return 0
		;;
	seal)
		vault_seal
		return 0
		;;
	open | --restore)
		vault_open
		return 0
		;;
	drop)
		shift
		[ $# -gt 0 ] || die "which file? bier vault drop ~/.zshrc"
		for pass in "$@"; do vault_drop "$pass"; done
		return 0
		;;
	forget)
		shift
		[ $# -gt 0 ] || die "which file? bier vault forget ~/.zshrc"
		for pass in "$@"; do vault_forget "$pass"; done
		return 0
		;;
	esac

	n=$(vault_own_files | wc -l | tr -d ' ')
	info "Vault:  $VAULT"
	info "Safe:   $SAFE_DIR"
	info "  $(count_word "$n") in it"
	case $(vault_pass_state) in
	known) info "  the passphrase is remembered on this Mac" ;;
	locked) info "  the passphrase is in the keychain, but the keychain is locked" ;;
	*) info "  no passphrase yet -- bier vault --init" ;;
	esac
}

# Re-encrypts everything from one passphrase to another. Writes to a
# temporary place first: a passphrase change that dies halfway through
# would otherwise leave half the safe unreadable with either of them.
vault_reseal() {
	local old=$1 new=$2 f plain staging
	[ -d "$SAFE_DIR" ] || return 0
	ls "$SAFE_DIR"/*.gpg >/dev/null 2>&1 || return 0

	staging=$(mktemp -d "${TMPDIR:-/tmp}/bier-reseal.XXXXXX")
	for f in "$SAFE_DIR"/*.gpg; do
		plain=$(tmpfile)
		vault_decrypt "$f" "$old" "$plain" ||
			die "the remembered passphrase does not open $(basename "$f") -- nothing changed"
		vault_encrypt "$plain" "$new" "$staging/$(basename "$f")"
	done
	for f in "$staging"/*.gpg; do
		mv "$f" "$SAFE_DIR/$(basename "$f")"
	done
	rmdir "$staging" 2>/dev/null || true
}

# Takes a Mac out of the fleet: the one that broke, was lost, or was
# wiped before anybody thought of uninstalling. Run it on a Mac that is
# still there.
#
# Its own files under @<name>/ are reported but not deleted. Throwing
# somebody's files away as a side effect of tidying up the device list
# would be a surprise, and the encrypted copies cost nothing to keep.
cmd_retire() {
	need_repo
	local name=${1:-} own answer g
	if [ "$name" = "--self" ]; then
		# What install.sh --uninstall calls. Taking yourself out is
		# allowed; doing it by name from the same Mac is a slip.
		name=$HOST
	else
		[ -n "$name" ] || die "which Mac? bier retire mini"
		[ "$name" != "$HOST" ] ||
			die "that is this Mac. To take it out from here:
     $ROOT/install.sh --uninstall"
	fi
	[ -f "$BREW_DIR/$name" ] ||
		die "no Mac called $name has ever recorded anything"

	info "$name has $(count_word "$(entries "$BREW_DIR/$name" | wc -l | tr -d ' ')") of its own."
	for g in $(group_list); do
		# No "&&" here: when the Mac is in no group at all the compound
		# returns 1 and set -e takes the whole command down with it.
		if printf '%s\n' $(group_members "$g") | grep -qx "$name"; then
			info "  in group $g"
		fi
	done
	own=0
	[ ! -d "$SAFE_DIR/@$name" ] ||
		own=$(find "$SAFE_DIR/@$name" -name '*.gpg' | wc -l | tr -d ' ')
	[ "$own" = 0 ] ||
		info "  $(count_word "$own") in the vault only for it — those stay"

	printf 'Take %s out? [y/N] ' "$name"
	read -r answer || answer=""
	case $answer in
	j | J | y | Y) ;;
	*)
		info "Cancelled."
		return 0
		;;
	esac

	rm -f "$BREW_DIR/$name"
	if [ -f "$VAULT/.groups" ]; then
		local g rest
		for g in $(group_list); do
			rest=$(printf '%s\n' $(group_members "$g") | grep -vx "$name" | tr '\n' ' ')
			rest=${rest% }
			sed -i '' -E "/^[[:space:]]*$g[[:space:]]*=/d" "$VAULT/.groups"
			[ -z "$rest" ] || printf '%s = %s\n' "$g" "$rest" >>"$VAULT/.groups"
		done
		vault_seal
	fi
	publish "$HOST: $name taken out"
	info "$name is out. Its inventory is gone; the git history still has it."
}

# Releases can be verified against a key that is published somewhere
# other than the code. Fetching it once and remembering it is the whole
# trick: whoever takes over the code server has to have taken over that
# other host as well, and before the key was ever fetched.
#
# Nothing is remembered by default, and then nothing is checked. That is
# on purpose. Insisting on a key that a fresh clone has no way of having
# would strand every installation that never asked for this.
cmd_trust_keys() {
	local signers=$1 signers_url=$2 scope=$3 usage=$4 url=${5:-} tmp line key fp

	case $url in
	--forget)
		rm -f "$signers" "$signers_url"
		info "Forgotten. $scope are no longer verified."
		return 0
		;;
	"")
		if [ -s "$signers" ]; then
			info "$scope are verified against:"
			while IFS= read -r line; do
				[ -n "$line" ] || continue
				key=$(tmpfile)
				printf '%s\n' "$line" | cut -d' ' -f2- >"$key"
				info "  $(ssh-keygen -l -f "$key" 2>/dev/null || printf '%s' "$line")"
			done <"$signers"
			info ""
			info "Fetched from: $(cat "$signers_url" 2>/dev/null || echo '?')"
			info "Stop:         $usage --forget"
		else
			info "No key remembered, so $scope are not verified."
			info "  $usage <url>   fetch one and remember it"
		fi
		return 0
		;;
	esac

	tmp=$(tmpfile)
	curl -fsSL --max-time 20 "$url" >"$tmp" ||
		die "could not fetch $url"
	[ -s "$tmp" ] || die "$url is empty"

	# Every line has to be a key, or this is not the file we wanted —
	# a login page returns 200 just as happily as a key does.
	info "From $url:"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		key=$(tmpfile)
		printf '%s\n' "$line" | cut -d' ' -f2- >"$key"
		fp=$(ssh-keygen -l -f "$key" 2>/dev/null) ||
			die "$url does not hold signing keys — this line is not one:
     $line"
		info "  $fp"
	done <"$tmp"

	mkdir -p "$(dirname "$signers")"
	cp "$tmp" "$signers"
	printf '%s\n' "$url" >"$signers_url"
	info ""
	info "Remembered. Compare the fingerprint above with the one you were"
	info "given elsewhere — fetching it proves nothing on its own."
	info "From now on $scope are verified with it."
}

cmd_trust() {
	cmd_trust_keys "$SIGNERS_FILE" "$SIGNERS_URL_FILE" \
		"Bier releases" "bier trust" "$@"
}

cmd_peer_trust() {
	cmd_trust "$@"
}

# Checking a tag out means running its code straight afterwards, so the
# signature is looked at first — but only when a key was remembered.
check_signature() {
	local tag=$1

	if [ ! -s "$SIGNERS_FILE" ]; then
		info "Note: releases are not verified. See bier trust."
		return 0
	fi

	git -C "$ROOT" cat-file tag "$tag" 2>/dev/null |
		grep -q 'BEGIN \(SSH\|PGP\) SIGNATURE' ||
		die "$tag carries no signature, and this Mac verifies releases.
     Not upgrading. Give it up with: bier trust --forget"

	git -C "$ROOT" -c gpg.ssh.allowedSignersFile="$SIGNERS_FILE" \
		verify-tag "$tag" >/dev/null 2>&1 ||
		die "$tag is not signed with the key this Mac trusts — not upgrading.
     Somebody may have put a tag on the server who should not have."

	info "Signature on $tag verified."
}

# Lifts the program itself onto a newer version. Touches no Brewfile —
# that is what "bier sync" is for. Asks nothing.
cmd_upgrade() {
	local force=no
	case ${1:-} in
	--force | -f) force=yes ;;
	esac

	info "Checking the program …"
	local fresh=no
	if check_code; then fresh=yes; fi
	if [ "$fresh" = no ] && [ "$force" = no ]; then
		info "Rebuild anyway: bier upgrade --force"
		return 0
	fi

	[ -z "$UPGRADE_TAG" ] || check_signature "$UPGRADE_TAG"

	# Nothing newer, but --force was given: rebuild what is here instead
	# of moving anywhere. Without this a forced rebuild would try to pull
	# a branch that a released install is not even on.
	local move=yes
	if [ "$fresh" = no ]; then move=no; fi

	info ""
	# The checkout overwrites this very script while it is still running —
	# bash reads it in chunks and would stumble over the changed file.
	# So from here on a new process, whose commands live in memory
	# instead of being read back from a file.
	exec /bin/bash -c '
		set -eu
		root=$1 tag=$2 move=$3
		if [ "$move" = yes ]; then
			if [ -n "$tag" ]; then
				# Land on the release, not on whatever the branch has
				# drifted to since it was cut.
				git -C "$root" checkout --quiet --detach "$tag"
			else
				git -C "$root" pull --rebase --autostash --quiet
			fi
			printf "Now at: %s\n" "$(git -C "$root" log --oneline -1)"
		fi
		exec "$root/install.sh" --yes --no-inventory
	' bier "$ROOT" "$UPGRADE_TAG" "$move"
}

# Commits the Brewfiles and pushes them to the server.
cmd_push() {
	need_repo
	publish "${1:-$HOST: inventory updated}"
}

# The everyday command: record what changed here, then bring this Mac and
# its peers into line. Existing installations without peers retain the
# legacy private-server path until they add their first peer.
cmd_sync() {
	need_repo
	if [ "$INVENTORY_MODE" = automatic ]; then
		cmd_dump
	else
		info "Inventory is manual; keeping the Brewfiles as written."
	fi
	vault_seal
	if [ -x "$PEER_CLIENT" ] && [ -n "$(peer_list)" ]; then
		sync_peers "${1:-$HOST: inventory updated}"
	else
		sync_data "${1:-$HOST: inventory updated}"
	fi
	vault_open
}

# Until 0.12.0 "update" did both jobs under one word, and nobody could say
# which of the two they had just asked for. Both have their own word now,
# so the old one points at them instead of guessing.
cmd_update() {
	die "\"bier update\" did two jobs at once and was split in 0.12.0.

     Sync the Macs:        bier sync
     Upgrade the program:  bier upgrade"
}

# Machine-readable state for the menu bar app. Tab-separated lines:
#   STATE  ok|drift        glass full or empty
#   HOST   <name>
#   VERSION <number>      so BierMenu notices that it is old itself
#   NEWCODE <number>      a newer release waits on the code server
#   OFFLINE <which>       a server could not be reached: data, code, or both
#   REPO   <path>         for the info menu
#   COMMIT <short> <date> for the info menu
#   NEW    brew "htop"     installed here, not recorded yet
#   STALE  brew "ghidra"   removed elsewhere, still installed here
#   GONE   brew "wget"     recorded but not installed here
#   GIT    <ahead> <behind> <dirty>
#
# What other devices have more or less of is deliberately absent: it says
# nothing about whether there is anything to do on *this* Mac, and in the
# menu bar it would be noise past a couple of devices. That is what
# "bier list" is for.
cmd_state() {
	need_brew
	need_repo

	local offline=""
	if [ "${1:-}" = "--fetch" ]; then
		# Two things a fetch must not do when the server is away: hang,
		# and pass unnoticed. Without the timeout the menu bar waits on
		# it; without noticing, the glass looks full while nothing has
		# been heard for days.
		local ssh_quick="ssh -o ConnectTimeout=5 -o BatchMode=yes"
		GIT_SSH_COMMAND=$ssh_quick \
			git -C "$DATA" fetch --quiet 2>/dev/null || offline="$offline data"
		# The program as well, so the menu bar can say that a release is
		# out instead of waiting for someone to type "bier upgrade".
		GIT_SSH_COMMAND=$ssh_quick \
			git -C "$ROOT" fetch --tags --quiet 2>/dev/null || offline="$offline code"
	fi

	local tmp
	tmp=$(tmpfile)
	brew bundle dump --force --file "$tmp" >/dev/null 2>&1

	local add fresh stale gone
	add=$(comm -23 <(entries "$tmp") <(own_entries) || true)
	gone=$(comm -13 <(entries "$tmp") <(own_entries) || true)
	fresh=$(classify_add "$add" | sed -n 's/^NEW'$'\t''//p')
	stale=$(classify_add "$add" | sed -n 's/^STALE'$'\t''//p')

	local counts ahead behind dirty
	counts=$(git -C "$DATA" rev-list --left-right --count HEAD...@{u} 2>/dev/null || echo "0	0")
	ahead=$(printf '%s' "$counts" | awk '{print $1}')
	behind=$(printf '%s' "$counts" | awk '{print $2}')
	# The Brewfiles and the safe: editing the README is no reason to
	# empty the glass, but an unsynced vault file is.
	if [ -n "$(git -C "$DATA" status --porcelain -- Brewfiles Safe)" ]; then
		dirty=1
	else
		dirty=0
	fi

	if [ -z "$add" ] && [ -z "$gone" ] &&
		[ "$ahead" = "0" ] && [ "$behind" = "0" ] && [ "$dirty" = "0" ]; then
		printf 'STATE\tok\n'
	else
		printf 'STATE\tdrift\n'
	fi
	printf 'HOST\t%s\n' "$HOST"
	printf 'VERSION\t%s\n' "$BIER_VERSION"
	local release
	release=$(latest_release)
	if [ -n "$release" ] && newer_version "$BIER_VERSION" "$release"; then
		printf 'NEWCODE\t%s\n' "$release"
	fi
	printf 'REPO\t%s\n' "$ROOT"
	printf 'COMMIT\t%s\t%s\n' \
		"$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')" \
		"$(git -C "$ROOT" log -1 --format=%cs 2>/dev/null || echo '?')"
	if [ -n "$fresh" ]; then printf '%s\n' "$fresh" | sed 's/^/NEW'$'\t''/'; fi
	if [ -n "$stale" ]; then printf '%s\n' "$stale" | sed 's/^/STALE'$'\t''/'; fi
	if [ -n "$gone" ]; then printf '%s\n' "$gone" | sed 's/^/GONE'$'\t''/'; fi
	printf 'GIT\t%s\t%s\t%s\n' "$ahead" "$behind" "$dirty"
	[ -z "$offline" ] || printf 'OFFLINE\t%s\n' "${offline# }"
}

# Version, origin and the paths in effect — the first question in any bug
# report.
cmd_version() {
	info "bier $BIER_VERSION"
	if [ -d "$ROOT/.git" ]; then
		local commit date
		commit=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo "?")
		date=$(git -C "$ROOT" log -1 --format=%cs 2>/dev/null || echo "?")
		info "  Commit  $commit of $date"
	fi
	info "  Code    $ROOT"
	if [ -n "$DATA" ]; then
		info "  Data    $DATA"
	else
		info "  Data    not set up yet"
	fi
	info "  Device  $HOST"

	local app
	for app in /Applications/BierMenu.app "$HOME/Applications/BierMenu.app"; do
		if [ -d "$app" ]; then
			info "  App     $(defaults read "$app/Contents/Info" \
				CFBundleShortVersionString 2>/dev/null || echo "?") ($app)"
		fi
	done
}

# Shows which values are actually in effect, config and environment
# combined.
cmd_config() {
	if [ $# -gt 0 ]; then
		[ $# -eq 2 ] && [ "$1" = inventory ] || die "usage: bier config [inventory <automatic|manual>]"
		case $2 in automatic | manual) ;; *) die "inventory must be 'automatic' or 'manual'" ;; esac
		config_set_value inventory "$2"
		INVENTORY_MODE=$2
		info "inventory = $2"
		return 0
	fi
	info "File:   $CONFIG_FILE"
	info "root  = $ROOT   (the program)"
	if [ -n "$DATA" ]; then
		info "data  = $DATA   (your Brewfiles)"
	else
		info "data  = not set up yet — $ROOT/install.sh"
	fi
	info "host  = $HOST"
	info "inventory = $INVENTORY_MODE"
	info ""
	if [ -z "$DATA" ]; then
		info "Without a data repository bier can neither record nor sync anything."
	elif [ -d "$BREW_DIR" ]; then
		info "Devices in Brewfiles/: $(host_list | tr '\n' ' ')"
	else
		info "Brewfiles/ is missing under $DATA"
	fi
}

