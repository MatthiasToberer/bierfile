#!/usr/bin/env bash
#
# Test run for bier.
#
#   test/run              every case
#   test/run take         only cases whose name contains "take"
#   test/run -v           show the output of each case
#
# Every case runs in a world of its own: its own git servers, two
# simulated Macs, a Homebrew stand-in. The real system and the real
# repository are never touched.

set -uo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
export REPO

VERBOSE=no
FILTER=""
for arg in "$@"; do
	case $arg in
	-v | --verbose) VERBOSE=yes ;;
	*) FILTER=$arg ;;
	esac
done

# The stand-ins have to come before the real Homebrew.
export PATH="$REPO/test/stubs:$PATH"

# bier must never pick up the real machine's config or repository path,
# should a case forget to set something.
unset BIER_ROOT BIER_HOST BIER_CONFIG 2>/dev/null || true

TOTAL=0
BAD=0
FAILED_NAMES=()

for case_file in "$REPO"/test/cases/*.sh; do
	name=$(basename "$case_file" .sh)
	if [ -n "$FILTER" ] && [[ $name != *"$FILTER"* ]]; then
		continue
	fi

	title=$(sed -n '2s/^# *//p' "$case_file")
	TOTAL=$((TOTAL + 1))

	WORK=$(mktemp -d -t biertest)
	# Both stdout and stderr of a case belong in the log, otherwise a
	# case fails silently.
	out=$(
		{
			export WORK
			# shellcheck source=/dev/null
			source "$REPO/test/lib/harness.sh"
			set -eE
			# If set -e aborts the case, it must be visible where.
			trap 'printf "    ABORTED AT: %s\n" "$BASH_COMMAND" >&2' ERR
			world
			# shellcheck source=/dev/null
			source "$case_file"
			exit $FAILED
		} 2>&1
	)
	rc=$?
	rm -rf "$WORK" ${GPGHOME:+"$GPGHOME"}

	if [ "$rc" = 0 ]; then
		printf '  ok    %s — %s\n' "$name" "$title"
		[ "$VERBOSE" = no ] || printf '%s\n' "$out" | sed 's/^/        /'
	else
		printf '  FAIL  %s — %s\n' "$name" "$title"
		printf '%s\n' "$out" | sed 's/^/        /'
		BAD=$((BAD + 1))
		FAILED_NAMES+=("$name")
	fi
done

echo
if [ "$BAD" = 0 ]; then
	printf '%s cases, all passed.\n' "$TOTAL"
	exit 0
fi
printf '%s of %s cases failed: %s\n' "$BAD" "$TOTAL" "${FAILED_NAMES[*]}"
exit 1
