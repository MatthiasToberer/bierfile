#!/usr/bin/env bash
# SSH stand-in for peer checks. It records the exact safe options so peer
# tests do not require a network connection or an interactive SSH prompt.

set -euo pipefail

printf '%s\n' "$*" >>"${WORK:?WORK is not set}/ssh.args"
case "${BIER_TEST_SSH:-ok}" in
fail)
	printf 'ssh: connection refused\n' >&2
	exit 255
	;;
bootstrap)
	if [[ "$*" == *'BatchMode=yes'* ]] && [ ! -f "${WORK:?WORK is not set}/ssh.bootstrapped" ]; then
		printf 'ssh: Permission denied (publickey,password).\n' >&2
		exit 255
	fi
	if [[ "$*" == *'BatchMode=no'* ]]; then
		: >"${WORK:?WORK is not set}/ssh.bootstrapped"
	fi
	;;
esac

# A tunnel (-N -L 127.0.0.1:<port>:…): listen on the local end, as ssh
# would, until bier is done with it.
if [[ " $* " == *" -N "* ]]; then
	for arg in "$@"; do
		case $arg in
		127.0.0.1:*:*) exec nc -l 127.0.0.1 "$(printf '%s' "$arg" | cut -d: -f2)" >/dev/null 2>&1 ;;
		esac
	done
fi

case "$*" in
*'uname -m'*) printf '%s\n' "${BIER_TEST_SSH_ARCH:-arm64}" ;;
*'printf "%s\n" "$HOME"'*) printf '%s\n' "${BIER_TEST_SSH_HOME:-/Users/bier}" ;;
*'bier-agent-data-directory'*) printf '%s\n' "${BIER_TEST_SSH_DATA:-${BIER_TEST_SSH_HOME:-/Users/bier}/.barrel/data}" ;;
*'hostname -s'*) printf '%s\n' "${BIER_TEST_SSH_AGENT:-mini}" ;;
esac
