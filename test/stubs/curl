#!/usr/bin/env bash
# Curl stand-in: local release fixtures remain files, and the post-install
# health endpoint has a deterministic response.

set -euo pipefail

url=${!#}
printf '%s\n' "$*" >>"${WORK:?WORK is not set}/curl.args"
case $url in
file://*) cat "${url#file://}" ;;
https://api.github.com/repos/MatthiasToberer/bierfile/releases/latest) printf '{"tag_name":"v0.35.0"}\n' ;;
http://*:53991/v1/health) printf '{"status":"ok","version":"test"}\n' ;;
http://*:53991/v1/peer/hello) printf '{"status":"peer-ok","agent":"test"}\n' ;;
http://*:53991/v1/peer/manifest)
	if [ -n "${BIER_TEST_PEER_HASH:-}" ]; then
		printf '{"version":1,"entries":[{"path":"Brewfiles/main","bytes":12,"sha256":"%s"}]}\n' "$BIER_TEST_PEER_HASH"
	else
		printf '{"version":1,"entries":[]}\n'
	fi
	;;
http://*:53991/v1/peer/data/read) printf 'brew "wget"\n' ;;
http://*:53991/v1/peer/snapshot/begin) printf '{"status":"snapshot-ready"}\n' ;;
http://*:53991/v1/peer/snapshot/put) printf '{"status":"snapshot-staged"}\n' ;;
http://*:53991/v1/peer/snapshot/commit) printf '{"status":"snapshot-committed"}\n' ;;
*) printf 'curl: unsupported test URL: %s\n' "$url" >&2; exit 22 ;;
esac
