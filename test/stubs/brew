#!/usr/bin/env bash
#
# Homebrew stand-in for the tests.
#
# The "system state" of a simulated Mac lives in the file
# $BIER_TEST_SYSTEM, in Brewfile format. Everything bier asks of brew is
# mapped onto it — that makes the tests deterministic and lets them stage
# states that would be tedious or destructive on a real Mac.
#
# Only what bier actually calls is modelled. Where real brew has a mind
# of its own, that is reproduced on purpose: brew untap refuses to work
# while a cask from the tap is still installed.

set -euo pipefail

SYS=${BIER_TEST_SYSTEM:?BIER_TEST_SYSTEM is not set}
[ -f "$SYS" ] || : >"$SYS"

# The names of one entry kind from the system state.
names_of() {
	sed -nE "s/^[[:space:]]*$1[[:space:]]+\"([^\"]+)\".*/\1/p" "$SYS"
}

# Remove the line matching kind and name. The name may be short
# ("sikarugir") or fully qualified ("tap/sikarugir") — real brew accepts
# both.
drop_entry() {
	local kind=$1 name=$2 tmp
	tmp=$(mktemp)
	grep -vE "^[[:space:]]*$kind[[:space:]]+\"([^\"]*/)?$name\"" "$SYS" >"$tmp" || true
	mv "$tmp" "$SYS"
}

cmd=${1:-}
shift || true

case $cmd in
bundle)
	sub=${1:-}
	shift || true
	file=""
	while [ $# -gt 0 ]; do
		case $1 in
		--file)
			shift
			file=${1:-}
			;;
		--file=*) file=${1#--file=} ;;
		esac
		shift || true
	done

	case $sub in
	dump)
		[ -n "$file" ] || exit 1
		cp "$SYS" "$file"
		;;
	install)
		# Everything in the file counts as installed afterwards.
		[ -f "$file" ] || exit 1
		grep -E '^[[:space:]]*(tap|brew|cask|mas|vscode)[[:space:]]+"' "$file" >>"$SYS" || true
		# Collapse duplicates, the order does not matter.
		tmp=$(mktemp)
		sort -u "$SYS" >"$tmp"
		mv "$tmp" "$SYS"
		echo "install: $(basename "$file")"
		;;
	*) exit 1 ;;
	esac
	;;

list)
	case "${1:-}" in
	--formula) names_of brew ;;
	--cask)
		# Real brew names casks short, even when they come from a tap.
		# That is exactly what kind_of tripped over once.
		names_of cask | sed -E 's|.*/||'
		;;
	*) names_of brew ;;
	esac
	;;

tap)
	if [ $# -eq 0 ]; then
		names_of tap
	else
		printf 'tap "%s"\n' "$1" >>"$SYS"
	fi
	;;

untap)
	name=${1:?}
	if grep -qE "^[[:space:]]*cask[[:space:]]+\"$name/" "$SYS"; then
		echo "Error: Refusing to untap $name because it contains the following installed casks:" >&2
		exit 1
	fi
	drop_entry tap "$name"
	echo "Untapped $name"
	;;

uninstall)
	kind=brew
	if [ "${1:-}" = "--cask" ]; then
		kind=cask
		shift
	fi
	name=${1:?}
	if ! grep -qE "^[[:space:]]*$kind[[:space:]]+\"([^\"]*/)?$name\"" "$SYS"; then
		echo "Error: No such keg: $name" >&2
		exit 1
	fi
	drop_entry "$kind" "$name"
	echo "Uninstalling $name"
	;;

install)
	# What can be installed: $WORK/brew-casks ("token App.app" per line)
	# and $WORK/brew-formulas (one name per line).
	kind=brew
	if [ "${1:-}" = "--cask" ]; then
		kind=cask
		shift
	fi
	name=${1:?}
	if [ "$kind" = cask ]; then
		grep -q "^$name " "${WORK:?}/brew-casks" 2>/dev/null || { echo "Error: no cask $name" >&2; exit 1; }
	else
		grep -qx "$name" "${WORK:?}/brew-formulas" 2>/dev/null || { echo "Error: no formula $name" >&2; exit 1; }
	fi
	printf '%s "%s"\n' "$kind" "$name" >>"$SYS"
	echo "installed $name"
	;;

info)
	kind=""
	json=no
	while [ $# -gt 1 ]; do
		case $1 in
		--cask) kind=cask ;;
		--formula) kind=brew ;;
		--json=*) json=yes ;;
		esac
		shift
	done
	name=${1:?}
	if [ "$kind" != brew ] && line=$(grep "^$name " "${WORK:?}/brew-casks" 2>/dev/null); then
		if [ "$json" = yes ]; then
			# $WORK/brew-zap: "token path" per line, the cask's zap list.
			zap=$(awk -v t="$name" '$1 == t { sub(/^[^ ]+ /, ""); printf "%s\"%s\"", (n++ ? "," : ""), $0 }' "$WORK/brew-zap" 2>/dev/null || true)
			printf '{"casks":[{"token":"%s","artifacts":[{"app":["%s"]},{"zap":[{"trash":[%s]}]}]}]}\n' "$name" "${line#* }" "$zap"
		else
			echo "==> $name"
		fi
		exit 0
	fi
	if [ "$kind" != cask ] && grep -qx "$name" "${WORK:?}/brew-formulas" 2>/dev/null; then
		echo "==> $name"
		exit 0
	fi
	exit 1
	;;

--version) echo "Homebrew 7.0.0-fake" ;;
*) exit 0 ;;
esac
