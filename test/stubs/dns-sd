#!/usr/bin/env bash
# Bonjour stand-in for peer discovery. The real dns-sd commands normally
# keep running; this fixture emits one deterministic browse/lookup snapshot.

set -euo pipefail

printf '%s\n' "$*" >>"${WORK:?WORK is not set}/dns-sd.args"
case ${1:-} in
-B)
	case ${2:-} in
	_bier-agent._tcp) printf '0 Add 2 4 local. _bier-agent._tcp. Bier on macbook\n' ;;
	_ssh._tcp) printf '0 Add 2 4 local. _ssh._tcp. SSH on macbook\n' ;;
	esac
	;;
-L)
	case ${3:-} in
	_bier-agent._tcp) printf 'Bier on macbook._bier-agent._tcp.local. can be reached at macbook.local.:53991\n' ;;
	_ssh._tcp) printf 'SSH on macbook._ssh._tcp.local. can be reached at macbook.local.:22\n' ;;
	esac
	;;
*) exit 1 ;;
esac
