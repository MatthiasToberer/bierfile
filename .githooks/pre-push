#!/bin/sh
#
# Runs before every push.
#
# Brewfile changes pass unchecked — that is the everyday case and has
# nothing to do with the code. If code is pushed, on the other hand, the
# tests have to be green: the other Mac picks this state up on its next
# "bier update" and builds it.
#
# Bypass in an emergency: git push --no-verify

set -eu

ROOT=$(git rev-parse --show-toplevel)
changed=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
	case $local_sha in
	0000000000000000000000000000000000000000) continue ;;
	esac
	case $remote_sha in
	0000000000000000000000000000000000000000)
		# A new branch on the server: check it to be safe.
		changed="$changed
all-new"
		;;
	*)
		changed="$changed
$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || echo all-new)"
		;;
	esac
done

code=$(printf '%s\n' "$changed" | grep -v '^$' | grep -v '^Brewfiles/' || true)
if [ -z "$code" ]; then
	exit 0
fi

printf 'pre-push: code changed, running tests …\n'
if out=$("$ROOT/test/run" 2>&1); then
	printf 'pre-push: %s\n' "$(printf '%s' "$out" | tail -1)"
	exit 0
fi

printf '%s\n' "$out"
printf '\npre-push: push aborted, the tests are red.\n'
printf 'Push anyway: git push --no-verify\n'
exit 1
