#!/bin/sh
#
# Läuft vor jedem Push.
#
# Brewfile-Änderungen gehen ungeprüft durch — das ist der Alltagsfall
# und hat mit dem Code nichts zu tun. Wird dagegen Code gepusht, müssen
# die Tests grün sein: der andere Mac holt sich diesen Stand beim
# nächsten "bier update" und baut ihn.
#
# Umgehen im Notfall: git push --no-verify

set -eu

ROOT=$(git rev-parse --show-toplevel)
changed=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
	case $local_sha in
	0000000000000000000000000000000000000000) continue ;;
	esac
	case $remote_sha in
	0000000000000000000000000000000000000000)
		# Neuer Branch auf dem Server: sicherheitshalber prüfen.
		changed="$changed
alles-neu"
		;;
	*)
		changed="$changed
$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || echo alles-neu)"
		;;
	esac
done

code=$(printf '%s\n' "$changed" | grep -v '^$' | grep -v '^Brewfiles/' || true)
if [ -z "$code" ]; then
	exit 0
fi

printf 'pre-push: Code geändert, Tests laufen …\n'
if out=$("$ROOT/test/run" 2>&1); then
	printf 'pre-push: %s\n' "$(printf '%s' "$out" | tail -1)"
	exit 0
fi

printf '%s\n' "$out"
printf '\npre-push: Push abgebrochen, die Tests sind rot.\n'
printf 'Trotzdem pushen: git push --no-verify\n'
exit 1
